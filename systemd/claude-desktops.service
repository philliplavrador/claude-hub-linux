[Unit]
Description=The desktop service: every Claude desktop's upkeep, the hub's rows, and the zone engine's question
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.claudehub.Desktops
ExecStart=%h/.local/bin/claude-desks watch
Restart=on-failure
RestartSec=2
MemorySwapMax=0
Slice=background.slice

[Install]
WantedBy=graphical-session.target
