def helper(name: str) -> str:
    override = os.environ.get(HELPERS.get(name, ""), "").strip()
    if override:
        return override
    path = Path(__file__).resolve().parent / name
    return str(path) if path.is_file() else name


def _load_titles():
    path = Path(__file__).resolve().parent / "claude-title"
    try:
        loader = importlib.machinery.SourceFileLoader("claude_title", str(path))
        spec = importlib.util.spec_from_loader("claude_title", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception as err:                        # noqa: BLE001
        print(f"claude-desks: no written names ({path.name} did not load: {err})", file=sys.stderr, flush=True)
        return None


TITLES = _load_titles()


class Refused(Exception):
    code = 1


class MisnamedDesktop(Refused):
    ...


class Usage(Refused):
    code = 2


class ScreenRefused(Refused):
    code = 2


class TilerSilent(ScreenRefused):
    code = 3


class NotForClaudes(Refused):
    code = 7



PID_LIMIT = 2 ** 31 - 1


def pid_alive(pid) -> bool:
    try:
        pid = int(pid or 0)
    except (TypeError, ValueError, OverflowError):
        return False
    if not 0 < pid <= PID_LIMIT:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def cmdline(pid) -> bytes:
    try:
        return Path(f"/proc/{int(pid)}/cmdline").read_bytes()
    except Exception:
        return b""


def comm(pid) -> str:
    try:
        return Path(f"/proc/{int(pid)}/comm").read_text().strip()
    except Exception:
        return ""


def parent_of(pid: int) -> int:
    try:
        return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    except Exception:
        return 0


def ancestors(pid: int, limit: int = 40):
    seen = 0
    while pid > 1 and seen < limit:
        yield pid
        pid = parent_of(pid)
        seen += 1


def konsole_above(pid: int) -> int:
    for p in ancestors(int(pid or 0)):
        if comm(p) == "konsole":
            return p
    return 0


def is_konsole(pid) -> bool:
    return comm(pid) == "konsole" or cmdline(pid).split(b"\0")[0].rsplit(b"/", 1)[-1] == b"konsole"


def on_a_terminal(pid) -> bool:
    try:
        return os.readlink(f"/proc/{int(pid)}/fd/0").startswith("/dev/pts/")
    except Exception:
        return False


def wait_pid_gone(pid, seconds: float) -> bool:
    end = time.monotonic() + max(0.0, seconds)
    while pid_alive(pid):
        if time.monotonic() >= end:
            return False
        time.sleep(0.05)
    return True


def is_claude(pid) -> bool:
    for word in cmdline(pid).split(b"\0"):
        parts = [p for p in word.split(b"/") if p]
        if parts and (parts[-1] == b"claude" or b"claude" in parts[:-1]):
            return True
    return False


def children_of(pid: int) -> list[int]:
    out = []
    for p in Path("/proc").glob("[0-9]*"):
        try:
            if parent_of(int(p.name)) == pid:
                out.append(int(p.name))
        except Exception:
            continue
    return out


def wrapper_in(konsole_pid) -> bool:
    kp = int(konsole_pid or 0)
    return kp > 0 and pid_alive(kp) and any(b"claude-window" in cmdline(c) for c in children_of(kp))


def recent(stamp, seconds: float) -> bool:
    return -seconds < time.time() - float(stamp or 0) < seconds


def starting_again(e: dict) -> bool:
    if not recent(e.get("resumed"), STARTING_FOR):
        return False
    by = int(e.get("resumed_by") or 0)
    if by and pid_alive(by) and b"claude-desks" in cmdline(by):
        return True
    return wrapper_in(e.get("konsole_pid"))



_PROC_BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
_PROC_STAT = Path("/proc/stat")
_proc = {}


def current_boot() -> str:
    named = (os.environ.get("CLAUDE_HUB_BOOT_ID") or "").strip()
    if named:
        return named
    if "boot_id" not in _proc:
        try:
            _proc["boot_id"] = _PROC_BOOT_ID.read_text().strip()
        except OSError:
            _proc["boot_id"] = ""
    return _proc["boot_id"]


def boot_epoch() -> float:
    named = (os.environ.get("CLAUDE_HUB_BOOT_EPOCH") or "").strip()
    if named:
        try:
            return float(named)
        except ValueError:
            pass
    if "btime" not in _proc:
        _proc["btime"] = 0.0
        try:
            for line in _PROC_STAT.read_text().splitlines():
                if line.startswith("btime "):
                    _proc["btime"] = float(line.split()[1])
                    break
        except (OSError, ValueError, IndexError):
            pass
    return _proc["btime"]



def accounts() -> list[str]:
    names = []
    if ACCTS.is_dir():
        for d in ACCTS.iterdir():
            if d.is_dir() and any((d / f).exists() for f in (".credentials.json", ".claude.json", "settings.json")):
                names.append(d.name)
    rank = {n: i for i, n in enumerate(ACCOUNT_ORDER)}
    return sorted(names, key=lambda n: (rank.get(n, 99), n))


PAUSE_FILE = ".claude-paused"


def paused(name: str) -> bool:
    try:
        return (ACCTS / name / PAUSE_FILE).exists()
    except OSError:
        return False



def trust_keys(account: str) -> set[str] | None:
    try:
        text = (ACCTS / account / ".claude.json").read_text()
    except FileNotFoundError:
        return set()
    except Exception:
        return None
    try:
        data = json.loads(text)
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    projects = data.get("projects")
    if not isinstance(projects, dict):
        return set()
    return {k for k, v in projects.items()
            if isinstance(k, str) and isinstance(v, dict) and v.get("hasTrustDialogAccepted") is True}


def _small_text(path: str, limit: int = 4096) -> str | None:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.read(fd, limit).decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        os.close(fd)


def _git_top(folder: str) -> str | None:
    d = folder
    while True:
        if os.path.lexists(os.path.join(d, ".git")):
            return d
        up = os.path.dirname(d)
        if up == d:
            return None
        d = up


def _main_root(top: str) -> str:
    git = os.path.join(top, ".git")
    if os.path.isdir(git):
        return top
    text = _small_text(git)
    first = text.split("\n", 1)[0].rstrip("\r") if text else ""
    if not first.startswith("gitdir:"):
        return top
    gitdir = first[len("gitdir:"):].strip()
    if not gitdir:
        return top
    gitdir = os.path.normpath(os.path.join(top, gitdir))
    common = (_small_text(os.path.join(gitdir, "commondir")) or "").split("\n", 1)[0].strip()
    back = (_small_text(os.path.join(gitdir, "gitdir")) or "").split("\n", 1)[0].strip()
    if not common or not back:
        return top
    common = os.path.normpath(os.path.join(gitdir, common))
    back = os.path.normpath(os.path.join(gitdir, back))
    try:
        if (os.path.basename(common) == ".git"
                and os.path.realpath(os.path.dirname(gitdir)) == os.path.realpath(os.path.join(common, "worktrees"))
                and os.path.basename(back) == ".git"
                and os.path.realpath(os.path.dirname(back)) == os.path.realpath(top)):
            return os.path.dirname(common)
    except (OSError, ValueError):
        pass
    return top


def trusted_in(keys, folder: str) -> bool:
    if not keys or not isinstance(folder, str) or not folder:
        return False
    try:
        real = os.path.realpath(folder)
    except (OSError, ValueError):
        return False
    top = _git_top(real)
    if top is not None and _main_root(top) in keys:
        return True
    d = real
    while True:
        if d in keys:
            return True
        up = os.path.dirname(d)
        if d == top or up == d:
            break
        d = up
    return False


def trusts(account: str, folder: str) -> bool | None:
    keys = trust_keys(account)
    return None if keys is None else trusted_in(keys, folder)


def claude_env(account: str) -> dict:
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith("CLAUDE") or k.startswith("KONSOLE_DBUS") or k.startswith("ANTHROPIC_")
                   or k in UNIT_ONLY_NAMES)}
    env["CLAUDE_CONFIG_DIR"] = str(ACCTS / account)
    return env


def agents(account: str) -> list[dict] | None:
    try:
        res = subprocess.run(["claude", "agents", "--json"], env=claude_env(account), capture_output=True,
                             text=True, timeout=15, umask=DESK_UMASK)
        rows = json.loads(res.stdout) if res.returncode == 0 else None
        return rows if isinstance(rows, list) else None
    except Exception:
        return None


def window_records() -> dict[str, dict]:
    out = {}
    if RECORDS.is_dir():
        for p in RECORDS.glob("*.json"):
            try:
                rec = json.loads(p.read_text())
                mtime = p.stat().st_mtime
            except Exception:
                continue
            if not isinstance(rec, dict):
                continue
            if of_an_earlier_boot(rec, mtime):
                continue
            wp = rec.get("wrapper_pid")
            if pid_alive(wp) and b"claude-window" in cmdline(wp):
                rec["_path"] = str(p)
                out[rec.get("session_id") or p.stem] = rec
    return out


@contextmanager
def records_lock():
    try:
        wait = float(os.environ.get("CLAUDE_HUB_RECORD_LOCK_WAIT") or 5)
    except ValueError:
        wait = 5.0
    if not math.isfinite(wait) or wait < 0:
        wait = 5.0
    try:
        fd = os.open(RECORDS / ".records.lock", os.O_CREAT | os.O_RDWR, 0o644)
    except OSError:
        fd = None
    try:
        if fd is not None:
            end = time.monotonic() + wait
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if not time.monotonic() < end:
                        break
                    time.sleep(0.05)
        yield
    finally:
        if fd is not None:
            os.close(fd)


def forget_records(sid: str, entry: dict, named: set[Path] = frozenset()) -> None:
    account, short = entry.get("account") or "", entry.get("id") or ""
    with records_lock():
        for p in named:
            p.unlink(missing_ok=True)
        if not RECORDS.is_dir():
            return
        for p in RECORDS.glob("*.json"):
            try:
                rec = json.loads(p.read_text())
            except Exception:
                continue
            if not isinstance(rec, dict):
                continue
            lineage = rec.get("lineage") if isinstance(rec.get("lineage"), list) else []
            if ((sid and (rec.get("session_id") == sid or sid in lineage))
                    or (short and rec.get("id") == short and (rec.get("account") or "") == account)):
                p.unlink(missing_ok=True)


def written_name(session_id) -> str:
    try:
        return TITLES.title_of(session_id) if TITLES else ""
    except Exception:                               # noqa: BLE001 — a name never breaks a look
        return ""


def named_by_him(session_id) -> bool:
    try:
        return bool(TITLES and written_name(session_id) and TITLES.read_state(session_id).get("by") == "him")
    except Exception:                               # noqa: BLE001 — a name never breaks a look
        return False


def normalize(account: str, listed: list[dict] | None, records: dict[str, dict]) -> list[dict]:
    rows = []
    for r in listed or []:
        if not isinstance(r, dict):
            continue
        kind, sid = r.get("kind"), r.get("sessionId") or ""
        common = {"account": account, "session_id": sid, "name": written_name(sid) or r.get("name") or "",
                  "status": r.get("status") or "", "state": r.get("state") or "", "cwd": r.get("cwd") or "",
                  "started": r.get("startedAt") or 0, "lineage": []}
        if kind == "background":
            if not r.get("id") or not r.get("status") or r.get("state") == "stopped":
                continue
            rec = records.get(sid) or {}
            rows.append({**common, "lineage": merged_lineage(sid, rec.get("lineage")),
                         "kind": "background", "id": r["id"], "pid": r.get("pid") or 0,
                         "konsole_pid": record_pid(rec) if rec else 0,
                         "wrapper_pid": int(rec.get("wrapper_pid") or 0) if rec else 0,
                         "windowed": bool(rec)})
        elif kind == "interactive" and r.get("pid") and pid_alive(r["pid"]) and on_a_terminal(r["pid"]):
            rows.append({**common, "kind": "plain", "id": "", "pid": int(r["pid"]),
                         "konsole_pid": konsole_above(int(r["pid"])), "wrapper_pid": 0, "windowed": False})
    return rows



def attention_flags() -> dict[str, dict]:
    out = {}
    if ATTENTION.is_dir():
        for p in ATTENTION.glob("*.json"):
            try:
                flag = json.loads(p.read_text())
                if not isinstance(flag, dict):
                    flag = {}
            except Exception:
                flag = {}
            out[p.stem] = flag
    return out


def hub_state() -> dict:
    try:
        st = json.loads(HUB_STATE.read_text())
        return st if isinstance(st, dict) else {}
    except Exception:
        return {}


def hub_alive(st: dict | None = None) -> bool:
    st = hub_state() if st is None else st
    pid = st.get("pid")
    return st.get("kind") == "popup" and pid_alive(pid) and b"claude-hub" in cmdline(pid)


def hub_visible() -> bool:
    st = hub_state()
    return hub_alive(st) and st.get("visible") is True


def hub_konsole_pid(st: dict | None = None) -> int:
    st = hub_state() if st is None else st
    kp = int(st.get("konsole_pid") or 0)
    return kp if hub_alive(st) and pid_alive(kp) else 0



UNIT_ONLY_NAMES = ("PYTHONPATH", "PYTHONNOUSERSITE", "PYTHONDONTWRITEBYTECODE", "INVOCATION_ID", "JOURNAL_STREAM")


PROXY_ONLY_NAMES = ("CLAUDE_CODE_SUBAGENT_MODEL", "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
                    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB")


def drop_foreign_routing(env: dict) -> dict:
    if env.get("ANTHROPIC_BASE_URL"):
        for name in PROXY_ONLY_NAMES:
            env.pop(name, None)
    for name in [k for k in env if k.startswith("ANTHROPIC_")]:
        del env[name]
    return env


def desktop_env() -> dict:
    env = dict(os.environ)
    for name in UNIT_ONLY_NAMES:
        env.pop(name, None)
    drop_foreign_routing(env)
    if env.get("WAYLAND_DISPLAY") or (env.get("DISPLAY", "").split(".")[0] not in ("", HIDDEN)) or not DESKTOP_LOOKUP:
        return env
    for proc in ("plasmashell", "kwin_wayland", "kwin_x11", "ksmserver"):
        try:
            pid = subprocess.run(["pgrep", "-x", proc], capture_output=True, text=True, timeout=5).stdout.split()
            if not pid:
                continue
            pairs = Path(f"/proc/{pid[0]}/environ").read_bytes().split(b"\0")
            other = dict(p.decode(errors="replace").split("=", 1) for p in pairs if b"=" in p)
            for k in ("WAYLAND_DISPLAY", "DISPLAY", "XDG_SESSION_TYPE", "DBUS_SESSION_BUS_ADDRESS", "XAUTHORITY"):
                if other.get(k):
                    env[k] = other[k]
                elif k in ("WAYLAND_DISPLAY", "DISPLAY"):
                    env.pop(k, None)
            return env
        except Exception:
            continue
    return env


def on_hidden_screen(env: dict) -> bool:
    return not env.get("WAYLAND_DISPLAY") and env.get("DISPLAY", "").split(".")[0] in ("", HIDDEN)


def safe_title(title: str) -> str:
    return title.replace(";", ",").replace("%", "％")



def qdbus(*args, literal: bool = False, timeout: float = 5.0) -> subprocess.CompletedProcess | None:
    args = [str(a) for a in args]
    if args and "kglobalaccel" in args[0]:
        raise Refused("claude-desks never talks to org.kde.kglobalaccel")
    try:
        return subprocess.run([QDBUS, *(["--literal"] if literal else []), *args],
                              capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


_DESKTOP_REC = re.compile(r'\[Argument: \([ui]ss\) (\d+), "([^"]*)", "')


def number_desktops(out: list[dict]) -> list[dict]:
    out.sort(key=lambda d: d["position"])
    for n, d in enumerate(out, start=1):
        d["number"] = n
    return out


def parse_desktops(text: str) -> list[dict]:
    found = list(_DESKTOP_REC.finditer(text or ""))
    out = []
    for i, m in enumerate(found):
        end = found[i + 1].start() if i + 1 < len(found) else len(text)
        chunk = text[m.end():end]
        cut = chunk.rfind('"]')
        out.append({"position": int(m.group(1)), "id": m.group(2), "name": chunk[:cut] if cut >= 0 else chunk})
    return number_desktops(out)


KWIN_LINK_REST = 10.0
KWIN_NO_REPLY = "org.freedesktop.DBus.Error.NoReply"
_kwin_link = SimpleNamespace(owner=None, conn=None, retry_at=0.0, failing=False, silent=False)


def new_kwin_connection():
    import dbus
    import dbus.bus
    import dbus.mainloop
    return dbus.bus.BusConnection(dbus.bus.BusConnection.TYPE_SESSION, mainloop=dbus.mainloop.NULL_MAIN_LOOP)


def use_kwin_link() -> None:
    _kwin_link.owner = threading.get_ident()


def kwin_link_here() -> bool:
    return (_kwin_link.owner == threading.get_ident()
            and threading.current_thread() is not threading.main_thread())


def drop_kwin_link() -> None:
    conn, _kwin_link.conn = _kwin_link.conn, None
    if conn is not None:
        try:
            conn.close()
        except Exception:                           # noqa: BLE001 (it is being thrown away)
            pass


def kwin_link_ready() -> bool:
    return kwin_link_here() and time.monotonic() >= _kwin_link.retry_at


def kwin_error_name(err: BaseException) -> str:
    try:
        return str(err.get_dbus_name() or "")       # type: ignore[attr-defined]
    except Exception:                               # noqa: BLE001 (not a D-Bus error)
        return ""


def kwin_link_failed(err: BaseException) -> None:
    drop_kwin_link()
    _kwin_link.retry_at = time.monotonic() + KWIN_LINK_REST
    if not _kwin_link.failing:
        _kwin_link.failing = True
        print(f"claude-desks watch: the KWin link failed ({kwin_error_name(err) or type(err).__name__}); "
              f"reading desktops through qdbus6 until it works again", file=sys.stderr, flush=True)


def kwin_read(prop: str, convert) -> tuple[bool, object]:
    if not kwin_link_ready():
        return False, None
    called = False
    try:
        if _kwin_link.conn is None:
            _kwin_link.conn = new_kwin_connection()
        called = True
        value = _kwin_link.conn.call_blocking(*VDM, "org.freedesktop.DBus.Properties", "Get", "ss",
                                              (VDM_IF, prop), timeout=5.0)
        answer = convert(value)
    except Exception as err:                        # noqa: BLE001 (any failure: qdbus6 answers this read)
        kwin_link_failed(err)
        if called and kwin_error_name(err) == KWIN_NO_REPLY:
            _kwin_link.silent = True
            return True, None
        return False, None
    if _kwin_link.failing:
        _kwin_link.failing = False
        print("claude-desks watch: the KWin link works again", file=sys.stderr, flush=True)
    return True, answer


def desktops_from_link(value) -> list[dict]:
    return number_desktops([{"position": int(p), "id": str(i), "name": str(n)} for p, i, n in value])


def live_desktops() -> list[dict] | None:
    ok, ds = kwin_read("desktops", desktops_from_link)
    if ok:
        return ds or None
    res = qdbus(*VDM, f"{VDM_IF}.desktops", literal=True)
    if not res or res.returncode != 0:
        return None
    return parse_desktops(res.stdout) or None


def current_desktop() -> str | None:
    ok, cur = kwin_read("current", lambda value: str(value).strip())
    if ok:
        return cur or None
    res = qdbus(*VDM, f"{VDM_IF}.current")
    if not res or res.returncode != 0 or not res.stdout.strip():
        return None
    return res.stdout.strip().splitlines()[-1].strip()


def resolve_desktop(arg: str, desktops: list[dict]) -> dict:
    arg = str(arg or "").strip()
    if arg.isdigit():
        n = int(arg)
        for d in desktops:
            if d["number"] == n:
                return d
        raise Refused(f"there is no desktop {n} (KWin has {len(desktops)})")
    for d in desktops:
        if d["id"] == arg:
            return d
    hits = [d for d in desktops if len(arg) >= 6 and d["id"].startswith(arg)]
    if len(hits) == 1:
        return hits[0]
    raise Refused(f"no desktop has the id {arg!r}")


def is_first(desktop: dict, desktops: list[dict]) -> bool:
    return bool(desktops) and desktop["id"] == desktops[0]["id"]


MAIN_FILE = Path(os.environ.get("CLAUDE_HUB_MAIN_DESKTOPS_FILE") or STATE_HOME / "main-desktops.json")
MAIN_FILE_MAX_BYTES = 64 * 1024
MAIN_IDS_MAX = 256
MAIN_CLOSE_DIR = Path(os.environ.get("CLAUDE_HUB_MAIN_CLOSE_DIR") or STATE_HOME / "main-desktops")
MAIN_CLOSE_REPORT_WAIT = float(os.environ.get("CLAUDE_HUB_DESKTOP_MAIN_CLOSE_REPORT_WAIT") or 2.0)
CLOSE_RELEASE_WAIT = float(os.environ.get("CLAUDE_HUB_DESKTOP_MAIN_CLOSE_RELEASE_WAIT") or 10.0)
CLOSE_RELEASE_LIMIT = max(CLOSE_RELEASE_WAIT, float(os.environ.get("CLAUDE_HUB_DESKTOP_MAIN_CLOSE_RELEASE_LIMIT") or 15.0))
CLOSE_SETTLE = 3.0
CLOSE_POLL_FIRST, CLOSE_POLL_LAST = 1.0, 5.0
CLOSE_TICK = 0.25
CLOSE_LOCK_WAIT, CLOSE_LOCK_TICK = 1.0, 0.05
CLOSE_STOP_SLACK_NS = 50_000_000
CLOSE_FILES_KEEP = 86400.0


def main_state() -> dict:
    state = {"v": 1, "ids": [], "home": "", "closing": None, "changed": 0}
    try:
        with open(MAIN_FILE, "rb") as fh:
            blob = fh.read(MAIN_FILE_MAX_BYTES + 1)
        if len(blob) > MAIN_FILE_MAX_BYTES:
            return state
        raw = json.loads(blob.decode("utf-8"))
    except Exception:
        return state
    if not isinstance(raw, dict):
        return state
    ids = raw.get("ids")
    if isinstance(ids, list):
        seen: set[str] = set()
        for x in ids:
            if isinstance(x, str) and x and x not in seen:
                seen.add(x)
                state["ids"].append(x)
                if len(seen) >= MAIN_IDS_MAX:
                    break
    if isinstance(raw.get("home"), str):
        state["home"] = raw["home"]
    if isinstance(raw.get("closing"), str) and raw["closing"]:
        state["closing"] = raw["closing"]
    if state["closing"] and raw.get("released") == state["closing"]:
        state["released"] = state["closing"]
    changed = raw.get("changed")
    if isinstance(changed, (int, float)) and not isinstance(changed, bool):
        state["changed"] = changed
    return state


@contextmanager
def main_lock(wait: bool = True):
    MAIN_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(MAIN_FILE.with_name(MAIN_FILE.name + ".lock"), "a+") as fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def write_main_state(state: dict) -> dict:
    MAIN_FILE.parent.mkdir(parents=True, exist_ok=True)
    data = {"v": 1, "ids": list(state.get("ids") or []), "home": state.get("home") or "",
            "closing": state.get("closing") or None, "changed": time.time()}
    if data["closing"] and state.get("released") == data["closing"]:
        data["released"] = data["closing"]
    tmp = MAIN_FILE.with_name(f".{MAIN_FILE.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps(data, ensure_ascii=False) + "\n")
        os.replace(tmp, MAIN_FILE)
    except OSError:
        tmp.unlink(missing_ok=True)
        raise
    return data


def update_main_state(change) -> dict:
    with main_lock():
        state = main_state()
        changed = change(state)
        return write_main_state(state if changed is None else changed)


def his_ids(desktops: list[dict] | None) -> list[str]:
    if not desktops:
        return []
    listed = set(main_state()["ids"])
    first = desktops[0]["id"]
    return [d["id"] for d in desktops if d["id"] == first or d["id"] in listed]


def is_his(desktop: dict, desktops: list[dict] | None) -> bool:
    return desktop["id"] in his_ids(desktops)


def main_number(desktop: dict, desktops: list[dict] | None) -> int | None:
    ids = his_ids(desktops)
    return ids.index(desktop["id"]) + 1 if desktop["id"] in ids else None


def his_words(desktop: dict, desktops: list[dict]) -> str:
    return "desktop 1" if is_first(desktop, desktops) else f"desktop {desktop.get('number') or main_number(desktop, desktops)}"


def home_words(desktops: list[dict] | None, home: str) -> str:
    for x in desktops or []:
        if x["id"] == home:
            if is_first(x, desktops):
                return "Main Desktop"
            return x.get("name") or f"Main Desktop {main_number(x, desktops) or ''}".strip()
    return "Main Desktop"


def home_id(desktops: list[dict] | None, state: dict | None = None) -> str:
    if not desktops:
        return ""
    state = main_state() if state is None else state
    home = state["home"]
    if home and home != state["closing"] and home in his_ids(desktops):
        return home
    return desktops[0]["id"]


def home_now(known: list[dict]) -> str:
    return home_id(live_desktops() or known)


def wire_mains(desktops: list[dict] | None, state: dict | None = None) -> list[str] | None:
    state = main_state() if state is None else state
    if not state["ids"] and not state["closing"]:
        return None
    if not desktops:
        return list(state["ids"])
    listed, first = set(state["ids"]), desktops[0]["id"]
    live = [d["id"] for d in desktops if d["id"] == first or d["id"] in listed]
    if len(live) < 2 and not state["closing"]:
        return None
    return live


CLAIMS_FRESH_SECONDS = 5.0


def claims_mains(desktops: list[dict] | None, state: dict | None = None) -> list[str] | None:
    state = main_state() if state is None else state
    wire = wire_mains(desktops, state)
    if wire is None and desktops and state["ids"]:
        changed = state.get("changed")
        if isinstance(changed, (int, float)) and 0 <= time.time() - changed < CLAIMS_FRESH_SECONDS:
            wire = [desktops[0]["id"]]
    if wire is None or not desktops:
        return wire
    return wire + [x for x in state["ids"] if x not in wire]


def keep_home(snap) -> bool:
    here, desktops = snap.current, snap.desktops
    if not here or not desktops:
        return False

    def wanted(state: dict) -> bool:
        return state["home"] != here and state["closing"] != here and here in his_ids(desktops)

    if len(his_ids(desktops)) < 2 or not wanted(main_state()):
        return False
    with main_lock(wait=False) as held:
        if not held:
            return False
        state = main_state()
        if not wanted(state):
            return False
        state["home"] = here
        write_main_state(state)
    return True


def drop_dead_closing() -> bool:
    def alive(did) -> bool:
        try:
            return close_running(did)
        except Refused:
            return False

    closing = main_state().get("closing")
    if not closing or alive(closing):
        return False
    with main_lock(wait=False) as held:
        if not held:
            return False
        state = main_state()
        closing = state.get("closing")
        if not closing or alive(closing):
            return False
        state["closing"] = None
        state.pop("released", None)
        write_main_state(state)
    return True


AGENT_ENV_NAMES =("CLAUDE_CODE_SESSION_ID", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT")
AGENT_PROGRAMS = ("claude", "codex")
SCRIPT_RUNNERS = ("node", "nodejs", "bun")
ANCESTOR_HOPS = 64


def agent_env_names(names) -> list[str]:
    return sorted(n for n in names if n in AGENT_ENV_NAMES or n.startswith("CODEX_"))


def read_proc(pid: int) -> dict | None:
    root = f"/proc/{pid}"
    try:
        with open(f"{root}/stat", "rb") as fh:
            stat = fh.read().decode("utf-8", "replace")
        ppid = int(stat[stat.rindex(")") + 1:].split()[1])
    except (OSError, ValueError, IndexError):
        return None
    info: dict = {"ppid": ppid, "env": None, "argv": [], "exe": "", "comm": ""}
    try:
        with open(f"{root}/environ", "rb") as fh:
            info["env"] = {e.split(b"=", 1)[0].decode("utf-8", "replace") for e in fh.read().split(b"\0") if e}
    except OSError:
        pass
    try:
        with open(f"{root}/cmdline", "rb") as fh:
            info["argv"] = [a.decode("utf-8", "replace") for a in fh.read().split(b"\0") if a]
    except OSError:
        pass
    try:
        info["exe"] = os.readlink(f"{root}/exe")
    except OSError:
        pass
    try:
        with open(f"{root}/comm", "rb") as fh:
            info["comm"] = fh.read().decode("utf-8", "replace").strip()
    except OSError:
        pass
    return info


def agent_program(info: dict) -> str:
    argv, exe = info.get("argv") or [], info.get("exe") or ""
    for name in (info.get("comm") or "", os.path.basename(exe), os.path.basename(argv[0]) if argv else ""):
        if name in AGENT_PROGRAMS:
            return name
    parts = Path(exe).parts
    if len(parts) >= 3 and parts[-3:-1] == ("claude", "versions"):
        return "claude"
    if argv and os.path.basename(argv[0]) in SCRIPT_RUNNERS:
        for arg in argv[1:4]:
            if arg.startswith("-"):
                continue
            where = Path(arg).parts
            if os.path.basename(arg) in AGENT_PROGRAMS or "claude-code" in where:
                return "codex" if os.path.basename(arg) == "codex" else "claude"
            if "codex" in where and "@openai" in where:
                return "codex"
    return ""


def agent_behind_this_process() -> str:
    own = agent_env_names(os.environ)
    if own:
        return f"{own[0]} is in its environment"
    seen: set[int] = set()
    info = read_proc(os.getpid())
    for _ in range(ANCESTOR_HOPS):
        pid = (info or {}).get("ppid") or 0
        if pid < 1 or pid in seen:
            return ""
        seen.add(pid)
        info = read_proc(pid)
        if not info:
            return ""
        named = agent_env_names(info.get("env") or ())
        if named:
            return f"its parent process {pid} has {named[0]} in its environment"
        program = agent_program(info)
        if program:
            return f"its parent process {pid} is {program}"
    return ""


def refuse_claude_caller(verb: str) -> None:
    why = agent_behind_this_process()
    if why:
        raise NotForClaudes(f"main-desktop {verb} is not for a Claude or a Codex: only he makes and closes his Main Desktops "
                            f"({why})")


PANEL_FILE = Path(os.environ.get("CLAUDE_HUB_PANEL_DESKTOP_FILE") or STATE_HOME / "panel" / "desktop.json")
PANEL_NAME = "the Panel"
PANEL_OLD_NAME = "Panel"
PANEL_CLASS = "panel-app"
PANEL_MARKER = "Panel"
PANEL_CLAIM_TTL = 30.0
PANEL_CLAIM_TRIES = 8
PANEL_CLAIM_PAUSE = 0.25
PANEL_REMAKE_EVERY = 10.0
PANEL_REMAKE_TRIES = 3
PANEL_MISSING_FOR = 1.0
PANEL_HOME_EVERY = 10.0

AUX_FILE = Path(os.environ.get("CLAUDE_HUB_AUX_DESKTOP_FILE") or STATE_HOME / "aux" / "desktop.json")
AUX_NAME = "Aux Desktop"
AUX_CLASS = "claude-aux-log"
AUX_MARKER = "Aux"

SPECIAL_DESKTOPS = {
    "panel": {"name": PANEL_NAME, "label": "Panel desktop", "aliases": (PANEL_OLD_NAME,), "class": PANEL_CLASS,
              "keep": True, "file_attr": "PANEL_FILE"},
    "aux": {"name": AUX_NAME, "label": "Aux Desktop", "aliases": (), "class": AUX_CLASS, "keep": False,
              "file_attr": "AUX_FILE"},
}


def special_file(kind: str) -> Path:
    return globals()[SPECIAL_DESKTOPS[kind]["file_attr"]]


def special_file_state(kind: str) -> dict | None:
    try:
        with special_file(kind).open() as fh:
            data = json.loads(fh.read(1 << 16))
    except Exception:                               # noqa: BLE001 — any damage reads as "no such desktop"
        return None
    if isinstance(data, dict) and isinstance(data.get("desktop_id"), str) and data["desktop_id"]:
        return data
    return None


def special_state(kind: str) -> dict | None:
    state = special_file_state(kind)
    if state and any(e["desktop_id"] == state["desktop_id"] for e in read_registry()):
        return None
    return state


def special_id(kind: str) -> str | None:
    state = special_state(kind)
    return state["desktop_id"] if state else None


def special_held_by_earlier(kind: str) -> set[str]:
    held: set[str] = set()
    for other in SPECIAL_DESKTOPS:
        if other == kind:
            break
        state = special_file_state(other)
        if state:
            held.add(state["desktop_id"])
    return held


def after_his(desktops: list[dict] | None) -> list[dict]:
    mine = set(his_ids(desktops))
    return [d for d in (desktops or []) if d["id"] not in mine]


def special_of(kind: str, desktops: list[dict] | None) -> dict | None:
    sid = special_id(kind)
    if not sid or sid in special_held_by_earlier(kind):
        return None
    return next((d for d in after_his(desktops) if d["id"] == sid), None)


def special_named(kind: str, desktops: list[dict] | None) -> dict | None:
    spec = SPECIAL_DESKTOPS[kind]
    owned = {e["desktop_id"] for e in read_registry()} | special_held_by_earlier(kind)
    free = [d for d in after_his(desktops) if d["id"] not in owned]
    return next((d for name in (spec["name"], *spec["aliases"]) for d in free if d["name"] == name), None)


def special_kind(desktop: dict, desktops: list[dict] | None = None) -> str | None:
    if desktops and is_his(desktop, desktops):
        return None
    for kind in SPECIAL_DESKTOPS:
        if special_id(kind) == desktop["id"]:
            return kind
    return None


def panel_file_state() -> dict | None:
    return special_file_state("panel")


def panel_file_id() -> str | None:
    state = panel_file_state()
    return state["desktop_id"] if state else None


def panel_state() -> dict | None:
    return special_state("panel")


def panel_id() -> str | None:
    state = panel_state()
    return state["desktop_id"] if state else None


def panel_at() -> int:
    state = panel_state()
    try:
        n = int(state.get("number") or 0) if state else 0
    except (TypeError, ValueError, OverflowError):
        return 0
    return n if n >= 2 else 0


def is_panel(desktop: dict, desktops: list[dict] | None = None) -> bool:
    fid = panel_id()
    if not fid or desktop["id"] != fid:
        return False
    return not (desktops and is_his(desktop, desktops))


def panel_of(desktops: list[dict] | None) -> dict | None:
    return special_of("panel", desktops)


_UNREAD = object()


def panel_position(desktops: list[dict] | None, panel=_UNREAD) -> int | None:
    if not desktops:
        return None
    d = panel_of(desktops) if panel is _UNREAD else panel
    return d["number"] if d else 0


def panel_named(desktops: list[dict] | None) -> dict | None:
    return special_named("panel", desktops)


def write_panel_state(desktop_id: str, number: int) -> None:
    old = panel_file_id()
    PANEL_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = PANEL_FILE.with_name(f".{PANEL_FILE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps({"v": 1, "desktop_id": desktop_id, "name": PANEL_NAME, "number": number},
                              indent=1) + "\n")
    os.replace(tmp, PANEL_FILE)
    _panel_remake["id"] = desktop_id
    if old and old != desktop_id:
        panel_home_wanted()


def panel_plan(desktops: list[dict], adopt: bool) -> tuple[dict | None, tuple[str, int] | None]:
    raw, state = panel_file_state(), panel_state()
    d = (panel_of(desktops) or panel_named(desktops)) if (state or adopt) else None
    if d:
        if not state or state["desktop_id"] != d["id"] or state.get("number") != d["number"] \
                or state.get("name") != PANEL_NAME or state.get("v") != 1:
            return d, (d["id"], d["number"])
        return d, None
    if raw and raw.get("number"):
        return None, (raw["desktop_id"], 0)
    return None, None


def panel_refresh(desktops: list[dict] | None, adopt: bool = False, held: bool = False) -> dict | None:
    if not desktops:
        return None
    d, want = panel_plan(desktops, adopt)
    if want is None:
        return d
    if held:
        write_panel_state(*want)
        return d
    with registry_lock(wait=False) as got:
        if not got:
            return d
        fresh = live_desktops()
        if not fresh:
            return d
        d, want = panel_plan(fresh, adopt)
        if want is not None:
            write_panel_state(*want)
        return d


_panel_remake: dict = {}


def panel_now() -> float:
    return time.monotonic()


def panel_signature() -> bytes | None:
    try:
        return PANEL_FILE.read_bytes()
    except OSError:
        return None


def panel_failed(memory: dict, what: str, why, count: int = 0) -> None:
    memory["fails"] = memory.get("fails", 0) + 1
    n = memory["fails"]
    print(f"claude-desks watch: {what} failed ({n} of {PANEL_REMAKE_TRIES}): {why}", file=sys.stderr, flush=True)
    if n >= PANEL_REMAKE_TRIES:
        memory["stopped"] = panel_signature() or b""
        memory["stopped_count"] = count
        print(f"claude-desks watch: the Panel desktop was not kept in {n} tries; not trying again until its state "
              "file changes, a desktop is removed, or the service restarts", file=sys.stderr, flush=True)


def panel_home_wanted() -> None:
    for key in ("home_at", "home_said"):
        _panel_remake.pop(key, None)
    _panel_remake["home"] = True


def panel_home(memory: dict, desktop_id: str) -> None:
    last = memory.get("home_at")
    if last is not None and panel_now() - last < PANEL_HOME_EVERY:
        return
    memory["home_at"] = panel_now()
    tag = f"panel-home-{os.getpid()}-{next(_script_seq)}"
    if not kwin_script(script_panel_home(desktop_id, tag), "panel-home"):
        if not memory.get("home_said"):
            memory["home_said"] = True
            print("claude-desks watch: KWin did not run the script that moves the Panel window onto its desktop",
                  file=sys.stderr, flush=True)
        return
    report = read_report(tag, SETTLE_REPORT_WAIT) or {}
    moved = report.get("moved") or []
    if moved:
        print(f"claude-desks watch: moved {len(moved)} Panel window{'s' if len(moved) > 1 else ''} onto it",
              file=sys.stderr, flush=True)
    if report.get("desktop") and not report.get("skipped"):
        for key in ("home", "home_at", "home_said"):
            memory.pop(key, None)


def panel_keep(desktops: list[dict] | None) -> bool:
    memory = _panel_remake
    if not desktops or panel_file_state() is None:
        memory.pop("missing", None)
        return False
    fid = panel_file_id()
    if memory.get("id") not in (None, fid):
        panel_home_wanted()
    memory["id"] = fid
    panel = panel_of(desktops)
    if panel is None:
        memory.setdefault("missing", panel_now())
    else:
        memory.pop("missing", None)
    if panel and panel["name"] == PANEL_NAME:
        memory["fails"] = 0
        memory.pop("stopped", None)
        memory.pop("stopped_count", None)
        if memory.get("home"):
            panel_home(memory, panel["id"])
        return False
    if memory.get("stopped") is not None:
        if memory["stopped"] == (panel_signature() or b"") and len(desktops) >= (memory.get("stopped_count") or 0):
            return False
        memory["fails"] = 0
        memory.pop("stopped")
        memory.pop("stopped_count", None)
    if panel is None and panel_now() - memory["missing"] < PANEL_MISSING_FOR:
        return False
    last = memory.get("at")
    if last is not None and panel_now() - last < PANEL_REMAKE_EVERY:
        return False
    with registry_lock(wait=False) as got:
        if not got:
            return False
        fresh = live_desktops()
        if not fresh or panel_file_state() is None:
            return False
        found, want = panel_plan(fresh, adopt=True)
        if found and found["name"] == PANEL_NAME:
            if want is not None:
                write_panel_state(*want)
            memory["fails"] = 0
            return False
        memory["at"] = panel_now()
        if found:
            old = found["name"]
            qdbus(*VDM, f"{VDM_IF}.setDesktopName", found["id"], PANEL_NAME)
            after = live_desktops()
            if after is None:
                return False
            if not any(d["id"] == found["id"] and d["name"] == PANEL_NAME for d in after):
                panel_failed(memory, f'renaming the Panel desktop from "{old}"', "KWin kept the name", len(after))
                return False
            memory["fails"] = 0
            if want is not None:
                write_panel_state(*want)
            print(f'claude-desks watch: renamed the Panel desktop from "{old}" to "{PANEL_NAME}"',
                  file=sys.stderr, flush=True)
            return True
        try:
            made = create_desktop(PANEL_NAME, len(his_ids(fresh)), only_named=True)
        except Exception as err:                    # noqa: BLE001 — Refused (a limit, KWin silent) or not: a failed try
            if isinstance(err, MisnamedDesktop):
                memory["fails"] = PANEL_REMAKE_TRIES - 1
            panel_failed(memory, "making the Panel desktop again", err, len(live_desktops() or fresh))
            return False
        write_panel_state(made["id"], made["number"])
        memory["fails"] = 0
    print(f"claude-desks watch: the Panel desktop was gone; made it again (desktop {made['number']})",
          file=sys.stderr, flush=True)
    panel_home(memory, made["id"])
    return True



def aux_file_state() -> dict | None:
    return special_file_state("aux")


def aux_file_id() -> str | None:
    state = aux_file_state()
    return state["desktop_id"] if state else None


def aux_state() -> dict | None:
    return special_state("aux")


def aux_id() -> str | None:
    state = aux_state()
    return state["desktop_id"] if state else None


def is_aux(desktop: dict, desktops: list[dict] | None = None) -> bool:
    pid = aux_id()
    if not pid or desktop["id"] != pid:
        return False
    return not (desktops and is_his(desktop, desktops))


def aux_of(desktops: list[dict] | None) -> dict | None:
    return special_of("aux", desktops)


def aux_position(desktops: list[dict] | None, aux=_UNREAD) -> int | None:
    if not desktops:
        return None
    d = aux_of(desktops) if aux is _UNREAD else aux
    return d["number"] if d else 0


def aux_named(desktops: list[dict] | None) -> dict | None:
    return special_named("aux", desktops)


def write_aux_state(desktop_id: str, number: int) -> None:
    AUX_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = AUX_FILE.with_name(f".{AUX_FILE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps({"v": 1, "desktop_id": desktop_id, "name": AUX_NAME, "number": number}, indent=1) + "\n")
    os.replace(tmp, AUX_FILE)



_script_seq = itertools.count()
KWIN_SCRIPT_LOCK = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "claude-kwin-scripts.lock"


@contextmanager
def kwin_script_turn(wait: float = 10.0):
    with open(KWIN_SCRIPT_LOCK, "a+") as fh:
        end = time.monotonic() + wait
        held = False
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
                break
            except OSError:
                if time.monotonic() >= end:
                    break
                time.sleep(0.02)
        try:
            yield
        finally:
            if held:
                fcntl.flock(fh, fcntl.LOCK_UN)


def kwin_script(body: str, purpose: str) -> bool:
    name = f"claude-desks-{purpose}-{os.getpid()}-{next(_script_seq)}"
    path = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / f"{name}.js"
    try:
        path.write_text(body)
    except OSError:
        return False
    with kwin_script_turn():
        return _load_run_unload(path, name)


SCRIPT_PAD_TRIES = 8


def script_numbers() -> set[str] | None:
    out = qdbus("org.kde.KWin", "/Scripting", "org.freedesktop.DBus.Introspectable.Introspect")
    if not out or out.returncode != 0:
        return None
    try:
        names = [node.get("name") or "" for node in ET.fromstring(out.stdout or "").findall("node")]
    except ET.ParseError:
        return None
    numbers = {m.group(1) for name in names if (m := re.fullmatch(r"Script(\d+)", name))}
    if names and not numbers:
        return None
    return numbers


def load_script(path: Path, name: str) -> str:
    for _ in range(SCRIPT_PAD_TRIES):
        taken = script_numbers()
        out = qdbus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", str(path), name)
        sid = (out.stdout.strip() if out and out.returncode == 0 else "")
        if not re.fullmatch(r"\d+", sid):
            return ""
        if taken is None or sid not in taken:
            return sid
        qdbus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name)
        if not load_script_pad():
            return ""
    return ""


def load_script_pad() -> bool:
    pad = STATE_HOME / "kwin-script-pad.js"
    try:
        pad.parent.mkdir(parents=True, exist_ok=True)
        pad.write_text("// Loaded, never run, never unloaded: it holds a KWin script number another script\n"
                       "// already answers on, so the next script gets a free one (claude-desks load_script).\n")
    except OSError:
        return False
    out = qdbus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", str(pad),
                f"claude-script-pad-{time.time_ns()}")
    return bool(out) and out.returncode == 0 and bool(re.fullmatch(r"\d+", out.stdout.strip()))


def _load_run_unload(path: Path, name: str) -> bool:
    try:
        sid = load_script(path, name)
        if not sid:
            return False
        ran = qdbus("org.kde.KWin", f"/Scripting/Script{sid}", "org.kde.kwin.Script.run")
        return bool(ran) and ran.returncode == 0
    finally:
        qdbus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name)
        try:
            path.unlink()
        except OSError:
            pass


JS_LIB = r"""
function lsDesktop(id) {
  var ds = workspace.desktops;
  for (var i = 0; i < ds.length; i++) if (ds[i].id === id) return ds[i];
  return null;
}
function lsIsHubCaption(c) {
  return String(c || '') === 'Claude hub — Konsole';     // exactly: a browser tab "Claude hub" is not it
}
function lsWindow(pid, cap, skip) {         // skip: pids a caption never takes (a Claude's Konsole); the pid match still may
  var ws = workspace.windowList(), i;
  if (pid > 0) for (i = 0; i < ws.length; i++) if (ws[i].normalWindow && ws[i].pid === pid) return ws[i];
  if (cap === 'Claude hub') {
    for (i = 0; i < ws.length; i++) if (ws[i].normalWindow && lsIsHubCaption(ws[i].caption)) return ws[i];
  } else if (cap) {
    for (i = 0; i < ws.length; i++) {
      if (ws[i].normalWindow && !(skip && skip.indexOf(ws[i].pid) >= 0) && String(ws[i].caption || '').indexOf(cap) >= 0) return ws[i];
    }
  }
  return null;
}
function lsOn(w, d) {
  if (w.onAllDesktops) return true;
  var ds = w.desktops;
  for (var i = 0; i < ds.length; i++) if (ds[i].id === d.id) return true;
  return false;
}
function lsIsHub(w, hubPid) {             // the popup: its record's Konsole, or its exact caption
  return (hubPid > 0 && w.pid === hubPid) || lsIsHubCaption(w.caption);
}
function lsOnlyOn(w, d) {
  if (w.onAllDesktops) return false;
  var ds = w.desktops;
  return ds.length === 1 && ds[0].id === d.id;
}
function lsInfo(w) {
  return {pid: w.pid, caption: String(w.caption || ''), cls: String(w.resourceClass || '')};
}
function lsReport(tag, what) {             // back to claude-desks through the desktop service
  callDBus('org.claudehub.Desktops', '/Desktops', 'org.claudehub.Desktops', 'Report', tag, JSON.stringify(what));
}
function lsSlot(w, slot, out, d) {
  // `out`: the screen the window is being brought to (lsToScreen). Its rectangle comes from that screen's
  // own placement area, not from the screen the window is still on until KWin has moved it.
  var a = out ? workspace.clientArea(KWin.PlacementArea, out, d || workspace.currentDesktop)
              : workspace.clientArea(KWin.PlacementArea, w);
  var hw = Math.floor(a.width / 2);
  // The Claude is an ordinary tiled window: alone on
  // its desktop it has the whole screen, and the zone engine re-splits as windows join it. Placing
  // it is still what puts it ON its desktop and unminimizes it — only the reserved quarter is gone,
  // and a full-area start is exactly what the engine gives a lone window, so nothing flashes.
  if (slot === 'claude') return {x: a.x, y: a.y, width: a.width, height: a.height};
  if (slot === 'center') {
    var g = w.frameGeometry, cw = Math.min(g.width, a.width), ch = Math.min(g.height, a.height);
    return {x: a.x + Math.floor((a.width - cw) / 2), y: a.y + Math.floor((a.height - ch) / 2), width: cw, height: ch};
  }
  return {x: a.x + hw, y: a.y, width: a.width - hw, height: a.height};
}
function lsTiled(w) {                       // the tiler has given it a tile and owns its geometry
  try { return !!w.tile; } catch (e) { return false; }
}
function lsSame(a, b) {
  return a.x === b.x && a.y === b.y && a.width === b.width && a.height === b.height;
}
// The screen the user is watching.
// `scr` = {good: [screens in front of him that switch desktops], target: the first of them}; absent when
// the screens are not known or every one is sticky, and then a placement is what it always was.
function lsOutput(name) {
  var ss = workspace.screens;
  for (var i = 0; i < ss.length; i++) if (ss[i].name === name) return ss[i];
  return null;
}
function lsPrimary(sticky) {                // KDE's primary screen: the first of the screen order that is not sticky (a sticky
  // screen keeps showing the user's own desktop (a Main Desktop), so a window on another desktop is not seen there), read now; null when KWin does
  // not list one (workspace.screenOrder missing in this session, empty, every entry sticky or without an output)
  try {
    var o = workspace.screenOrder, st = sticky || [];
    for (var i = 0; o && i < o.length; i++) {
      var n = o[i] ? String(o[i].name || '') : '';
      if (n && st.indexOf(n) < 0 && lsOutput(n)) return n;
    }
    return null;
  } catch (e) { return null; }
}
function lsToScreen(w, scr, d) {            // the screen to bring it to, or null when it is on one already (or none exists)
  if (!scr) return null;
  // `scr.primary` (place --screen primary): the one screen is KDE's primary, read here and now (never a connector
  // written down); while that cannot be read, the screens the user watches are the choice, as without the flag.
  var good = scr.good || [], p = scr.primary ? lsPrimary(scr.sticky) : null;
  if (p) good = [p];
  if (!good.length) return null;
  var o = w.output;
  if (o && good.indexOf(o.name) >= 0) return null;     // on one the user watches (Polonium may have just put it there): left
  // As Polonium's pickScreen does for a new window (as requested: fill every free monitor before doubling up):
  // of the screens the user watches, the one holding the fewest ordinary windows of this desktop, ties by screen order.
  var n = {}, ws = workspace.windowList(), i, best = null, fewest = 0;
  for (i = 0; i < ws.length; i++) {
    if (ws[i] === w || !ws[i].normalWindow || ws[i].minimized || !ws[i].output || !d || !lsOn(ws[i], d)) continue;
    n[ws[i].output.name] = (n[ws[i].output.name] || 0) + 1;
  }
  for (i = 0; i < good.length; i++) {
    var out = lsOutput(good[i]), c = n[good[i]] || 0;
    if (out && (best === null || c < fewest)) { best = out; fewest = c; }
  }
  return best;
}
var lsScreened = false;                     // set by lsPlace: it brought the window to another screen
function lsUnseen(w) {                      // on a desktop he is not looking at
  return !w.onAllDesktops && w.desktops.length > 0 && !lsOn(w, workspace.currentDesktop);
}
function lsJump(w, out) {
  // A window on a desktop he is not looking at may never answer the resize that sendClientToScreen asks for
  // (Firefox pauses an unseen window; KWin can keep one on its old screen through several passes),
  // and Polonium reads it on the old screen until KWin has moved it (zones.mjs bind). KWin applies a pure move
  // (same size) at once, so such a window is moved first, at its own size, centred on the screen
  // the rectangle follows whenever the client answers.
  var g = out.geometry, f = w.frameGeometry;
  if (!g || !f) return;
  try {
    if (w.tile) w.tile = null;
    w.frameGeometry = {x: Math.round(g.x + g.width / 2 - f.width / 2), y: Math.round(g.y + g.height / 2 - f.height / 2),
                       width: f.width, height: f.height};
  } catch (e) { /* best-effort: sendClientToScreen still runs */ }
}
function lsSend(w, out) {                   // the way a window-moving script does it: KWin and the tiler both hear it
  if (lsUnseen(w)) lsJump(w, out);
  try { workspace.sendClientToScreen(w, out); } catch (e) { /* the rectangle below still lands it there */ }
}
function lsPlace(w, d, slot, scr) {
  if (w.minimized) w.minimized = false;
  var moved = false, out = lsToScreen(w, scr, d), wasTiled = lsTiled(w);
  lsScreened = !!out;
  if (!w.onAllDesktops && d) {
    moved = !lsOnlyOn(w, d);
    if (moved) w.desktops = [d];          // setting the ones it has starts the tiler off for nothing
  }
  if (out) lsSend(w, out);
  // `claude` is "the ordinary tiled window of this desktop", which is the whole of it only while it
  // is alone there. Over a tile the engine has already split, writing
  // the whole desktop leaves the tile and the frame disagreeing, and Polonium never puts the two
  // back together — buildLayout writes geometry only when the tile OBJECT changed (a resumed window can be tiled at one size and framed at another). A rectangle asked for by
  // name — right, center — is still set: that is what asking for it means. A tiled window sent to
  // another screen is laid into that screen's layout by the tiler (it heard the move): not written over.
  if (!(slot === 'claude' && (lsTiled(w) || (out && wasTiled)))) w.frameGeometry = lsSlot(w, slot, out, d);
  return moved;
}
function lsFix(w, d, slot, scr, sent) {
  // The tiler has had its turn. A window it holds is its business; one it let go of keeps the
  // rectangle the placement asked for. True when this had to put it back. A window the tiler took
  // back to the screen it was brought from is brought again: sent, then given the rectangle.
  // A window this placement sent to another screen (`sent`) never has the whole-desktop slot written here:
  // sending a window drops its tile and the tiler lays it into the new screen's layout a moment later, and until
  // then it reads as one the tiler let go of (writing the whole screen over that leaves the tile and the frame disagreeing).
  // One it did not send keeps the restore it always had.
  if (!lsOn(w, d)) return false;
  var out = lsToScreen(w, scr, d);
  if (out) {
    lsSend(w, out);
    if (!lsTiled(w) && slot !== 'claude') w.frameGeometry = lsSlot(w, slot, out, d);
    return true;
  }
  if (lsTiled(w) || (sent && slot === 'claude')) return false;
  var want = lsSlot(w, slot);
  if (lsSame(w.frameGeometry, want)) return false;
  w.frameGeometry = want;
  return true;
}
"""


def js(value) -> str:
    return json.dumps(value)


def script_place(desktop_id: str, slot: str, pid: int = 0, caption: str = "", focus: bool = False,
                 tag: str = "", skip: tuple | list = (), screens: dict | None = None) -> str:
    skipped = ", " + js(sorted(skip)) if skip else ""
    scr = ", " + js(screens) if screens else ""
    return JS_LIB + (
        "var d = lsDesktop(%s), w = lsWindow(%d, %s%s), placed = false, moved = false;\n"
        "if (d && w) { moved = lsPlace(w, d, %s%s); placed = true;%s }\n"
        % (js(desktop_id), int(pid or 0), js(caption or ""), skipped, js(slot), scr,
           " if (lsOn(w, workspace.currentDesktop)) workspace.activeWindow = w;" if focus else "")
    ) + ("lsReport(%s, {placed: placed, moved: moved, desktop: !!d, screened: lsScreened, "
         "here: !!d && d.id === workspace.currentDesktop.id, window: w ? lsInfo(w) : null%s});\n"
         % (js(tag), (", primary: lsPrimary(%s)" % js(screens.get("sticky") or [])) if screens and screens.get("primary") else "")
         if tag else "")


def script_settle(items: list[tuple[int, str, str, str]], tag: str, skip: tuple | list = (),
                  screens: dict | None = None, sent: bool = False) -> str:
    skipped = ", " + js(sorted(skip)) if skip else ""
    scr = ", " + js(screens) + (", true" if sent else "") if screens else ""
    return JS_LIB + "var items = %s, out = [];\n" % js(
        [[int(p or 0), cap or "", did, slot] for p, cap, did, slot in items]) + (
        "for (var i = 0; i < items.length; i++) {\n"
        "  var w = lsWindow(items[i][0], items[i][1]%s), d = lsDesktop(items[i][2]);\n"
        "  if (w && d) out.push({pid: w.pid, fixed: lsFix(w, d, items[i][3]%s)});\n"
        "}\n"
        "lsReport(%s, {windows: out});\n" % (skipped, scr, js(tag)))


def script_goto(desktop_id: str, focus_pid: int = 0, focus_cls: str = "") -> str:
    pick = ""
    if focus_cls:
        by_name = " || String(ws[i].resourceName || '') === %s" % js(focus_cls) if focus_cls == AUX_CLASS else ""
        pick = ("  if (!w) { var ws = workspace.windowList(); for (var i = 0; i < ws.length; i++) {\n"
                "    if (ws[i].normalWindow && (String(ws[i].resourceClass || '') === %s%s"
                " || String(ws[i].desktopFileName || '') === %s)"
                " && lsOn(ws[i], d)) { w = ws[i]; break; } } }\n" % (js(focus_cls), by_name, js(focus_cls)))
    return JS_LIB + (
        "var d = lsDesktop(%s);\n"
        "if (d) {\n"
        "  if (workspace.currentDesktop.id !== d.id) workspace.currentDesktop = d;\n"
        "  var w = lsWindow(%d, '');\n"
        "%s"
        "  if (w && lsOn(w, d)) { if (w.minimized) w.minimized = false; workspace.activeWindow = w; }\n"
        "}\n" % (js(desktop_id), int(focus_pid or 0), pick))


def script_close_on(desktop_id: str, tag: str, hub_pid: int = 0) -> str:
    return JS_LIB + (
        "var d = lsDesktop(%s), hubPid = %d, closing = [], ask = [];\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++)\n"
        "    if (ws[i].normalWindow && lsOnlyOn(ws[i], d) && !lsIsHub(ws[i], hubPid)) {\n"
        "      closing.push(lsInfo(ws[i])); ask.push(ws[i]);\n"
        "    }\n"
        "  for (var j = 0; j < ask.length; j++) ask[j].closeWindow();\n"
        "}\n"
        "lsReport(%s, {closing: closing});\n" % (js(desktop_id), int(hub_pid or 0), js(tag)))


def script_move_leftovers(desktop_id: str, first_id: str, tag: str, hub_pid: int = 0) -> str:
    return JS_LIB + (
        "var d = lsDesktop(%s), first = lsDesktop(%s) || workspace.desktops[0], hubPid = %d, moved = [], go = [];\n"
        "if (d && first) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++) {\n"
        "    if (!lsOnlyOn(ws[i], d)) continue;\n"
        "    go.push(ws[i]);\n"
        "    if (lsIsHub(ws[i], hubPid)) continue;\n"
        "    var info = lsInfo(ws[i]);\n"
        "    info.normal = !!ws[i].normalWindow;\n"
        "    moved.push(info);\n"
        "  }\n"
        "  var act = workspace.activeWindow;\n"
        "  for (var j = 0; j < go.length; j++) go[j].desktops = [first];\n"
        "  if (workspace.currentDesktop.id === d.id) {\n"
        "    workspace.currentDesktop = first;\n"
        "    if (act && lsOnlyOn(act, first)) workspace.activeWindow = act;\n"
        "  }\n"
        "}\n"
        "lsReport(%s, {moved: moved});\n" % (js(desktop_id), js(first_id), int(hub_pid or 0), js(tag)))


JS_APP_OF = """
function lsIsApp(w, app) {                 // a window of that app: its app id, the instance name or the desktop file name it sets
  return String(w.resourceClass || '') === app || String(w.resourceName || '') === app ||
         String(w.desktopFileName || '') === app;
}
"""


def script_close_app(desktop_id: str, app: str, tag: str) -> str:
    return JS_LIB + JS_APP_OF + (
        "var d = lsDesktop(%s), app = %s, closing = [], ask = [];\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++)\n"
        "    if (ws[i].normalWindow && lsOnlyOn(ws[i], d) && lsIsApp(ws[i], app)) {\n"
        "      closing.push(lsInfo(ws[i])); ask.push(ws[i]);\n"
        "    }\n"
        "  for (var j = 0; j < ask.length; j++) ask[j].closeWindow();\n"
        "}\n"
        "lsReport(%s, {closing: closing});\n" % (js(desktop_id), js(app), js(tag)))


def script_left_on(desktop_id: str, tag: str, hub_pid: int = 0, app: str = "") -> str:
    return JS_LIB + (JS_APP_OF if app else "") + (
        "var d = lsDesktop(%s), hubPid = %d, left = [];\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++)\n"
        "    if (lsOnlyOn(ws[i], d) && !lsIsHub(ws[i], hubPid)%s) {\n"
        "      var info = lsInfo(ws[i]); info.normal = !!ws[i].normalWindow; left.push(info);\n"
        "    }\n"
        "}\n"
        "lsReport(%s, {left: left});\n"
        % (js(desktop_id), int(hub_pid or 0), (" && lsIsApp(ws[i], %s)" % js(app)) if app else "", js(tag)))


def wait_closed(desktop_id: str, tag: str, hub_pid: int, seconds: float, app: str = "") -> None:
    end = time.monotonic() + max(0.0, seconds)
    last, still_since, n = None, 0.0, 0
    while True:
        now = time.monotonic()
        if now >= end:
            return
        time.sleep(min(CLOSE_POLL, end - now))
        n += 1
        t = f"{tag}-wait{n}"
        report = read_report(t, min(1.0, max(0.0, end - time.monotonic()))) \
            if kwin_script(script_left_on(desktop_id, t, hub_pid, app), "end-wait") else None
        if report is None:
            time.sleep(max(0.0, end - time.monotonic()))
            return
        left = report.get("left") or []
        if not left:
            return
        key = sorted(json.dumps(w, sort_keys=True) for w in left)
        if key != last:
            last, still_since = key, time.monotonic()
        elif any(not w.get("normal") for w in left) and time.monotonic() - still_since >= STILL_FOR:
            return


def script_close_left_window(desktop_id: str, pid: int, hub_pid: int = 0) -> str:
    return JS_LIB + (
        "var d = lsDesktop(%s), w = lsWindow(%d, ''), hubPid = %d;\n"
        "if (d && w && lsOnlyOn(w, d) && !lsIsHub(w, hubPid)) w.closeWindow();\n"
        % (js(desktop_id), int(pid or 0), int(hub_pid or 0)))


JS_CLOSE_LIB = r"""
function mcQuestionOf(w, d, hubPid) {       // a dialog of a window that lives only on d, wherever the dialog itself opened
  var p = w.transient ? w.transientFor : null;
  return !!p && lsOnlyOn(p, d) && !lsIsHub(p, hubPid);
}
function mcRoot(w) {                        // the window a dialog is for: the root of its chain of transientFor
  var p = w, n = 0;
  while (p && p.transient && p.transientFor && n++ < 8) p = p.transientFor;
  return p || w;
}
"""


def script_close_main_poll(desktop_id: str, hub_pid: int, tag: str) -> str:
    return JS_LIB + JS_CLOSE_LIB + (
        "var d = lsDesktop(%s), hubPid = %d, list = [];\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++) {\n"
        "    if (!(lsOnlyOn(ws[i], d) || mcQuestionOf(ws[i], d, hubPid)) || lsIsHub(ws[i], hubPid)) continue;\n"
        "    var info = lsInfo(ws[i]);\n"
        "    info.id = String(ws[i].internalId);\n"
        "    info.normal = !!ws[i].normalWindow && !ws[i].transient;\n"
        "    info.minimized = !!ws[i].minimized;\n"
        "    var root = mcRoot(ws[i]);\n"
        "    if (String(root.internalId) !== info.id) info.owner = String(root.internalId);\n"
        "    list.push(info);\n"
        "  }\n"
        "}\n"
        "lsReport(%s, {present: !!d, current: workspace.currentDesktop.id, windows: list});\n"
        % (js(desktop_id), int(hub_pid or 0), js(tag)))


def script_close_main_ask(desktop_id: str, ids: list[str] | set[str], hub_pid: int = 0) -> str:
    return JS_LIB + (
        "var d = lsDesktop(%s), want = %s, hubPid = %d, ask = [];\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++)\n"
        "    if (ws[i].normalWindow && !ws[i].transient && lsOnlyOn(ws[i], d) && !lsIsHub(ws[i], hubPid) &&\n"
        "        want.indexOf(String(ws[i].internalId)) >= 0) ask.push(ws[i]);\n"
        "  for (var j = 0; j < ask.length; j++) ask[j].closeWindow();\n"
        "}\n" % (js(desktop_id), js(sorted(ids)), int(hub_pid or 0)))


def script_close_main_show(desktop_id: str, window_id: str) -> str:
    return JS_LIB + JS_CLOSE_LIB + (
        "var d = lsDesktop(%s), want = %s, w = null;\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++) if (String(ws[i].internalId) === want) w = ws[i];\n"
        "  if (w && !lsOnlyOn(w, d) && mcQuestionOf(w, d, 0)) w.desktops = [d];\n"
        "  if (w && lsOnlyOn(w, d)) {\n"
        "    if (workspace.currentDesktop.id !== d.id) workspace.currentDesktop = d;\n"
        "    if (w.minimized) w.minimized = false;\n"
        "    workspace.activeWindow = w;\n"
        "  }\n"
        "}\n" % (js(desktop_id), js(window_id)))


def script_close_main(desktop_id: str, target_id: str, hub_pid: int, tag: str) -> str:
    return JS_LIB + (
        "var d = lsDesktop(%s), t = lsDesktop(%s), hubPid = %d, left = [], hub = [], gone = false;\n"
        "if (!t || (d && t.id === d.id)) t = workspace.desktops[0];\n"
        "if (d) {\n"
        "  var ws = workspace.windowList();\n"
        "  for (var i = 0; i < ws.length; i++) {\n"
        "    if (!lsOnlyOn(ws[i], d)) continue;\n"
        "    if (lsIsHub(ws[i], hubPid)) hub.push(ws[i]); else left.push(lsInfo(ws[i]));\n"
        "  }\n"
        "  if (!left.length) {\n"
        "    for (var j = 0; j < hub.length; j++) hub[j].desktops = [t];\n"
        "    if (workspace.currentDesktop.id === d.id) workspace.currentDesktop = t;\n"
        "    workspace.removeDesktop(d);\n"
        "    gone = true;\n"
        "  }\n"
        "}\n"
        "lsReport(%s, {present: !!d, left: left, removed: gone});\n"
        % (js(desktop_id), js(target_id), int(hub_pid or 0), js(tag)))


def without_panel(pairs: list[tuple[str, int]]) -> list[tuple[str, int]]:
    fid = panel_id()
    return [p for p in pairs if not fid or p[0] != fid]


def script_rehome(pairs: list[tuple[str, int]], tag: str = "") -> str:
    pairs = without_panel(pairs)
    return JS_LIB + "var pairs = %s, moved = [];\n" % js([[did, int(kp)] for did, kp in pairs]) + (
        "for (var i = 0; i < pairs.length; i++) {\n"
        "  var d = lsDesktop(pairs[i][0]), w = lsWindow(pairs[i][1], '');\n"
        "  if (d && w && !lsOnlyOn(w, d)) { lsPlace(w, d, 'claude'); moved.push(pairs[i]); }\n"
        "}\n") + ("lsReport(%s, {moved: moved});\n" % js(tag) if tag else "")


def script_strays(pairs: list[tuple[str, int]], tag: str) -> str:
    pairs = without_panel(pairs)
    return JS_LIB + "var pairs = %s, his = %s, moved = [], ws = workspace.windowList();\n" % (
        js([[did, int(kp)] for did, kp in pairs]), js(main_state()["ids"])) + (
        "for (var i = 0; i < pairs.length; i++) {\n"
        "  var d = lsDesktop(pairs[i][0]), mine = [], j;\n"
        "  if (!d || d.id === workspace.desktops[0].id || his.indexOf(d.id) >= 0) continue;\n"
        "  for (j = 0; j < ws.length; j++) if (ws[j].normalWindow && ws[j].pid === pairs[i][1]) mine.push(ws[j]);\n"
        "  if (mine.length !== 1) continue;\n"
        "  var w = mine[0];\n"
        "  if (lsIsHub(w, 0) || w.onAllDesktops || lsOn(w, d)) continue;\n"
        "  var from = [], cap = String(w.caption || '');\n"
        "  for (j = 0; j < w.desktops.length; j++) from.push(w.desktops[j].id);\n"
        "  lsPlace(w, d, 'claude');\n"
        "  moved.push({desktop: pairs[i][0], pid: pairs[i][1], from: from, caption: cap});\n"
        "}\n"
        "lsReport(%s, {moved: moved});\n" % js(tag))


def script_panel_home(desktop_id: str, tag: str) -> str:
    return JS_LIB + (
        "var d = lsDesktop(%s), moved = [], skipped = [], ws = workspace.windowList(), i;\n"
        "var here = workspace.currentDesktop, focus = workspace.activeWindow;\n"
        "if (d) for (i = 0; i < ws.length; i++) {\n"
        "  var w = ws[i];\n"
        "  if (!w.normalWindow || w.onAllDesktops) continue;\n"
        "  if (String(w.resourceClass || '') !== %s && String(w.desktopFileName || '') !== %s) continue;\n"
        "  if (lsOnlyOn(w, d)) continue;\n"
        "  if (w === focus || (here && lsOn(w, here))) { skipped.push(lsInfo(w)); continue; }\n"
        "  w.desktops = [d];\n"
        "  moved.push(lsInfo(w));\n"
        "}\n"
        "lsReport(%s, {desktop: !!d, moved: moved, skipped: skipped});\n") % (
            js(desktop_id), js(PANEL_CLASS), js(PANEL_CLASS), js(tag))


def script_window_counts(pids: list[int], tag: str) -> str:
    return JS_LIB + "var pids = %s, counts = {}, ws = workspace.windowList(), i, j;\n" % js(
        sorted({int(p) for p in pids})) + (
        "for (i = 0; i < pids.length; i++) {\n"
        "  counts[pids[i]] = 0;\n"
        "  for (j = 0; j < ws.length; j++) if (ws[j].normalWindow && ws[j].pid === pids[i]) counts[pids[i]]++;\n"
        "}\n"
        "lsReport(%s, {counts: counts});\n" % js(tag))


def read_report(tag: str, wait: float) -> dict | None:
    path = REPORTS / f"{tag}.json"
    end = time.monotonic() + wait
    while True:
        try:
            data = json.loads(path.read_text())
            path.unlink(missing_ok=True)
            return data if isinstance(data, dict) else None
        except FileNotFoundError:
            pass
        except (OSError, ValueError):
            path.unlink(missing_ok=True)
            return None
        if time.monotonic() >= end:
            return None
        time.sleep(0.05)


def settle_slots(items: list[tuple[int, str, str, str]], screens: dict | None = None, sent: bool = False,
                 until: float | None = None) -> None:
    if not items:
        return
    skip = claude_konsole_pids() if any(cap for _, cap, _, _ in items) else []
    for _ in range(max(1, TILE_ROUNDS)):
        if until is not None and time.monotonic() + TILE_SETTLE + SETTLE_REPORT_WAIT + SETTLE_SCRIPT_MARGIN >= until:
            return
        time.sleep(TILE_SETTLE)
        tag = f"settle-{os.getpid()}-{next(_script_seq)}"
        if not kwin_script(script_settle(items, tag, skip, screens=screens, sent=sent), "settle"):
            return
        rep = read_report(tag, SETTLE_REPORT_WAIT)
        if rep is None:
            return
        if not any(w.get("fixed") for w in rep.get("windows") or []):
            return


def watched_screens() -> dict | None:
    try:
        data = read_hub_rows()
        shown = sticky_screens(data)
        marks = {s["name"] for s in shown if s.get("sticky")}
        free = [n for n in screens_in_front(s["name"] for s in shown) if n not in marks]
    except Exception:
        return None
    return {"good": free, "target": free[0]} if free else None


def place_window(desktop_id: str, slot: str, pid: int = 0, caption: str = "", focus: bool = False) -> bool:
    skip = claude_konsole_pids() if caption else []
    screens = watched_screens()
    tag = f"place-{os.getpid()}-{next(_script_seq)}" if screens else ""
    if not kwin_script(script_place(desktop_id, slot, pid, caption, focus, tag=tag, skip=skip, screens=screens), "place"):
        return False
    if tag:
        rep = read_report(tag, SETTLE_REPORT_WAIT)
        if rep is not None:
            sent = bool(rep.get("screened"))
            if sent or (rep.get("moved") and not rep.get("here")):
                w = rep.get("window") or {}
                settle_slots([(int(w.get("pid") or pid or 0), caption, desktop_id, slot)],
                             screens=screens, sent=sent)
            return True
    if current_desktop() not in (None, desktop_id):
        settle_slots([(pid, caption, desktop_id, slot)], screens=screens)
    return True


def placed_window(desktop_id: str, slot: str, pid: int = 0, caption: str = "", focus: bool = False,
                  primary: bool = False, info: dict | None = None) -> str:
    began = time.monotonic()
    tag = f"place-{os.getpid()}-{next(_script_seq)}"
    skip = claude_konsole_pids() if caption else []
    screens = watched_screens()
    if primary:
        screens = {**(screens or {"good": [], "target": ""}), "primary": True, "sticky": read_sticky()}
    if not kwin_script(script_place(desktop_id, slot, pid, caption, focus, tag=tag, skip=skip, screens=screens), "place"):
        return "refused"
    rep = read_report(tag, PLACE_WAIT)
    if rep is None:
        return "unsaid"
    if primary and info is not None:
        info["primary"] = rep.get("primary") or None
    if not rep.get("placed"):
        return "none"
    if (rep.get("moved") and not rep.get("here")) or rep.get("screened"):
        w = rep.get("window") or {}
        sent = bool(rep.get("screened"))
        settle_slots([(int(w.get("pid") or pid or 0), caption, desktop_id, slot)],
                     screens=screens if sent else None, sent=sent, until=began + PLACE_BUDGET)
    return "placed"


def konsole_window_counts(pids: list[int]) -> dict[int, int] | None:
    tag = f"counts-{os.getpid()}-{next(_script_seq)}"
    if not kwin_script(script_window_counts(pids, tag), "counts"):
        return None
    rep = read_report(tag, PLACE_WAIT)
    raw = rep.get("counts") if rep else None
    if not isinstance(raw, dict):
        return None
    out: dict[int, int] = {}
    for key, n in raw.items():
        if isinstance(n, int) and not isinstance(n, bool) and n >= 0 and str(key).isdigit():
            out[int(key)] = n
    return out


def switch_to(desktop_id: str, focus_pid: int = 0, focus_cls: str = "") -> bool:
    if current_desktop() == desktop_id and not focus_pid and not focus_cls:
        return True
    kwin_script(script_goto(desktop_id, focus_pid, focus_cls), "goto")
    if current_desktop() == desktop_id:
        return True
    qdbus(*VDM, f"{VDM_IF}.current", desktop_id)
    return current_desktop() == desktop_id



@contextmanager
def registry_lock(wait: bool = True):
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    with open(REGISTRY.with_name(REGISTRY.name + ".lock"), "a+") as fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def of_an_earlier_boot(data, mtime: float) -> bool:
    stamp = data.get("boot") if isinstance(data, dict) else None
    if isinstance(stamp, str) and stamp:
        now = current_boot()
        return bool(now) and stamp != now
    began = boot_epoch()
    return began > 0 and mtime < began


def without_processes(e: dict) -> dict:
    e = dict(e)
    if "konsole_pid" in e:
        e["konsole_pid"] = 0
    for k in ("pid", "resumed", "resumed_by"):
        e.pop(k, None)
    return e


def load_registry() -> tuple[list[dict], bool]:
    try:
        with REGISTRY.open() as fh:
            data = json.loads(fh.read())
            mtime = os.fstat(fh.fileno()).st_mtime
    except Exception:
        return [], False
    entries = data.get("desktops") if isinstance(data, dict) else data
    if not isinstance(entries, list):
        return [], False
    entries = [e for e in entries if isinstance(e, dict) and e.get("desktop_id")]
    stale = of_an_earlier_boot(data, mtime)
    return ([without_processes(e) for e in entries] if stale else entries), stale


def read_registry() -> list[dict]:
    return load_registry()[0]


def write_registry(entries: list[dict]) -> None:
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    tmp = REGISTRY.with_name(f".{REGISTRY.name}.{os.getpid()}.tmp")
    data = {"desktops": entries}
    boot = current_boot()
    if boot:
        data = {"boot": boot, **data}
    tmp.write_text(json.dumps(data, indent=1, ensure_ascii=False) + "\n")
    os.replace(tmp, REGISTRY)


def update_entry(desktop_id: str, *, drop: tuple = (), **fields) -> None:
    with registry_lock():
        entries = read_registry()
        for e in entries:
            if e.get("desktop_id") == desktop_id:
                e.update(fields)
                for k in drop:
                    e.pop(k, None)
        write_registry(entries)


def create_desktop(name: str, position: int | None = None, only_named: bool = False) -> dict:
    before = live_desktops()
    if before is None:
        raise Refused("KWin is not answering on D-Bus")
    if len(before) >= MAX_DESKTOPS:
        raise Refused(f"KWin already has {len(before)} desktops, its limit")
    at = len(before) if position is None else position
    if not 1 <= at <= len(before):
        raise Refused(f"a desktop is made at a position from 1 (right after desktop 1) to {len(before)}, not {at}")
    ids = {d["id"] for d in before}
    qdbus(*VDM, f"{VDM_IF}.createDesktop", str(at), name)
    end = time.monotonic() + 3
    while True:
        after = live_desktops() or []
        new = [d for d in after if d["id"] not in ids]
        if new:
            mine = [d for d in new if d["name"] == name] or ([] if only_named else new)
            if mine:
                return max(mine, key=lambda d: d["position"])
        if time.monotonic() > end:
            if new and only_named:
                raise MisnamedDesktop(f'KWin made a desktop called "{new[0]["name"]}", not "{name}"; it was left as it is')
            raise Refused("KWin did not create the desktop")
        time.sleep(0.05)



PAUSED_SWEEP = float(os.environ.get("CLAUDE_HUB_DESKTOP_PAUSED_SWEEP") or 300.0)
UNCHANGED_SWEEP = float(os.environ.get("CLAUDE_HUB_DESKTOP_UNCHANGED_SWEEP") or 30.0)
_kept_sweeps: dict[str, tuple[float, tuple | None, list[dict]]] = {}
_kept_sweeps_lock = threading.Lock()

ROSTER_CHECK = float(os.environ.get("CLAUDE_HUB_ROSTER_CHECK") or 300.0)
ROSTER_HOLD = float(os.environ.get("CLAUDE_HUB_ROSTER_HOLD") or 3600.0)
ROSTER_RETRY = float(os.environ.get("CLAUDE_HUB_ROSTER_RETRY") or 10.0)
ROSTER_YOUNG = float(os.environ.get("CLAUDE_HUB_ROSTER_YOUNG") or 120.0)
ROSTER_PATH = Path(os.environ.get("CLAUDE_HUB_ROSTER_PATH") or Path(__file__).resolve().parent / "claude-names")
ROSTER_OFF = Path(os.environ.get("CLAUDE_HUB_ROSTER_OFF") or HOME / ".config" / "claude-hub" / "roster-off")
CLAUDE_LINK = Path(os.environ.get("CLAUDE_HUB_LINK") or HOME / ".local" / "bin" / "claude")
_roster_state: dict[str, dict] = {}
_sweep_meta: dict[str, tuple[float, str, float | None]] = {}
_roster_loaded: dict = {"mod": None, "path": None, "failed": None}
_roster_said: dict[str, str] = {}


def _roster_say(key: str, text: str) -> None:
    if _roster_said.get(key) != text:
        _roster_said[key] = text
        print(f"claude-desks watch: roster: {text}", file=sys.stderr, flush=True)


def roster_module():
    state = _roster_loaded
    if state["path"] != ROSTER_PATH:
        state.update(mod=None, path=ROSTER_PATH, failed=None)
    if state["mod"] is not None:
        return state["mod"]
    now = time.monotonic()
    if state["failed"] is not None and now - state["failed"] < ROSTER_CHECK:
        return None
    try:
        loader = importlib.machinery.SourceFileLoader("claude_names", str(ROSTER_PATH))
        spec = importlib.util.spec_from_loader("claude_names", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        for name in ("rows", "shape", "check"):
            if not callable(getattr(mod, name, None)):
                raise AttributeError(f"no {name}")
    except Exception as err:                        # noqa: BLE001 (a roster that will not load is the CLI, never a stop)
        state["failed"] = now
        _roster_say("load", f"{ROSTER_PATH.name} did not load ({type(err).__name__}: {err}): every account asks the CLI")
        return None
    state["mod"] = mod
    _roster_said.pop("load", None)
    return mod


def roster_off() -> bool:
    try:
        return ROSTER_OFF.exists() or not ROSTER_PATH.is_file()
    except OSError:
        return False


def claude_version() -> str | None:
    try:
        return os.readlink(CLAUDE_LINK)
    except OSError:
        return None


def roster_build(name: str):
    mod = roster_module()
    if mod is None:
        return None
    dropped: list = []
    try:
        mod.ACCTS = ACCTS
        built = mod.rows(name, dropped=dropped)
        shaped = None if built is None else mod.shape(built)
    except Exception as err:                        # noqa: BLE001
        _roster_say(name, f"the files of {name} could not be built ({type(err).__name__}): asking the CLI for it")
        return None
    if built is None or shaped is None:
        return None
    _roster_said.pop(name, None)
    now_ms = time.time() * 1000
    young = {str(jid) for jid, written in dropped
             if isinstance(written, (int, float)) and -5000 <= now_ms - written < ROSTER_YOUNG * 1000}
    return built, shaped, young


def _roster_offset(name: str) -> float:
    return ROSTER_CHECK / 2 * (zlib.crc32(name.encode()) % 1000) / 1000


def _roster_mismatch_line(name: str, found: list[dict], held: bool = True) -> str:
    parts = []
    for item in found[:5]:
        what = item.get("what")
        word = ("cli_only" if what == "only_in_snapshot" else "files_only" if what == "only_in_roster"
                else "differs:" + ",".join(str(f) for f in item.get("fields") or []))
        if item.get("explained"):
            word += f" ({item['explained']})"
        parts.append(f"{str(item.get('id'))[:8]} {word}")
    more = f" and {len(found) - 5} more" if len(found) > 5 else ""
    tail = (f"the CLI serves it for {ROSTER_HOLD:.0f} s" if held
            else f"explained, no hold: the CLI serves this sweep, asked again in {ROSTER_RETRY:.0f} s")
    return f"roster check: {name} differs from the CLI ({'; '.join(parts)}{more}); {tail}"


def _mtime(p: Path) -> int | None:
    try:
        return p.stat().st_mtime_ns
    except OSError:
        return None


def sweep_mark(name: str) -> tuple | None:
    base = ACCTS / name
    try:
        parts: list = [paused(name), _mtime(base / "sessions"), _mtime(base / "jobs"), _mtime(base / "jobs" / "pins.json")]
        for p in sorted((base / "sessions").glob("*.json")):
            st = p.stat()
            parts.append((p.name, st.st_ino, st.st_mtime_ns, st.st_size, p.stem.isdigit() and Path(f"/proc/{p.stem}").exists()))
        for p in sorted((base / "jobs").glob("*/state.json")):
            parts.append((p.parent.name, _mtime(p)))
        return tuple(parts)
    except OSError:
        return None


SNAPSHOT_SCHEMA = 1
SNAPSHOT_MAX_BYTES = 8 * 1024 * 1024
_snapshot_write_failing = ""


def agents_snapshot_path() -> Path | None:
    override = os.environ.get("CLAUDE_HUB_AGENTS_SNAPSHOT")
    if override:
        return Path(override)
    run = os.environ.get("XDG_RUNTIME_DIR")
    return Path(run) / "claude-hub" / "agents.json" if run else None


def mark_digest(mark) -> str:
    import hashlib
    return hashlib.sha1(repr(mark).encode()).hexdigest()


def snapshot_writer_ok(pid) -> bool:
    if type(pid) is not int or not pid_alive(pid):
        return False
    return any(os.path.basename(arg) == b"claude-desks" for arg in cmdline(pid).split(b"\0"))


def write_agents_snapshot(sweep: dict[str, list[dict] | None]) -> None:
    global _snapshot_write_failing
    path = agents_snapshot_path()
    if path is None:
        return
    tmp = None
    try:
        with _kept_sweeps_lock:
            mono, wall = time.monotonic(), time.time()
            accounts: dict[str, dict] = {}
            for name, rows in sweep.items():
                hit = _kept_sweeps.get(name)
                if rows is None or not hit:
                    accounts[name] = {"read_us": int(wall * 1e6), "read_mono": mono, "unreadable": True}
                else:
                    meta = _sweep_meta.get(name)
                    source, cli_at = (meta[1], meta[2]) if meta and meta[0] == hit[0] else ("cli", hit[0])
                    accounts[name] = {"read_us": int((wall - (mono - hit[0])) * 1e6), "read_mono": hit[0],
                                      "mark": mark_digest(hit[1]), "rows": hit[2], "source": source,
                                      "cli_checked_mono": cli_at}
            text = json.dumps({"schema": SNAPSHOT_SCHEMA, "writer_pid": os.getpid(), "accts_root": str(ACCTS),
                               "written_us": int(wall * 1e6), "accounts": accounts})
            path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "w") as f:
                os.fchmod(f.fileno(), 0o600)
                f.write(text)
            os.replace(tmp, path)
        _snapshot_write_failing = ""
    except Exception as err:                        # noqa: BLE001 (the sweeper must go on)
        line = f"claude-desks watch: the shared session list was not written: {err}"
        if line != _snapshot_write_failing:
            _snapshot_write_failing = line
            print(line, file=sys.stderr, flush=True)
        if tmp is not None:
            try:
                tmp.unlink()
            except OSError:
                pass


def read_agents_snapshot(names: list[str], marks: dict, now: float) -> dict[str, list[dict]]:
    path = agents_snapshot_path()
    if path is None or not names:
        return {}
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_NOCTTY)
        try:
            st = os.fstat(fd)
            if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o022
                    or st.st_size > SNAPSHOT_MAX_BYTES):
                return {}
            f = os.fdopen(fd, "rb")
            fd = -1
            with f:
                doc = json.loads(f.read())
        finally:
            if fd >= 0:
                os.close(fd)
        if (not isinstance(doc, dict) or type(doc.get("schema")) is not int or doc["schema"] != SNAPSHOT_SCHEMA
                or doc.get("accts_root") != str(ACCTS) or not isinstance(doc.get("accounts"), dict)
                or not snapshot_writer_ok(doc.get("writer_pid"))):
            return {}
        out: dict[str, list[dict]] = {}
        for n in names:
            entry = doc["accounts"].get(n)
            if marks.get(n) is None or not isinstance(entry, dict) or "unreadable" in entry:
                continue
            rows, read_at, digest = entry.get("rows"), entry.get("read_mono"), entry.get("mark")
            if (isinstance(rows, list) and all(isinstance(r, dict) for r in rows) and type(read_at) in (int, float)
                    and isinstance(digest, str) and digest == mark_digest(marks[n])
                    and 0 <= now - read_at < UNCHANGED_SWEEP):
                out[n] = rows
        return out
    except Exception:                               # noqa: BLE001 (a file that cannot be judged answers nothing)
        return {}


def sweep_agents(names: list[str] | None = None, *, fresh: bool = False, poked: bool = False,
                 shared: bool = False, from_files: bool = False) -> dict[str, list[dict] | None]:
    names = accounts() if names is None else names
    now = time.monotonic()
    marks = {n: sweep_mark(n) for n in names}
    files_on = from_files and not fresh
    if files_on and roster_off():
        files_on = False
        _roster_state.clear()
    built: dict[str, tuple] = {}
    checks: set[str] = set()
    youngs: set[str] = set()
    stored: dict[str, list[dict]] = {}
    changed: set[str] = set()
    version = None
    if files_on:
        version = claude_version()
        for n in names:
            state = _roster_state.setdefault(n, {})
            if now < state.get("until", 0.0):
                continue
            made = roster_build(n)
            if made is None:
                continue
            built[n] = made
            last = state.get("checked")
            due = state.get("due", (last or 0.0) + ROSTER_CHECK)
            waiting = now < state.get("retry", 0.0)
            new_version = "version" in state and state["version"] != version
            if new_version:
                changed.add(n)
            if not waiting and (new_version or last is None or now >= due or state.get("version") != version):
                checks.add(n)
            elif new_version or made[2]:
                saved, same = state.get("young_rows"), marks[n] is not None and state.get("young_mark") == marks[n]
                if (now >= state.get("young_until", 0.0) or (saved is None and new_version)
                        or (saved is not None and not same)):
                    youngs.add(n)
                elif saved is not None:
                    stored[n] = list(saved)
    kept: dict[str, list[dict]] = {}
    if not fresh:
        with _kept_sweeps_lock:
            for n in names:
                hit = _kept_sweeps.get(n)
                if not hit or n in built:
                    continue
                meta = _sweep_meta.get(n)
                if from_files and meta and meta[0] == hit[0] and meta[1] == "files":
                    continue
                if not poked and now - hit[0] < PAUSED_SWEEP and paused(n) and hit[1] is not None and hit[1][0]:
                    kept[n] = list(hit[2])
                elif now - hit[0] < UNCHANGED_SWEEP and marks[n] is not None and marks[n] == hit[1]:
                    kept[n] = list(hit[2])
        if shared:
            kept.update(read_agents_snapshot([n for n in names if n not in kept and n not in built], marks, now))
    asked = [n for n in names if (n not in kept and n not in built) or n in checks or n in youngs]

    def ask(n: str):
        return agents(n), (sweep_mark(n) if n in checks else None)

    answers: dict[str, tuple] = {}
    if asked:
        with ThreadPoolExecutor(max_workers=len(asked)) as pool:
            answers = dict(zip(asked, pool.map(ask, asked)))
    out: dict[str, list[dict] | None] = {}
    with _kept_sweeps_lock:
        for n in names:
            if n in built:
                full, rows, young = built[n]
                state, source = _roster_state[n], "files"
                if n in checks:
                    cli, after = answers[n]
                    if cli is None:
                        if n in changed:
                            rows, source = None, "cli"
                        else:
                            state["retry"] = now + ROSTER_RETRY
                    elif marks[n] is None or after != marks[n]:
                        state.update(retry=now + ROSTER_RETRY, cli_at=now, young_rows=list(cli), young_mark=marks[n],
                                     young_until=now + ROSTER_RETRY)
                        rows, source = list(cli), "cli"
                    else:
                        found, failed = None, ""
                        try:
                            found = roster_module().check(cli, full)
                        except Exception as err:   # noqa: BLE001 (a check that cannot be made is a difference: the CLI)
                            failed = type(err).__name__
                        if not failed and not isinstance(found, list):
                            failed = "NotAList"
                        if found == []:
                            routine = state.get("checked") is not None and state.get("version") == version
                            state.update(checked=now, version=version, retry=0.0, cli_at=now,
                                         due=now + ROSTER_CHECK - (0.0 if routine else _roster_offset(n)))
                            _roster_said.pop(f"{n}:explained", None)
                        elif failed == "" and all(
                                m.get("explained") or (m.get("what") == "only_in_snapshot" and m.get("id") in young)
                                for m in found if isinstance(m, dict)):
                            state.update(retry=now + ROSTER_RETRY, cli_at=now)
                            if state.get("version") != version:
                                state.update(version=version, checked=None)
                            if young:
                                state.update(young_rows=list(cli), young_mark=marks[n], young_until=now + ROSTER_RETRY)
                            _roster_say(f"{n}:explained", _roster_mismatch_line(n, found, held=False))
                            rows, source = list(cli), "cli"
                        else:
                            state.update(until=now + ROSTER_HOLD, checked=None, retry=0.0, cli_at=now)
                            line = (_roster_mismatch_line(n, found) if failed == "" else
                                    f"roster check: {n} could not be compared ({failed}); the CLI serves it for "
                                    f"{ROSTER_HOLD:.0f} s")
                            print(f"claude-desks watch: {line}", file=sys.stderr, flush=True)
                            rows, source = list(cli), "cli"
                elif n in youngs:
                    cli = answers[n][0]
                    state["young_until"] = now + ROSTER_RETRY
                    if cli is not None:
                        state.update(young_rows=list(cli), young_mark=marks[n], cli_at=now)
                        rows, source = list(cli), "cli"
                    elif n in changed:
                        rows, source = None, "cli"
                elif n in stored:
                    rows, source = stored[n], "cli"
                if rows is None:
                    _kept_sweeps.pop(n, None)
                    _sweep_meta.pop(n, None)
                else:
                    _kept_sweeps[n] = (now, marks[n], list(rows))
                    _sweep_meta[n] = (now, source, now if n in answers and source == "cli" else state.get("cli_at"))
                out[n] = rows
            elif n in kept:
                out[n] = kept[n]
            else:
                rows = answers[n][0]
                if rows is not None:
                    _kept_sweeps[n] = (now, marks[n], list(rows))
                    _sweep_meta[n] = (now, "cli", now)
                else:
                    _kept_sweeps.pop(n, None)
                    _sweep_meta.pop(n, None)
                out[n] = rows
    return out


def gather(sweep: dict[str, list[dict] | None] | None = None, shared: bool = False) -> SimpleNamespace:
    records = window_records()
    with ThreadPoolExecutor(max_workers=3) as pool:
        sweep_f = None
        if sweep is None:
            sweep_f = pool.submit(sweep_agents, shared=True) if shared else pool.submit(sweep_agents)
        linked = False
        if kwin_link_ready():
            _kwin_link.silent = False
            linked, desktops = kwin_read("desktops", desktops_from_link)
            if linked:
                desktops = desktops or None
                current = None if _kwin_link.silent else current_desktop()
        if not linked:
            desk_f = pool.submit(live_desktops)
            cur_f = pool.submit(current_desktop)
            desktops, current = desk_f.result(), cur_f.result()
        sweep = sweep_f.result() if sweep_f else sweep
    sessions, unread = [], set()
    for name, rows in sweep.items():
        if rows is None:
            unread.add(name)
        sessions.extend(normalize(name, rows, records))
    return SimpleNamespace(accounts=list(sweep), sessions=sessions, unread=unread, records=records,
                           desktops=desktops, current=current, registry=read_registry(),
                           attention=attention_flags(), at=time.time(), sweep=sweep,
                           screens=None, screens_at=None)


def record_in_konsole(snap, konsole_pid: int) -> dict | None:
    if not konsole_pid:
        return None
    for rec in snap.records.values():
        if record_pid(rec) == konsole_pid:
            return rec
    return None


def plain_in_konsole(snap, konsole_pid: int) -> dict | None:
    if not konsole_pid:
        return None
    return next((s for s in snap.sessions if s["kind"] == "plain" and s["konsole_pid"] == konsole_pid), None)


LINEAGE_MAX = 8


def merged_lineage(own: str, *lists) -> list[str]:
    out: list[str] = []
    for ids in lists:
        if not isinstance(ids, list):
            continue
        for sid in ids:
            if isinstance(sid, str) and sid and sid != own and sid not in out:
                out.append(sid)
    return out[:LINEAGE_MAX]


def entry_ids(e: dict) -> list[str]:
    own = e.get("session_id") if isinstance(e.get("session_id"), str) else ""
    return ([own] if own else []) + merged_lineage(own, e.get("lineage"))


def entry_for_session(entries: list[dict], sid) -> dict | None:
    if not isinstance(sid, str) or not sid:
        return None
    for e in entries:
        if e.get("session_id") == sid:
            return e
    hits = [e for e in entries if sid in entry_ids(e)]
    return hits[0] if len(hits) == 1 else None


def claude_konsole_pids(entries: list[dict] | None = None) -> list[int]:
    pids: set[int] = set()
    for e in read_registry() if entries is None else entries:
        kp = e.get("konsole_pid")
        if isinstance(kp, int) and not isinstance(kp, bool) and kp > 1:
            pids.add(kp)
    return sorted(pids)


_FILE_NAME = re.compile(r"[0-9A-Za-z_-]+")


def usable_session(e: dict, account: str, ids: list[str] | None = None) -> str:
    ids = entry_ids(e) if ids is None else ids
    if ids and _FILE_NAME.fullmatch(account or ""):
        projects = ACCTS / account / "projects"
        for sid in ids:
            try:
                if _FILE_NAME.fullmatch(sid) and next(projects.glob(f"*/{sid}.jsonl"), None):
                    return sid
            except OSError:
                pass
    return e.get("session_id") or ""


def take_record(e: dict, rec: dict) -> None:
    was = e.get("session_id") or ""
    e.update(kind="window", account=rec.get("account") or e.get("account", ""), id=rec.get("id") or "",
             session_id=rec.get("session_id") or was)
    now = e["session_id"]
    if was and was != now:
        lineage = merged_lineage(now, [was], rec.get("lineage"), e.get("lineage"))
    else:
        lineage = merged_lineage(now, e.get("lineage"), rec.get("lineage"))
    if lineage:
        e["lineage"] = lineage
    else:
        e.pop("lineage", None)
    for k in ("pid", "resumed", "resumed_by"):
        e.pop(k, None)


RESUME_ARGS = re.compile(rb"\bresume\s+\S+\s+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\b")


def resumed_from(rec: dict) -> str:
    m = RESUME_ARGS.search(cmdline(rec.get("wrapper_pid")).replace(b"\0", b" "))
    return m.group(1).decode() if m else ""


def record_chain(key: str, rec: dict) -> list[str]:
    sid = rec.get("session_id") or key
    return [sid, resumed_from(rec)] + merged_lineage(sid, rec.get("lineage"))


def record_pid(rec: dict) -> int:
    pid = rec.get("konsole_pid")
    if isinstance(pid, (bool, float)):
        return 0
    try:
        pid = int(pid or 0)
    except (TypeError, ValueError, OverflowError):
        return 0
    return pid if 0 < pid <= PID_LIMIT else 0


def other_desktops_sessions(e: dict, snap) -> set[str]:
    return {x["session_id"] for x in getattr(snap, "registry", None) or ()
            if x.get("desktop_id") != e.get("desktop_id")
            and isinstance(x.get("session_id"), str) and x["session_id"]}


def chain_sides(e: dict, snap) -> tuple[list[str], set[str], set[str]]:
    own = e.get("session_id") if isinstance(e.get("session_id"), str) else ""
    now = other_desktops_sessions(e, snap)
    ours = [i for i in entry_ids(e) if i == own or i not in now]
    every = set().union(*(entry_ids(x) for x in getattr(snap, "registry", None) or ()
                          if x.get("desktop_id") != e.get("desktop_id")))
    shared = {i for i in ours if i in every and (i != own or i in now)}
    return ours, every - set(ours), shared


def comes_first(chain: list[str], ours, theirs) -> bool:
    return next((i for i in chain if i in ours or i in theirs), "") in ours


def resumed_window(ids: list[str], snap, taken=frozenset(), others=frozenset(), shared=frozenset()) -> dict | None:
    if not ids:
        return None
    ours = set(ids)
    others = set(others) - ours
    best, best_rank = None, None
    for key, rec in snap.records.items():
        nk = record_pid(rec)
        if not nk or nk in taken or not pid_alive(nk) or not is_konsole(nk):
            continue
        chain = record_chain(key, rec)
        sid = chain[0]
        if not comes_first(chain, ours, others):
            continue
        if sid == ids[0]:
            rank = 0
        elif sid in ours or chain[1] in ours:
            rank = 1
        elif ours.intersection(chain[2:]):
            rank = 2
        else:
            continue
        first = next((i for i in chain if i in ours or i in others), "")
        order = (first not in shared, -rank, float(rec.get("attached_at") or 0))
        if best_rank is None or order > best_rank:
            best, best_rank = rec, order
    return best


def follow(e: dict, snap) -> int:
    kp = int(e.get("konsole_pid") or 0)
    rec = record_in_konsole(snap, kp) if pid_alive(kp) else None
    if rec:
        take_record(e, rec)
        return 0
    plain = plain_in_konsole(snap, kp) if pid_alive(kp) else None
    if plain:
        e.update(kind="plain", account=plain["account"], id="", session_id=plain["session_id"], pid=plain["pid"])
        e.pop("resumed", None)
        e.pop("resumed_by", None)
        return 0
    ids = entry_ids(e)
    if not pid_alive(kp) and ids:
        taken = {int(x.get("konsole_pid") or 0) for x in snap.registry if x is not e}
        ours, theirs, shared = chain_sides(e, snap)
        rec = resumed_window(ours, snap, taken, theirs, shared)
        nk = record_pid(rec or {})
        if nk and nk != kp and pid_alive(nk) and nk not in taken:
            e["konsole_pid"] = nk
            return nk
    if kp and not pid_alive(kp):
        e["konsole_pid"] = 0
    return 0


def entry_status(e: dict, snap) -> str:
    kp = int(e.get("konsole_pid") or 0)
    if pid_alive(kp) and (record_in_konsole(snap, kp) or plain_in_konsole(snap, kp)):
        return "running"
    if starting_again(e):
        return "unknown"
    if e.get("account") not in snap.accounts:
        return "unknown"
    sid = e.get("session_id") or ""
    if e.get("kind") == "plain":
        if any(s["session_id"] == sid and s["kind"] == "plain" for s in snap.sessions if sid):
            return "running"
        if e.get("account") in snap.unread:
            return "running" if pid_alive(e.get("pid")) else "unknown"
        return "gone"
    if sid:
        ids, theirs, _ = chain_sides(e, snap)
        held = {int(x.get("konsole_pid") or 0) for x in getattr(snap, "registry", None) or ()
                if x.get("desktop_id") != e.get("desktop_id")} - {0}
        if (any(s["session_id"] in ids for s in snap.sessions)
                or any(comes_first(record_chain(k, r), ids, theirs)
                       for k, r in snap.records.items() if record_pid(r) not in held)):
            return "running"
        if e.get("account") in snap.unread:
            return "unknown"
        return "gone"
    if wrapper_in(kp):
        return "running"
    opened = max(float(e.get("created") or 0), float(e.get("resumed") or 0))
    if not pid_alive(kp) and recent(opened, STARTING_FOR):
        return "unknown"
    if recent(opened, LAUNCHING_FOR):
        return "unknown"
    return "gone"


def session_of(e: dict, snap) -> dict | None:
    sid = e.get("session_id") or ""
    return next((s for s in snap.sessions if sid and s["session_id"] == sid), None)


def desired_name(e: dict, snap) -> str | None:
    s = session_of(e, snap)
    if s and s.get("name"):
        return f"{s['name']} · {s['account']}"
    return None


def stray_moves(report, label_of: dict) -> list[dict]:
    moved = report.get("moved") if isinstance(report, dict) else None
    out = []
    for m in moved if isinstance(moved, list) else []:
        if not isinstance(m, dict):
            continue
        did, pid, came = m.get("desktop"), m.get("pid"), m.get("from")
        if not isinstance(did, str) or isinstance(pid, bool) or not isinstance(pid, int) or (did, pid) not in label_of:
            continue
        out.append({"desktop": did, "pid": pid,
                    "from": [i for i in came if isinstance(i, str)] if isinstance(came, list) else []})
    return out


def sync(snap) -> list[str]:
    global _stray_checked
    if not snap.desktops:
        return []
    notes, renames, rehomes, strays = [], [], [], []
    now = time.time()
    with registry_lock():
        desktops = live_desktops()
        if not desktops:
            return []
        live = {d["id"]: d for d in desktops}
        his = set(his_ids(desktops))
        entries, stale = load_registry()
        before = json.dumps(entries, sort_keys=True)
        keep = []
        snap.registry = entries
        for e in entries:
            label = e.get("name") or e["desktop_id"]
            if e["desktop_id"] in his:
                notes.append(f"forgot {label}: it named {his_words(live[e['desktop_id']], desktops)}, which is his")
                continue
            d = live.get(e["desktop_id"])
            if d:
                e.pop("desktop_gone", None)
            elif not e.get("desktop_gone"):
                e["desktop_gone"] = True
                notes.append(f"the desktop of {label} was removed; its row stays (resume makes it again)")
            if follow(e, snap):
                e["rehome_until"] = now + 60
                notes.append(f"the reopened window of {label} goes back onto its desktop")
            ending = recent(e.get("ending"), ENDING_FOR)
            if float(e.get("rehome_until") or 0) <= now:
                e.pop("rehome_until", None)
            elif d and not ending and pid_alive(e.get("konsole_pid")):
                rehomes.append((d["id"], int(e["konsole_pid"])))
            s = session_of(e, snap)
            if s and s.get("cwd"):
                e["cwd"] = s["cwd"]
            status = entry_status(e, snap)
            if status == "gone" and "stopped_since" not in e:
                e["stopped_since"] = now
                where = f"desktop {d['number']}" if d else label
                notes.append(f"{where}: its Claude stopped (the desktop stays)")
            elif status == "running":
                e.pop("stopped_since", None)
            want = desired_name(e, snap)
            if want and e.get("name") != want:
                e["name"] = want
            if d:
                if want and d["name"] != want:
                    renames.append((d["id"], want))
                e["number"] = d["number"]
                kp = int(e.get("konsole_pid") or 0)
                if (not ending and pid_alive(kp) and (record_in_konsole(snap, kp) or plain_in_konsole(snap, kp))
                        and (d["id"], kp) not in rehomes):
                    strays.append((d["id"], kp, e.get("name") or e["desktop_id"]))
            keep.append(e)
        for did, want in renames:
            qdbus(*VDM, f"{VDM_IF}.setDesktopName", did, want)
            notes.append(f"renamed desktop {live[did]['number']} to {want}")
            live[did]["name"] = want
        if stale or json.dumps(keep, sort_keys=True) != before:
            write_registry(keep)
    if rehomes:
        tag = f"rehome-{os.getpid()}-{next(_script_seq)}"
        if not kwin_script(script_rehome(rehomes, tag), "rehome"):
            notes.append("KWin did not run the script that moves reopened windows home; the next look tries again")
        else:
            rep = read_report(tag, PLACE_WAIT) or {}
            settle_slots([(int(kp), "", did, "claude") for did, kp in rep.get("moved") or []])
    held = Counter(int(e.get("konsole_pid") or 0) for e in keep)
    strays = [c for c in strays if held[c[1]] == 1]
    due = bool(strays) and (not _stray_checked or time.monotonic() - _stray_checked >= STRAY_EVERY)
    if due:
        _stray_checked = time.monotonic()
        current = {x["desktop_id"]: x for x in read_registry()}
        strays = [c for c in strays if c[0] in current and not recent(current[c[0]].get("ending"), ENDING_FOR)]
    if due and strays:
        tag = f"strays-{os.getpid()}-{next(_script_seq)}"
        if not kwin_script(script_strays([(did, kp) for did, kp, _ in strays], tag), "strays"):
            notes.append(f"KWin did not run the stray check; the next check (in {STRAY_EVERY:g} s) tries again")
        else:
            label_of = {(did, kp): label for did, kp, label in strays}
            moved = stray_moves(read_report(tag, SETTLE_REPORT_WAIT), label_of)
            for m in moved:
                where = [f"{live[i]['number']} ({live[i]['name']})" if i in live else i for i in m["from"]]
                notes.append(f"the window of {label_of[(m['desktop'], m['pid'])]} was on "
                             f"desktop{'s' if len(where) > 1 else ''} {', '.join(where) or 'none'}; "
                             "put back on its own")
            settle_slots([(int(m["pid"]), "", m["desktop"], "claude") for m in moved])
    return notes


def identity_in(e: dict, snap) -> dict | None:
    kp = int(e.get("konsole_pid") or 0)
    rec = record_in_konsole(snap, kp) if pid_alive(kp) else None
    if not rec:
        return None
    new = dict(e)
    take_record(new, rec)
    if rec.get("cwd") and (not new.get("cwd") or new["session_id"] != e.get("session_id")):
        new["cwd"] = rec["cwd"]
    return new if new != e else None


def keep_identity(snap) -> None:
    if not any(identity_in(e, snap) for e in snap.registry):
        return
    with registry_lock(wait=False) as held:
        if not held:
            return
        current = read_registry()
        entries = [identity_in(e, snap) or e for e in current]
        if entries != current:
            write_registry(entries)
        snap.registry = entries



ROW_STATUS = {"busy": "working", "waiting": "waiting", "idle": "idle"}
ROW_NEEDS: dict[str, str] = {}

PARKED_MISS_TTL = 15.0
PARKED_KEEP = 256
_transcript_state_mod = _UNREAD
_transcripts: dict[tuple, list] = {}
_transcripts_lock = threading.Lock()


def transcript_state_module():
    global _transcript_state_mod
    if _transcript_state_mod is _UNREAD:
        path = Path(__file__).resolve().parent / "claude-session-state"
        try:
            loader = importlib.machinery.SourceFileLoader("claude_session_state", str(path))
            spec = importlib.util.spec_from_loader("claude_session_state", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            _transcript_state_mod = mod
        except Exception as err:                    # noqa: BLE001
            print(f"claude-desks: no parked state ({path.name} did not load: {err})", file=sys.stderr, flush=True)
            _transcript_state_mod = None
    return _transcript_state_mod


def transcript_word(account: str, session_id: str) -> str | None:
    mod = transcript_state_module()
    if mod is None or not (mod.valid_name(account) and mod.valid_name(session_id)):
        return None
    mod.ACCTS = ACCTS
    key, now = (str(ACCTS), account, session_id), time.monotonic()
    with _transcripts_lock:
        kept = _transcripts.get(key)
    path = kept[0] if kept else None
    if kept and path is None and now - kept[3] < PARKED_MISS_TTL:
        return None
    searched = False
    while True:
        if path is None:
            path, searched = mod.find_transcript(account, session_id), True
            if path is None:
                with _transcripts_lock:
                    _transcripts[key] = [None, None, None, now]
                return None
        try:
            info = os.stat(path)
            break
        except OSError:
            if searched:
                return None
            path = None
    stamp = (info.st_size, info.st_mtime_ns)
    word = kept[2] if kept and kept[0] == path and kept[1] == stamp else None
    if word is None:
        word = mod.classify_file(path)
    with _transcripts_lock:
        _transcripts[key] = [path, stamp, word, now]
        if len(_transcripts) > PARKED_KEEP:
            for old in [k for k, v in _transcripts.items() if now - v[3] > 3600]:
                del _transcripts[old]
    return word


def session_parked(s: dict) -> bool:
    try:
        return transcript_word(s.get("account") or "", s.get("session_id") or "") == "waiting"
    except Exception:                               # noqa: BLE001  a look never breaks on a transcript
        return False


def claude_name(name: str, account: str) -> str:
    tail = f" · {account}" if account else ""
    return name[: -len(tail)] if tail and name.endswith(tail) and len(name) > len(tail) else name


def rows(snap, panel=_UNREAD, aux=_UNREAD) -> list[dict]:
    desktops = snap.desktops or []
    mains = his_ids(desktops)
    his = set(mains)
    if panel is _UNREAD:
        panel = panel_of(desktops)
    if aux is _UNREAD:
        aux = aux_of(desktops)
    panel_ids = ({panel["id"]} if panel else set()) | ({aux["id"]} if aux else set())
    live_ids = {d["id"] for d in desktops}
    swept = set(snap.accounts) - set(snap.unread)
    rank = {n: i for i, n in enumerate(ACCOUNT_ORDER)}
    entries = [e for e in snap.registry if e["desktop_id"] not in his] if snap.desktops is not None else []
    entry_of: dict[str, dict] = {}
    for e in entries:
        entry_of.setdefault(e["desktop_id"], e)
    by_sid = {e["session_id"]: e for e in entries if e.get("session_id")}
    by_konsole = {int(e["konsole_pid"]): e for e in entries if e.get("konsole_pid")}
    claudes_of: dict[str, list[dict]] = {}
    loose = []
    for s in snap.sessions:
        e = (by_sid.get(s["session_id"]) if s["session_id"] else None) or \
            (by_konsole.get(s["konsole_pid"]) if s["konsole_pid"] else None)
        (claudes_of.setdefault(e["desktop_id"], []) if e else loose).append(s)

    def asks(s):
        flag = snap.attention.get(s["session_id"]) if s["session_id"] else None
        return flag is not None, (ROW_NEEDS.get(str(flag.get("kind") or "")) if flag is not None else None)

    def claude_state(s, fallback):
        needed, needs = asks(s)
        if needed:
            return "needs-you", needs
        if fallback == "working" and s.get("status") == "busy" and session_parked(s):
            return "parked", None
        return fallback, None

    def row(key, typ, state, d=None, e=None, s=None, needs=None, gone=False, name=None):
        e, src = e or {}, s or {}
        account = src.get("account") or e.get("account") or ""
        kp = int(src.get("konsole_pid") or 0) if s else int(e.get("konsole_pid") or 0)
        r = {"key": key, "type": typ, "number": d["number"] if d else None,
                "desktop_id": d["id"] if d else (e.get("desktop_id") if gone else None),
                "desktop_gone": gone, "yours": bool(d) and d["id"] in his,
                "current": bool(d) and d["id"] == snap.current, "account": account,
                "name": name if name is not None else (src.get("name") or ""),
                "state": state, "needs": needs,
                "session_id": src.get("session_id") or e.get("session_id") or "",
                "by_him": named_by_him(src.get("session_id") or e.get("session_id") or ""),
                "id": src.get("id") or e.get("id") or "",
                "kind": src.get("kind") or (("plain" if e.get("kind") == "plain" else "background") if e else ""),
                "konsole_pid": kp if s or pid_alive(kp) else 0,
                "started": src.get("started") or 0, "cwd": src.get("cwd") or e.get("cwd") or ""}
        if len(mains) > 1 and d and d["id"] in his:
            r["main"] = mains.index(d["id"]) + 1
        return r

    def claude_rows(e, d, gone):
        found = claudes_of.get(e["desktop_id"], [])
        own = [s for s in found if e.get("session_id") and s["session_id"] == e["session_id"]]
        found = own + sorted((s for s in found if s not in own), key=lambda s: s.get("started") or 0)
        base = claude_name(d["name"] if d else (e.get("name") or ""), e.get("account") or "")
        if not found:
            if e.get("stopped_since") or (e.get("account") in swept and entry_status(e, snap) == "gone"):
                state = "stopped"
            elif e.get("account") not in swept:
                state = "looking"
            else:
                state = "starting"
            return [row(f"d:{e['desktop_id']}", "desktop", state, d, e, gone=gone, name=base)]
        s, out = found[0], []
        shown = s["kind"] != "background" or s.get("windowed")
        state, needs = claude_state(s, ROW_STATUS.get(s.get("status") or "", "idle")
                                    if shown or s.get("status") == "waiting" else "no-window")
        out.append(row(f"d:{e['desktop_id']}", "desktop", state, d, e, s, needs=needs, gone=gone,
                       name=s.get("name") or base))
        for x in found[1:]:
            state, needs = claude_state(x, ROW_STATUS.get(x.get("status") or "", "idle"))
            out.append(row(f"s:{x['session_id'] or x['pid']}", "claude", state, d, e, x, needs=needs, gone=gone))
        return out

    out = []
    for d in desktops:
        if d["id"] in panel_ids:
            continue
        e = entry_of.get(d["id"])
        if e:
            out.extend(claude_rows(e, d, gone=False))
        else:
            state = "yours" if d["id"] in his else "no-claude"
            out.append(row(f"d:{d['id']}", "desktop", state, d, name=d["name"]))
    for e in entries:
        if e["desktop_id"] not in live_ids and entry_of.get(e["desktop_id"]) is e:
            out.extend(claude_rows(e, None, gone=True))
    loose.sort(key=lambda s: (s["kind"] == "plain", rank.get(s["account"], 99), s.get("started") or 0,
                              s["session_id"]))
    for s in loose:
        state, needs = claude_state(s, "waiting" if s.get("status") == "waiting" else s["kind"])
        out.append(row(f"s:{s['session_id'] or s['pid']}", "claude", state, s=s, needs=needs))
    return out


def claude_window_desktop(pid, fallback: list[dict] | None = None) -> str:
    try:
        pid = int(pid or 0)
    except (TypeError, ValueError):
        return ""
    if pid <= 0:
        return ""
    desktops = live_desktops() or fallback
    if not desktops:
        return ""
    claude_ids = {d["id"] for d in after_his(desktops)}
    entries = [e for e in read_registry() if e["desktop_id"] in claude_ids]
    records = window_records()
    guess, opened_at = None, -1.0
    for e in entries:
        if int(e.get("konsole_pid") or 0) != pid:
            continue
        rec = records.get(e.get("session_id") or "")
        plain = e.get("kind") == "plain" and pid_alive(e.get("pid")) and konsole_above(int(e.get("pid") or 0)) == pid
        if (rec and record_pid(rec) == pid) or plain:
            return e["desktop_id"]
        opened = max(float(e.get("created") or 0), float(e.get("resumed") or 0))
        if (recent(opened, STARTING_FOR) or wrapper_in(pid)) and opened > opened_at:
            guess, opened_at = e, opened
    if guess is not None:
        return guess["desktop_id"]
    for sid, rec in records.items():
        if record_pid(rec) == pid:
            e = next((x for x in entries if sid and x.get("session_id") == sid), None)
            if e:
                return e["desktop_id"]
    return ""



def need_desktops() -> list[dict]:
    ds = live_desktops()
    if ds is None:
        raise Refused("KWin is not answering on D-Bus (org.kde.KWin /VirtualDesktopManager)")
    return ds


def entry_line(e: dict) -> str:
    return f"{e['desktop_id']} {e.get('number', '?')} {e.get('name', '')}"


def with_live(e: dict, desktops: list[dict] | None, current: str | None) -> dict:
    out = {k: v for k, v in e.items() if not k.startswith("_")}
    d = next((x for x in desktops or [] if x["id"] == e["desktop_id"]), None)
    if d:
        out["number"], out["name"] = d["number"], d["name"]
    out["current"] = bool(current) and current == e["desktop_id"]
    return out


def find_me(entries: list[dict]) -> dict | None:
    mine = entry_for_session(entries, os.environ.get("CLAUDE_CODE_SESSION_ID") or "")
    if mine:
        return mine
    konsoles = {int(e.get("konsole_pid") or 0): e for e in entries if e.get("konsole_pid")}
    for p in ancestors(os.getpid()):
        if p in konsoles:
            return konsoles[p]
    return None


def cmd_whoami(as_json: bool) -> int:
    e = find_me(read_registry())
    if not e:
        return 1
    desktops = live_desktops()
    if desktops is not None and (not any(d["id"] == e["desktop_id"] for d in desktops)
                                 or e["desktop_id"] in his_ids(desktops)):
        return 1
    out = with_live(e, desktops, current_desktop() if desktops else None)
    print(json.dumps(out, ensure_ascii=False) if as_json else entry_line(out))
    return 0


def active_window() -> dict | None:
    tag = f"active-{os.getpid()}-{next(_script_seq)}"
    body = JS_LIB + ("var w = workspace.activeWindow;\n"
                     "lsReport(%s, {window: w ? lsInfo(w) : null, id: w ? String(w.internalId) : ''});\n"
                     % js(tag))
    got = read_report(tag, 3.0) if kwin_script(body, "active") else None
    if got is None:
        return None
    w = got.get("window") or {}
    if not int(w.get("pid") or 0):
        return {}
    return {"id": got.get("id") or "", "pid": int(w["pid"]), "caption": w.get("caption", ""), "cls": w.get("cls", "")}


def cmd_active(as_json: bool = False) -> int:
    w = active_window()
    if w is None:
        return 3
    if not w:
        return 1
    print(json.dumps(w) if as_json else w["pid"])
    return 0


def refocus_window(window_id: str) -> str | None:
    tag = f"refocus-{os.getpid()}-{next(_script_seq)}"
    body = JS_LIB + (
        "var want = %s, a = workspace.activeWindow, ws = workspace.windowList(), w = null, how = 'gone';\n"
        "for (var i = 0; i < ws.length; i++) if (String(ws[i].internalId) === want) w = ws[i];\n"
        "if (w) {\n"
        "  if (a && String(a.internalId) === want) how = 'already';\n"
        "  else if (!lsOn(w, workspace.currentDesktop)) how = 'elsewhere';\n"
        "  else if (w.minimized) how = lsIsHubCaption(w.caption) ? 'hub-hidden' : 'minimized';\n"
        "  else { workspace.activeWindow = w; how = 'focused'; }\n"
        "}\n"
        "lsReport(%s, {how: how});\n" % (js(window_id), js(tag)))
    got = read_report(tag, 3.0) if kwin_script(body, "refocus") else None
    if got is None:
        return None
    how = str(got.get("how") or "gone")
    if how == "hub-hidden":
        st = hub_state()
        if hub_alive(st) and st.get("visible") is False:
            try:
                os.kill(int(st["pid"]), signal.SIGUSR1)
                how = "hub-shown"
            except (OSError, ValueError, KeyError):
                pass
    return how


STAY_NOT_HANDED_PREFIX = "claude-desks: --stay handed nothing back to his keyboard: "
STAY_HANDED_BACK = ("focused", "already", "hub-shown")
STAY_NOT_HANDED = {
    None: "KWin did not answer the refocus",
    "gone": "the window he had closed while the new one opened",
    "elsewhere": "the window it had is no longer on the user's desktop",
    "minimized": "the window he had was minimized",
    "hub-hidden": "the window he had is the hub, hidden, and it could not be shown again",
}


def stay_not_handed_back(how: str | None) -> str:
    if how in STAY_HANDED_BACK:
        return ""
    return STAY_NOT_HANDED_PREFIX + STAY_NOT_HANDED.get(how, f"the window he had could not be refocused ({how})")


def cmd_refocus(window_id: str) -> int:
    how = refocus_window(window_id)
    if how is None:
        return 3
    print(how)
    return 0 if how in ("focused", "already", "hub-shown") else 1


SWITCH_OK = "CLAUDE_HUB_DESKTOP_SWITCH_OK"
FOCUS_ELSEWHERE = 5


def claude_stays_home() -> bool:
    return bool(os.environ.get("CLAUDE_CODE_SESSION_ID")) and os.environ.get(SWITCH_OK) != "1"


def cmd_focus_caption(caption: str) -> int:
    tag = f"focus-{os.getpid()}-{next(_script_seq)}"
    body = JS_LIB + (
        "var w = lsWindow(0, %s), how = 'gone', number = 0, stay = %s;\n"
        "if (w) {\n"
        "  var ds = w.desktops;\n"
        "  if (lsOn(w, workspace.currentDesktop)) how = 'focused';\n"
        "  else if (stay) {\n"
        "    how = 'elsewhere';\n"
        "    var all = workspace.desktops;\n"
        "    for (var i = 0; ds.length && i < all.length; i++) if (all[i].id === ds[0].id) number = i + 1;\n"
        "  }\n"
        "  else { if (ds.length) workspace.currentDesktop = ds[0]; how = 'switched'; }\n"
        "  if (how !== 'elsewhere') {\n"
        "    if (w.minimized) w.minimized = false;\n"
        "    workspace.activeWindow = w;\n"
        "  }\n"
        "}\n"
        "lsReport(%s, {how: how, number: number});\n" % (js(caption), js(claude_stays_home()), js(tag)))
    got = read_report(tag, 3.0) if kwin_script(body, "focus") else None
    if got is None:
        return 3
    how = str(got.get("how") or "gone")
    if how == "elsewhere":
        number = got.get("number")
        print(f"elsewhere {number}" if isinstance(number, int) and not isinstance(number, bool) and number > 0
              else "elsewhere")
        return FOCUS_ELSEWHERE
    print(how)
    return 0 if how in ("focused", "switched") else 1


def own_desktop_only(target: dict, desktops: list[dict]) -> None:
    if not claude_stays_home():
        return
    me = find_me(read_registry())
    if me and me.get("desktop_id") == target["id"]:
        return
    own = next((d for d in desktops if me and d["id"] == me.get("desktop_id")), None)
    lift = f"When the user asked for this window on that desktop, run it again with {SWITCH_OK}=1."
    if own:
        raise Refused(f"a Claude puts windows only on its own desktop, and yours is desktop {own['number']}, not "
                      f"desktop {target['number']}. {lift}")
    raise Refused(f"a Claude puts windows only on its own desktop, and no desktop is known to be this one's, so "
                  f"not desktop {target['number']} either. {lift}")


PLACE_UNCONFIRMED = 6


def cmd_place(desktop: str, slot: str, caption: str, pid: int, confirm: bool = False, primary: bool = False) -> int:
    ds = need_desktops()
    d = resolve_desktop(desktop, ds)
    own_desktop_only(d, ds)
    info: dict = {}
    how = placed_window(d["id"], slot, pid=pid, caption=caption, primary=primary, info=info)
    if how == "refused":
        raise Refused("KWin would not run the placement script")
    if primary and "primary" in info:
        name = info["primary"]
        if not name:
            print("claude-desks: no primary screen that is not sticky could be read here (the screen order is not "
                  "known, or every screen in it is sticky); the window went to the screen he is watching",
                  file=sys.stderr)
    if how == "none":
        which = f"--pid {pid}" if pid else f"--caption {caption!r}"
        print(f"claude-desks: no window matched {which}: nothing was placed", file=sys.stderr)
        return 4
    if how == "unsaid" and confirm:
        print("claude-desks: the placement ran but no report came back, so it is not confirmed", file=sys.stderr)
        return PLACE_UNCONFIRMED
    return 0


def cmd_goto(target: str, focus: bool) -> int:
    ds = need_desktops()
    d = resolve_desktop(target, ds)
    e = next((x for x in read_registry() if x.get("desktop_id") == d["id"]), None)
    kp = int((e or {}).get("konsole_pid") or 0) if focus else 0
    cls = ""
    if focus and is_panel(d, ds):
        cls = PANEL_CLASS
    elif focus and is_aux(d, ds):
        cls = AUX_CLASS
    if not switch_to(d["id"], kp if pid_alive(kp) else 0, cls):
        raise Refused(f"KWin did not switch to desktop {d['number']}")
    return 0


DESK_UMASK = 0o002


def launch_konsole(title: str, command: list[str], env: dict, workdir: str = WORKDIR) -> int:
    env = {k: v for k, v in env.items() if k != "CLAUDE_CODE_SESSION_ID"}
    cmd = ["konsole", "--separate", "--workdir", workdir, "-p", f"tabtitle={safe_title(title)}", "-e", *command]
    if shutil.which("systemd-run", path=env.get("PATH")):
        cmd = ["systemd-run", "--user", "--scope", "--slice=app.slice", "-q", "--", *cmd]
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True, env=env, umask=DESK_UMASK)
    return proc.pid


def konsole_pid_of(pid: int, timeout: float = 3.0) -> int:
    end = time.monotonic() + timeout
    while True:
        if comm(pid) == "konsole":
            return pid
        for c in children_of(pid):
            if comm(c) == "konsole":
                return c
        if time.monotonic() > end or not pid_alive(pid):
            return pid
        time.sleep(0.05)


def wait_for_window(konsole_pid: int, timeout: float = WINDOW_WAIT) -> bool:
    end = time.monotonic() + timeout
    while time.monotonic() < end and pid_alive(konsole_pid):
        res = qdbus(f"org.kde.konsole-{konsole_pid}", timeout=2)
        if res and res.returncode == 0 and "/Windows/1" in res.stdout:
            return True
        time.sleep(0.1)
    return False


CLAUDE_DEFAULT_FLAGS = ("--dangerously-skip-permissions",) if os.environ.get("CLAUDE_HUB_SKIP_PERMISSIONS") == "1" else ()
MODEL_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._\[\]-]{0,59}")
EFFORTS = ("low", "medium", "high", "xhigh", "max")


CLAIM_NEW_JOIN = 1.0


def claim_new_konsole(did: str, desktops: list[dict] | None, pid: int) -> None:
    try:
        if pid > 0 and not is_his({"id": did}, desktops):
            send_claim({"id": did}, pid, "", "", WINDOW_WAIT, CLAIM_GRACE, time.time() + CLAIM_DEADLINE_S)
    except Exception:                               # noqa: BLE001 (Refused, a bad answer, a bus error)
        pass


def claim_new_konsole_later(did: str, desktops: list[dict] | None, pid: int) -> threading.Thread | None:
    thread = threading.Thread(target=claim_new_konsole, args=(did, desktops, pid), daemon=True, name="claim-konsole")
    try:
        thread.start()
    except Exception:                               # noqa: BLE001 (RuntimeError: can't start new thread)
        return None
    return thread


def finish_claims(threads: list[threading.Thread | None], wait: float = CLAIM_NEW_JOIN) -> None:
    end = time.monotonic() + wait
    for thread in threads:
        if thread is not None:
            thread.join(max(0.0, end - time.monotonic()))


def cmd_new(account: str, attach: str | None, stay: bool = False,
            model: str = "", effort: str = "", title_text: str = "", message: str = "") -> int:
    if account not in accounts():
        raise Refused(f"no such account: {account}")
    if paused(account) and not attach:
        raise Refused(f"{account} is paused")
    env = desktop_env()
    if on_hidden_screen(env):
        raise Refused("no desktop to open a window on (this is the hidden screen)")
    ds = need_desktops()
    title = title_text or f"claude · {time.strftime('%H:%M')}"
    session = None
    workdir = WORKDIR
    if attach:
        rows = agents(account)
        if rows is None:
            raise Refused(f"{account}'s session list did not answer")
        session = next((r for r in rows if r.get("kind") == "background" and r.get("status")
                        and attach in (r.get("id"), r.get("sessionId"))), None)
        if not session:
            raise Refused(f"no running background Claude {attach} under {account}")
        attach = session["id"]
        if session.get("name"):
            title = f"{session['name']} · {account}"
    with registry_lock():
        entries = read_registry()
        live_ids = {d["id"] for d in after_his(ds)}
        entry = None
        if session:
            entry = next((e for e in entries if e.get("session_id") == session.get("sessionId")
                          and e["desktop_id"] in live_ids), None)
        if entry is None:
            d = create_desktop(title)
            entry = {"desktop_id": d["id"], "number": d["number"], "name": title, "account": account,
                     "id": attach or "", "session_id": (session or {}).get("sessionId") or "",
                     "konsole_pid": 0, "created": int(time.time()), "kind": "window"}
            entries.append(entry)
            write_registry(entries)
    did = entry["desktop_id"]
    had, asked = "", True
    claim = stay
    if stay:
        was = active_window()
        asked = was is not None
        had = str((was or {}).get("id") or "")
    else:
        claim = not switch_to(did)
    first_file: Path | None = None
    if message:
        run_dir = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
        first_file = run_dir / f"claude-first-{os.getpid()}-{int(time.time())}.txt"
        first_file.touch(mode=0o600)
        first_file.write_text(message or "")
    if attach:
        command = [helper("claude-window"), "attach", account, attach]
    else:
        command = [helper("claude-window"), "new", account]
        if first_file:
            command += ["--first-message-file", str(first_file)]
        if model or effort:
            command += [*CLAUDE_DEFAULT_FLAGS, *(["--model", model] if model else []),
                        *(["--effort", effort] if effort else [])]
    try:
        launched = launch_konsole(title, command, env, workdir=workdir)
    except OSError:
        if first_file:
            first_file.unlink(missing_ok=True)
        raise
    claims = [claim_new_konsole_later(did, ds, launched)] if claim else []
    kp = konsole_pid_of(launched)
    if claim and kp != launched:
        claims.append(claim_new_konsole_later(did, ds, kp))
    update_entry(did, konsole_pid=kp)
    entry["konsole_pid"] = kp
    if wait_for_window(kp):
        time.sleep(0.3)
    place_window(did, "claude", pid=kp, focus=not stay)
    if had:
        said = stay_not_handed_back(refocus_window(had))
        if said:
            print(said, file=sys.stderr)
    elif stay:
        print("claude-desks: --stay found no focused window, so there was nothing to hand his keyboard back to"
              if asked else STAY_NOT_HANDED_PREFIX + "KWin did not say which window was focused", file=sys.stderr)
    finish_claims(claims)
    print(entry_line(with_live(entry, live_desktops(), None)))
    return 0


def adopt_candidates(snap, only: str | None) -> list[dict]:
    his = set(his_ids(snap.desktops))
    reg = [e for e in snap.registry if e["desktop_id"] not in his]
    known_sids = {sid for e in reg for sid in entry_ids(e)}
    known_konsoles = {int(e.get("konsole_pid") or 0) for e in reg}
    hub_kp = hub_konsole_pid()
    by_sid = {s["session_id"]: s for s in snap.sessions if s["session_id"]}
    found = []
    for sid, rec in snap.records.items():
        kp = record_pid(rec)
        s = by_sid.get(sid) or {}
        found.append({"kind": "window", "account": rec.get("account") or s.get("account") or "",
                      "id": rec.get("id") or s.get("id") or "", "session_id": sid, "konsole_pid": kp,
                      "name": s.get("name") or "", "started": s.get("started") or 0,
                      "resumed_from": resumed_from(rec), "lineage": merged_lineage(sid, rec.get("lineage"))})
    for s in snap.sessions:
        if s["kind"] == "plain":
            found.append({"kind": "plain", "account": s["account"], "id": "", "session_id": s["session_id"],
                          "konsole_pid": s["konsole_pid"], "pid": s["pid"], "name": s["name"],
                          "started": s["started"]})
    out, konsoles = [], set()
    for c in sorted(found, key=lambda c: (c["started"] or 0, c["account"], c["session_id"])):
        kp = c["konsole_pid"]
        if only and only not in (c["session_id"], c["id"]) and not c["session_id"].startswith(only):
            continue
        if not kp or not pid_alive(kp) or not is_konsole(kp) or kp == hub_kp or kp in konsoles:
            continue
        if (c["session_id"] in known_sids or kp in known_konsoles or c.get("resumed_from") in known_sids
                or known_sids.intersection(c.get("lineage") or ())):
            continue
        konsoles.add(kp)
        out.append(c)
    return out


def adopt_name(c: dict) -> str:
    return f"{c['name']} · {c['account']}" if c["name"] else f"claude · {c['account']}"


def adopt_plan(snap, only: str | None) -> tuple[list[dict], list[str]]:
    found = adopt_candidates(snap, only)
    if not found:
        return [], []
    counts = konsole_window_counts([c["konsole_pid"] for c in found])
    adoptable, skipped = [], []
    for c in found:
        kp = c["konsole_pid"]
        n = None if counts is None else counts.get(kp)
        if n == 1:
            adoptable.append(c)
        elif n is None:
            skipped.append(f"not adopted: KWin did not say how many windows Konsole {kp} has, so which one is "
                           f"this Claude's cannot be told")
        elif n == 0:
            skipped.append(f"not adopted: KWin lists no window for Konsole {kp}, so there is none to move")
        else:
            skipped.append(f"not adopted: Konsole {kp} has {n} windows; which one is this Claude's cannot be told")
    return adoptable, skipped


def say_not_adopted(skipped: list[str], as_json: bool) -> None:
    for line in skipped:
        print(line, file=sys.stderr if as_json else sys.stdout)


def cmd_adopt(only: str | None, goto: bool, as_json: bool, dry: bool = False) -> int:
    snap = gather()
    if snap.desktops is None:
        raise Refused("KWin is not answering on D-Bus (org.kde.KWin /VirtualDesktopManager)")
    found, skipped = adopt_plan(snap, only)
    if dry:
        if as_json:
            print(json.dumps([{**c, "desktop_name": adopt_name(c)} for c in found], indent=1, ensure_ascii=False))
        else:
            for n, c in enumerate(found, start=len(snap.desktops) + 1):
                print(f"would adopt {c['kind']} Claude {c['session_id'] or '?'} ({c['account']}): Konsole "
                      f"{c['konsole_pid']} → new desktop {n} \"{adopt_name(c)}\"")
            if not found and not skipped:
                print("nothing to adopt: every running Claude with a window already has a desktop")
        say_not_adopted(skipped, as_json)
        return 0
    made = []
    for c in found:
        name = adopt_name(c)
        with registry_lock():
            entries = read_registry()
            if any(int(e.get("konsole_pid") or 0) == c["konsole_pid"] for e in entries):
                continue
            d = create_desktop(name)
            entry = {"desktop_id": d["id"], "number": d["number"], "name": name, "account": c["account"],
                     "id": c["id"], "session_id": c["session_id"], "konsole_pid": c["konsole_pid"],
                     "created": int(time.time()), "kind": c["kind"]}
            if c["kind"] == "plain":
                entry["pid"] = c["pid"]
            lineage = merged_lineage(c["session_id"], c.get("lineage"))
            if lineage:
                entry["lineage"] = lineage
            entries.append(entry)
            write_registry(entries)
        place_window(d["id"], "claude", pid=c["konsole_pid"])
        made.append(entry)
    if goto and made:
        switch_to(made[-1]["desktop_id"], made[-1]["konsole_pid"])
    if as_json:
        print(json.dumps(made, indent=1, ensure_ascii=False))
    elif made:
        for e in made:
            print(f"adopted {e['name']} (Konsole {e['konsole_pid']}) → desktop {e['number']} {e['desktop_id']}")
    elif not skipped:
        print("nothing to adopt: every running Claude with a window already has a desktop")
    say_not_adopted(skipped, as_json)
    return 0



def claude_desktop(target: str, verb: str) -> tuple[dict | None, dict, list[dict]]:
    ds = need_desktops()
    entries = read_registry()
    try:
        d = resolve_desktop(target, ds)
    except Refused:
        arg = str(target or "").strip()
        live = {x["id"] for x in ds}
        gone = [e for e in entries if e["desktop_id"] not in live]
        hit = [e for e in gone if e["desktop_id"] == arg] or \
              [e for e in gone if len(arg) >= 6 and e["desktop_id"].startswith(arg)]
        if len(hit) == 1:
            return None, hit[0], ds
        raise
    if is_his(d, ds):
        raise Refused(f"{his_words(d, ds)} is yours; it is never {verb}")
    if is_panel(d, ds):
        raise Refused(f"desktop {d['number']} is the Panel desktop, no Claude's; it is never {verb}")
    if is_aux(d, ds):
        raise Refused(f"desktop {d['number']} is the Aux Desktop, no Claude's; it is never {verb} "
                      "(`aux-desktop close` puts it away)")
    e = next((x for x in entries if x.get("desktop_id") == d["id"]), None)
    if not e:
        raise Refused(f"desktop {d['number']} ({d['name']}) is not a Claude desktop made here")
    return d, e, ds


def drop_entry(desktop_id: str) -> None:
    with registry_lock():
        write_registry([x for x in read_registry() if x["desktop_id"] != desktop_id])


def session_listed(rows: list[dict], sid: str) -> bool:
    return any(isinstance(r, dict) and r.get("sessionId") == sid and r.get("status") and r.get("state") != "stopped"
               for r in rows)


CLAUDE_TIMEOUT = Path(__file__).resolve().parent / "claude-timeout"
CLAUDE_TIMEOUT_BACKSTOP = 55
CLAUDE_STOP_WAIT = 30


def claude_stop(account: str, short: str, sid: str) -> tuple[bool, str]:
    wrapper = str(CLAUDE_TIMEOUT)
    wrapped = os.path.isfile(wrapper) and os.access(wrapper, os.X_OK)
    try:
        res = subprocess.run(
            [wrapper, str(CLAUDE_STOP_WAIT), "--", "claude", "stop", short] if wrapped else ["claude", "stop", short],
            env=claude_env(account), capture_output=True, text=True, umask=DESK_UMASK,
            timeout=CLAUDE_STOP_WAIT + (CLAUDE_TIMEOUT_BACKSTOP if wrapped else 0))
    except Exception as err:                        # noqa: BLE001
        return False, f"Claude NOT stopped (claude stop: {err})"
    if wrapped and res.returncode == 124:
        err = subprocess.TimeoutExpired(["claude", "stop", short], CLAUDE_STOP_WAIT)
        return False, f"Claude NOT stopped (claude stop: {err})"
    if res.returncode == 0:
        return True, "Claude stopped"
    why = ((res.stderr or res.stdout).strip().splitlines() or ["it failed"])[-1]
    rows = agents(account) if sid else None
    if rows is not None and not session_listed(rows, sid):
        return True, "Claude stopped"
    return False, f"Claude NOT stopped (claude stop: {why})"


def watched_stop(rec: dict, e: dict) -> tuple[bool, str]:
    path = Path(rec["_path"]) if rec.get("_path") else None
    account = rec.get("account") or e.get("account") or ""
    short = rec.get("id") or e.get("id") or ""
    sid = rec.get("session_id") or e.get("session_id") or ""
    deadline = time.monotonic() + STOP_WAIT
    look_at_list = time.monotonic() + 1.0
    while path and time.monotonic() < deadline:
        try:
            now = json.loads(path.read_text())
        except FileNotFoundError:
            return True, "Claude stopped"
        except (OSError, ValueError):
            now = {}
        if isinstance(now, dict) and now.get("reopen"):
            break
        if time.monotonic() >= look_at_list:
            rows = agents(account) if sid else None
            if rows is not None and not session_listed(rows, sid):
                return True, "Claude stopped"
            look_at_list = time.monotonic() + 1.0
        time.sleep(0.1)
    if not short:
        return False, "Claude NOT stopped (its window's watcher did not, and its id is not known)"
    return claude_stop(account, short, sid)


def stop_claude(e: dict, snap, hangup_plain: bool) -> tuple[bool, str]:
    kp, sid = int(e.get("konsole_pid") or 0), e.get("session_id") or ""
    rec = (record_in_konsole(snap, kp) if pid_alive(kp) else None) or (snap.records.get(sid) if sid else None)
    wp = int((rec or {}).get("wrapper_pid") or 0)
    if wp and pid_alive(wp) and b"claude-window" in cmdline(wp):
        try:
            os.kill(wp, signal.SIGHUP)
        except OSError as err:
            return False, f"Claude NOT stopped (its window's process: {err.strerror})"
        return watched_stop(rec, e)
    s = session_of(e, snap)
    if s and s["kind"] == "plain":
        if hangup_plain:
            if not is_claude(s["pid"]):
                return False, "Claude NOT stopped (the pid its session list names is not a Claude)"
            try:
                os.kill(int(s["pid"]), signal.SIGHUP)
            except OSError as err:
                return False, f"Claude NOT stopped ({err.strerror})"
        return True, "Claude stopped"
    short = (s or {}).get("id") or ""
    if not short and e.get("kind") != "plain" and e.get("account") in snap.unread:
        short = e.get("id") or ""
    if not short:
        return True, "Claude already stopped"
    return claude_stop((s or {}).get("account") or e.get("account") or "", short, sid)


END_DETACHED_ENV = "CLAUDE_HUB_DESKTOP_END_DETACHED"
END_DETACH_DELAY = 5.0
END_LOGS = STATE_HOME / "desktop-end"


def ends_own_claude(e: dict, kp: int, rec: dict | None) -> bool:
    mine = set(ancestors(os.getpid()))
    own_sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    try:
        own_pid = int(os.environ.get("CLAUDE_PID") or 0)
    except ValueError:
        own_pid = 0
    if own_sid and own_pid and own_pid in mine:
        entries = [e if x.get("desktop_id") == e.get("desktop_id") else x for x in read_registry()]
        me = entry_for_session(entries, own_sid)
        if me is not None:
            return me.get("desktop_id") == e.get("desktop_id")
    wp = int((rec or {}).get("wrapper_pid") or 0)
    return bool((kp and kp in mine and is_konsole(kp))
                or (wp and wp in mine and b"claude-window" in cmdline(wp)))


def end_detached(did: str, sid: str) -> int:
    END_LOGS.mkdir(parents=True, exist_ok=True)
    log = END_LOGS / f"{time.time_ns()}-{did}.log"
    argv = [sys.executable, str(Path(__file__).resolve()), "end", did] + (["--session", sid] if sid else [])
    with open(log, "ab") as out:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, cwd=str(HOME),
                         env={**os.environ, END_DETACHED_ENV: "1"}, start_new_session=True, close_fds=True)
    for old in sorted(END_LOGS.glob("*.log"), key=lambda f: f.name)[:-50]:
        if old == log:
            continue
        try:
            old.unlink()
        except OSError:
            pass
    print(f"ending this Claude's own desktop: this Claude is stopped in {END_DETACH_DELAY:g} s, then its desktop "
          f"closes (what it did: {log})")
    return 0


def cmd_end(target: str, expect_session: str | None = None) -> int:
    detached = os.environ.pop(END_DETACHED_ENV, "") == "1"
    if detached:
        time.sleep(END_DETACH_DELAY)
    d, e, ds = claude_desktop(target, "ended")
    first = home_id(ds)
    snap = gather()
    follow(e, snap)
    if expect_session is not None and (e.get("session_id") or "") != expect_session:
        raise Refused("not ended: the Claude on that desktop is not the one you asked about any more "
                      "(its session changed); look again")
    sid, kp = e.get("session_id") or "", int(e.get("konsole_pid") or 0)
    rec = (record_in_konsole(snap, kp) if pid_alive(kp) else None) or (snap.records.get(sid) if sid else None)
    records = {RECORDS / f"{x}.json" for x in (sid, e.get("id")) if x}
    if rec and rec.get("_path"):
        records.add(Path(rec["_path"]))
    if not detached and ends_own_claude(e, kp, rec):
        return end_detached(d["id"] if d else e["desktop_id"], sid)
    ok, said = stop_claude(e, snap, hangup_plain=d is None)

    def forget() -> None:
        if ok:
            forget_records(sid, e, records)

    if d is None:
        drop_entry(e["desktop_id"])
        forget()
        print(f"ended {e.get('name') or e['desktop_id']} (its desktop was already gone): {said}")
        return 0 if ok else 1
    did = d["id"]
    update_entry(did, ending=time.time())
    if current_desktop() == did:
        switch_to(first)
    wp = int((rec or {}).get("wrapper_pid") or 0)
    if wp and kp and not pid_alive(wp):
        wait_pid_gone(kp, KONSOLE_GONE_WAIT)
    tag, hub_kp = f"end-{os.getpid()}-{time.monotonic_ns()}", hub_konsole_pid()
    kwin_script(script_close_on(did, tag, hub_kp), "end-close")
    closing = read_report(tag, 2.0)
    if closing is None:
        time.sleep(END_WAIT)
    elif closing.get("closing"):
        wait_closed(did, tag, hub_kp, END_WAIT)
    first = home_now(ds)
    kwin_script(script_move_leftovers(did, first, tag + "-left", hub_kp), "end-left")
    left = read_report(tag + "-left", 2.0)
    if current_desktop() == did:
        switch_to(first)
    moved = (left or {}).get("moved") or []
    if e.get("kind") == "plain" and any(m.get("pid") == kp for m in moved):
        ok, said = False, "Claude NOT stopped (its Konsole asked a question first)"
    with registry_lock():
        qdbus(*VDM, f"{VDM_IF}.removeDesktop", did)
        after = live_desktops()
        if after is None:
            raise Refused(f"KWin did not say whether desktop {d['number']} ({d['name']}) went — {said}, and its "
                          "windows were asked to close; nothing was forgotten, so its row stays")
        if any(x["id"] == did for x in after):
            raise Refused(f"KWin did not remove desktop {d['number']} ({d['name']}) — {said}, and its windows "
                          "were asked to close")
        write_registry([x for x in read_registry() if x["desktop_id"] != did])
    forget()
    line = f"ended desktop {d['number']} ({d['name']}): {said}"
    if closing is None or left is None:
        line += " (could not count the windows: the desktop service is not running)"
    else:
        refused = [m for m in moved if m.get("normal")]
        asked = refused or moved
        closed = max(0, len(closing.get("closing") or []) - len(refused))
        line += f", {closed} window{'' if closed == 1 else 's'} closed"
        if asked:
            line += (f", {len(asked)} moved to {home_words(after, first)} — "
                     f"{'it' if len(asked) == 1 else 'they'} asked a question")
    print(line)
    return 0 if ok else 1


def cmd_resume(target: str) -> int:
    d, e, ds = claude_desktop(target, "resumed")
    env = desktop_env()
    snap = gather()
    moved = follow(e, snap)
    status = entry_status(e, snap)
    kp, account = int(e.get("konsole_pid") or 0), e.get("account") or ""
    shown = pid_alive(kp) and bool(record_in_konsole(snap, kp) or plain_in_konsole(snap, kp))
    s = session_of(e, snap)
    command = None
    if starting_again(e):
        pass
    elif status == "unknown" and not pid_alive(kp):
        raise Refused(f"cannot tell whether {e.get('name') or 'its Claude'} runs ({account}'s session list "
                      "did not answer); try again")
    elif status == "running" and not shown and s and s["kind"] == "background" and not s.get("windowed"):
        command = [helper("claude-window"), "attach", s["account"], s["id"]]
    elif status == "gone" and paused(account):
        raise Refused(f"{account} is paused, so {e.get('name') or 'its Claude'} was not started "
                      "(it comes back when the pause is lifted)")
    elif status == "gone":
        command = ([helper("claude-window"), "resume", account,
                    usable_session(e, account, chain_sides(e, snap)[0])]
                   if e.get("session_id") else [helper("claude-window"), "new", account])
    if command and on_hidden_screen(env):
        raise Refused("no desktop to open a window on (this is the hidden screen)")
    fields, ended = {}, False
    with registry_lock():
        entries = read_registry()
        x = next((y for y in entries if y["desktop_id"] == e["desktop_id"]), None) or \
            next((y for y in entries if e.get("session_id") and y.get("session_id") == e["session_id"]), None)
        if x is None:
            raise Refused(f"{e.get('name') or 'that desktop'} was ended meanwhile")
        if starting_again(x):
            command, e, kp, moved = None, x, int(x.get("konsole_pid") or 0), 0
            d = next((y for y in live_desktops() or [] if y["id"] == x["desktop_id"]), d)
        else:
            if d is None:
                d = create_desktop(e.get("name") or "claude")
                fields.update(desktop_id=d["id"], number=d["number"])
            x.update(fields, konsole_pid=kp, account=e.get("account", ""), id=e.get("id", ""),
                     session_id=e.get("session_id", ""), kind=e.get("kind", "window"))
            lineage = merged_lineage(x["session_id"], e.get("lineage"), x.get("lineage"))
            if lineage:
                x["lineage"] = lineage
            else:
                x.pop("lineage", None)
            ended = "ending" in x
            for k in ("desktop_gone", "stopped_since", "ending") + (() if "pid" in e else ("pid",)):
                x.pop(k, None)
            if s and s.get("cwd"):
                x["cwd"] = s["cwd"]
            if command:
                x.update(resumed=time.time(), resumed_by=os.getpid(), kind="window")
                x.pop("pid", None)
            e = x
            write_registry(entries)
    if d is None:
        raise Refused(f"the desktop of {e.get('name') or 'that Claude'} is not there")
    did = d["id"]
    if not command:
        if pid_alive(kp) and (moved or fields or ended):
            place_window(did, "claude", pid=kp)
        if not switch_to(did, kp if pid_alive(kp) else 0):
            raise Refused(f"KWin did not switch to desktop {d['number']}")
        print(entry_line(with_live(e, live_desktops(), None)))
        return 0
    if pid_alive(kp) and not shown:
        kwin_script(script_close_left_window(did, kp, hub_konsole_pid()), "resume-close")
    cwd = e.get("cwd") or ""
    switch_to(did)
    kp = konsole_pid_of(launch_konsole(e.get("name") or d["name"], command, env,
                                       workdir=cwd if cwd and Path(cwd).is_dir() else WORKDIR))
    update_entry(did, konsole_pid=kp, resumed=time.time(), drop=("stopped_since", "ending"))
    e["konsole_pid"] = kp
    if wait_for_window(kp):
        time.sleep(0.3)
    place_window(did, "claude", pid=kp, focus=True)
    print(entry_line(with_live(e, live_desktops(), None)))
    return 0



TILER_SILENT = ("window tiling (Polonium) has not reported your screens in the last 5 seconds, so which are in "
                "front of you is unknown — try again in a moment")
TILER_UNSAID = "window tiling has not said which screens exist — marks take effect when it does"
NO_SCREENS = "window tiling reports no screens"
ALL_STICKY = "every screen is sticky: nothing switches desktops"


def screen_word(name: str) -> str:
    return SCREEN_WORDS.get(name, name)


def resolve_screen(arg, known=()) -> str:
    typed = " ".join(str(arg or "").split())
    low = typed.lower()
    if low in SCREEN_SHORT:
        return SCREEN_SHORT[low]
    for connector, word in SCREEN_WORDS.items():
        if low in (connector.lower(), word.lower()):
            return connector
    for connector in known:
        if low == str(connector).lower():
            return connector
    return typed


def connector_order(names) -> list[str]:
    def key(name: str) -> list:
        return [int(t) if i % 2 else t.lower() for i, t in enumerate(re.split(r"(\d+)", name))]
    return sorted(dict.fromkeys(names), key=key)


def screens_in_front(names) -> list[str]:
    present = [n for n in dict.fromkeys(names) if isinstance(n, str) and n]
    return [n for n in LAPTOP_SCREENS if n in present] or \
        connector_order(n for n in present if n not in LAPTOP_SCREENS)


def load_sticky() -> list[str] | None:
    try:
        data = json.loads(STICKY_FILE.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError, RecursionError):
        return None
    marks = data.get("sticky") if isinstance(data, dict) else None
    if not isinstance(marks, list):
        return None
    return list(dict.fromkeys(m for m in marks if isinstance(m, str) and m))


def read_sticky() -> list[str]:
    return load_sticky() or []


@contextmanager
def sticky_lock():
    STICKY_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(STICKY_FILE.with_name(STICKY_FILE.name + ".lock"), "a+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def write_sticky(marks: list[str]) -> None:
    STICKY_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STICKY_FILE.with_name(f".{STICKY_FILE.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps({"sticky": marks, "changed": time.time()}, ensure_ascii=False) + "\n")
        os.replace(tmp, STICKY_FILE)
    except OSError:
        tmp.unlink(missing_ok=True)
        raise


def read_hub_rows() -> dict | None:
    try:
        data = json.loads(HUB_ROWS.read_text())
    except (OSError, ValueError, RecursionError):
        return None
    return data if isinstance(data, dict) else None


def screens_known(data) -> bool:
    if not isinstance(data, dict) or not isinstance(data.get("screens"), list):
        return False
    at = data.get("screens_at")
    return isinstance(at, (int, float)) and not isinstance(at, bool) and recent(at, SCREENS_FRESH_FOR)


def front_names(data) -> list[str] | None:
    if not screens_known(data):
        return None
    names = (s.get("name") for s in data["screens"] if isinstance(s, dict))
    return list(dict.fromkeys(n for n in names if isinstance(n, str) and n))


def sticky_screens(data) -> list[dict]:
    names = front_names(data)
    if not names:
        return []
    marks = read_sticky()
    return [{"name": n, "word": screen_word(n), "sticky": n in marks} for n in names]


def marked_screens(marks=None) -> list[dict]:
    return [{"word": screen_word(m), "sticky": True} for m in (read_sticky() if marks is None else marks)]


def all_sticky(screens) -> bool:
    return bool(screens) and all(s.get("sticky") for s in screens)


def hub_screens(reported, at, marks=None) -> list[dict]:
    if not reported or not recent(at, SCREENS_FRESH_FOR):
        return []
    marks = read_sticky() if marks is None else marks
    names = screens_in_front(s.get("name") for s in reported if isinstance(s, dict))
    return [{"name": n, "word": screen_word(n), "sticky": n in marks} for n in names]


def set_sticky(name: str, on: bool, data=None) -> list[dict]:
    data = read_hub_rows() if data is None else data
    front = front_names(data)
    typed = " ".join(str(name or "").split())

    def not_a_screen() -> ScreenRefused:
        words = ", ".join(screen_word(n) for n in front or []) or "none"
        if not typed:
            return ScreenRefused(f"name a screen: {words}")
        return ScreenRefused(f"{typed} is not a screen in front of you: {words}")

    try:
        with sticky_lock():
            loaded = load_sticky()
            marks = loaded or []
            key = resolve_screen(typed, (front or []) + marks)
            if on:
                if front is None:
                    raise TilerSilent(TILER_SILENT)
                if key not in front:
                    raise not_a_screen()
                if key not in marks and all(n == key or n in marks for n in front):
                    raise ScreenRefused("at least one screen has to switch desktops")
                new = marks if key in marks else marks + [key]
            else:
                if key not in marks:
                    if front is None:
                        raise TilerSilent(TILER_SILENT)
                    if key not in front:
                        raise not_a_screen()
                new = [m for m in marks if m != key]
            if new != marks or loaded is None:
                write_sticky(new)
    except OSError as err:
        raise Refused(f"could not write {STICKY_FILE}: {err.strerror or err}")
    return sticky_screens(data)


def cmd_sticky(screen: str | None, on: bool | None, as_json: bool) -> int:
    if screen is not None:
        set_sticky(screen, bool(on))
    data = read_hub_rows()
    known, screens, marks = screens_known(data), sticky_screens(data), read_sticky()
    if as_json:
        at = data.get("screens_at") if isinstance(data, dict) else None
        print(json.dumps({"screens": screens, "known": known, "marked": marks, "screens_at": at},
                         ensure_ascii=False))
        return 0
    if not known:
        print(TILER_UNSAID)
        screens = marked_screens(marks)
    elif not screens:
        print(NO_SCREENS)
    for s in screens:
        print(f"{s['word']:<24} {'sticky' if s['sticky'] else 'switches'}")
    if known and all_sticky(screens):
        print(ALL_STICKY)
    return 0


def tiler_screens(text) -> list[dict] | None:
    try:
        data = json.loads(text)
    except (TypeError, ValueError, RecursionError):
        return None
    return screens_of(data)


def screens_of(data) -> list[dict] | None:
    if not isinstance(data, list):
        return None
    found: dict[str, dict] = {}
    for s in data:
        name = s.get("name") if isinstance(s, dict) else None
        if isinstance(name, str) and name and name not in found:
            found[name] = {"name": name, **{k: s[k] for k in ("x", "y", "width", "height")
                                            if isinstance(s.get(k), (int, float)) and not isinstance(s[k], bool)}}
    return list(found.values()) if found or not data else None


def sticky_marks(state: dict) -> list[str] | None:
    marks = load_sticky()
    if marks is None:
        last = state.get("sticky_last")
        return None if last is None else list(last)
    state["sticky_last"] = marks
    return list(marks)


def sticky_call(text) -> tuple[list[dict] | None, object]:
    try:
        data = json.loads(text)
    except (TypeError, ValueError, RecursionError):
        return None, None
    if isinstance(data, dict):
        return screens_of(data.get("screens")), data.get("released")
    return screens_of(data), None


def sticky_extras(desktops: list[dict] | None) -> dict:
    state = main_state()
    mains = wire_mains(desktops, state)
    if mains is None:
        return {}
    extras: dict = {"mains": mains}
    if desktops:
        home = home_id(desktops, state)
    else:
        home = state["home"] if state["home"] and state["home"] != state["closing"] else ""
    if home:
        extras["home"] = home
    extras["closing"] = state["closing"]
    if state["closing"]:
        extras["released"] = state.get("released")
    return extras


def note_released(state: dict, released) -> None:
    if not isinstance(released, str) or not released:
        return
    try:
        if main_state().get("closing") != released or main_state().get("released") == released:
            return
        with main_lock(wait=False) as got:
            if not got:
                return
            held = main_state()
            if held["closing"] != released or held.get("released") == released:
                return
            held["released"] = released
            write_main_state(held)
    except Exception as err:                        # noqa: BLE001 — Sticky never answers with an error
        said = f"Sticky could not store released {released}: {err}"
        if state.get("released_said") != said:
            state["released_said"] = said
            print(f"claude-desks watch: {said}", file=sys.stderr, flush=True)
        return
    state.pop("released_said", None)


def sticky_payload(marks: list[str] | None, extras: dict | None = None) -> str:
    return "" if marks is None else json.dumps({"sticky": marks, **(extras or {})})


def sticky_answer(state: dict, lock, text, now: float | None = None) -> str:
    now = time.time() if now is None else now
    screens, released = sticky_call(text)
    if screens is not None:
        with lock:
            state["screens"], state["screens_at"] = screens, now
    note_released(state, released)
    return sticky_payload(sticky_marks(state), sticky_extras(state.get("desktops")))


def sticky_reply(state: dict, lock, text) -> str:
    try:
        answer = sticky_answer(state, lock, str(text))
    except Exception as err:                        # noqa: BLE001
        said = f"Sticky failed: {err}"
        if state.get("sticky_said") != said:
            state["sticky_said"] = said
            print(f"claude-desks watch: {said}", file=sys.stderr, flush=True)
        last = state.get("sticky_last")
        try:
            extras = sticky_extras(state.get("desktops"))
        except Exception:                                      # noqa: BLE001  "the close is over"
            extras = {}
        return sticky_payload(None if last is None else list(last), extras)
    state.pop("sticky_said", None)
    return answer



def write_rows(snap) -> dict:
    screens, screens_at = getattr(snap, "screens", None), getattr(snap, "screens_at", None)
    panel = panel_of(snap.desktops)
    aux = aux_of(snap.desktops)
    data = {"at": snap.at, "current": snap.current, "kwin": snap.desktops is not None,
            "unread": sorted(snap.unread), "rows": rows(snap, panel, aux),
            "screens": hub_screens(screens, screens_at), "screens_at": screens_at,
            "panel_at": panel_position(snap.desktops, panel),
            "panel_id": panel["id"] if panel else "",
            "aux_at": aux_position(snap.desktops, aux) or 0,
            "aux_id": aux["id"] if aux else ""}
    HUB_ROWS.parent.mkdir(parents=True, exist_ok=True)
    tmp = HUB_ROWS.with_name(f".{HUB_ROWS.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False))
    os.replace(tmp, HUB_ROWS)
    return data


def write_report(tag: str, payload: str) -> bool:
    if not REPORT_TAG.fullmatch(tag or "") or len(payload.encode()) > REPORT_MAX:
        return False
    REPORTS.mkdir(parents=True, exist_ok=True)
    tmp = REPORTS / f".{tag}.{os.getpid()}.tmp"
    tmp.write_text(payload)
    os.replace(tmp, REPORTS / f"{tag}.json")
    return True


def prune_reports(older_than: float = 120.0) -> None:
    now = time.time()
    for p in REPORTS.glob("*.json") if REPORTS.is_dir() else []:
        try:
            if now - p.stat().st_mtime > older_than:
                p.unlink()
        except OSError:
            pass


def name_claudes(snap) -> None:
    if not TITLES:
        return
    try:
        TITLES.tick(snap.sessions)
    except Exception as err:                        # noqa: BLE001 — a name never breaks a look
        print(f"claude-desks watch: naming failed: {err}", file=sys.stderr, flush=True)


def look(snap, fresh: bool) -> dict:
    synced = False
    try:
        panel_refresh(snap.desktops)
    except Exception as err:                        # noqa: BLE001 — hub.json is still written; the next look tries again
        print(f"claude-desks watch: keeping the Panel desktop's state failed: {err}", file=sys.stderr, flush=True)
    try:
        if panel_keep(snap.desktops):
            snap.desktops = live_desktops() or snap.desktops
    except Exception as err:                        # noqa: BLE001 — hub.json is still written; the next look tries again
        print(f"claude-desks watch: keeping the Panel desktop failed: {err}", file=sys.stderr, flush=True)
    try:
        keep_home(snap)
    except Exception as err:                        # noqa: BLE001 — hub.json is still written; the next look tries again
        print(f"claude-desks watch: remembering home (the Main Desktop he is on) failed: {err}",
              file=sys.stderr, flush=True)
    try:
        drop_dead_closing()
    except Exception as err:                        # noqa: BLE001 — hub.json is still written; the next look tries again
        print(f"claude-desks watch: clearing the mark of a close that ended failed: {err}", file=sys.stderr, flush=True)
    if fresh and snap.accounts:
        name_claudes(snap)
    if fresh and snap.accounts and snap.desktops:
        notes = sync(snap)
        for note in notes:
            print(f"claude-desks watch: {note}", file=sys.stderr, flush=True)
        if notes:
            snap.desktops = live_desktops() or snap.desktops
        snap.registry = read_registry()
        synced = True
    if not synced:
        try:
            keep_identity(snap)
        except Exception as err:                    # noqa: BLE001 — hub.json is still written; the next look tries again
            print(f"claude-desks watch: keeping identities failed: {err}", file=sys.stderr, flush=True)
    return write_rows(snap)


CLAIM_TTL = 15.0
CLAIM_TTL_MAX = 60.0
CLAIM_GRACE = 10.0
CLAIM_POLL_HOLD = 15.0
CLAIM_ACK_WAIT = 1.0
CLAIM_DEADLINE_S = 2.5
CLAIM_MAX = 32
CLAIM_CLASS = re.compile(r"[A-Za-z0-9._-]{1,64}")


def refuse_special_claim(d: dict, desktops: list[dict], cls: str) -> None:
    kind = special_kind(d, desktops)
    if kind is not None and cls != SPECIAL_DESKTOPS[kind]["class"]:
        spec = SPECIAL_DESKTOPS[kind]
        raise Refused(f"desktop {d['number']} is the {spec['label']}: only a window of the app {spec['class']} "
                      "is claimed for it")


def refuse_panel_claim(d: dict, desktops: list[dict], cls: str) -> None:
    refuse_special_claim(d, desktops, cls)


def claim_needs_read(raw: str, cached: list[dict] | None) -> bool:
    try:
        wanted = json.loads(raw).get("desktop")
    except (ValueError, AttributeError):
        return False
    return not (cached and any(d["id"] == wanted for d in cached))


def claim_desktops(raw: str, cached: list[dict] | None) -> list[dict] | None:
    if not claim_needs_read(raw, cached):
        return cached
    return live_desktops() or cached


def parse_claim(raw: str, desktops: list[dict] | None) -> dict:
    try:
        c = json.loads(raw)
    except ValueError:
        raise Refused("a claim is JSON")
    if not isinstance(c, dict):
        raise Refused("a claim is a JSON object")
    desktop = str(c.get("desktop") or "")
    pid = c.get("pid") or 0
    cls = str(c.get("cls") or "")
    marker = str(c.get("marker") or "")
    if not isinstance(pid, int) or pid < 0:
        raise Refused("pid is a number")
    if not pid and not cls:
        raise Refused("say which window: a pid or a class")
    if pid and cls:
        raise Refused("a pid or a class, not both: a class beside a pid would take any window of that app")
    if cls and not CLAIM_CLASS.fullmatch(cls):
        raise Refused(f"not a window class: {cls[:80]!r}")
    if cls and not marker:
        raise Refused("a claim by class needs a marker (text the window's title will show)")
    if len(marker) > 200:
        raise Refused("the marker is at most 200 characters")
    if not desktops:
        raise Refused("the desktops are not known yet, so no claim can be checked; try again in a moment")
    d = next((x for x in desktops if x["id"] == desktop), None)
    if d is None:
        raise Refused(f"no desktop has the id {desktop!r}")
    if is_his(d, desktops):
        raise Refused(f"{his_words(d, desktops)} is his: nothing is claimed for it")
    refuse_panel_claim(d, desktops, cls)
    try:
        ttl = float(c.get("ttl") or CLAIM_TTL)
        grace = float(c.get("grace") or CLAIM_GRACE)
    except (TypeError, ValueError, OverflowError):
        raise Refused("ttl and grace are seconds")
    if not (math.isfinite(ttl) and math.isfinite(grace)):
        raise Refused("ttl and grace are seconds")
    ttl = min(max(ttl, 1.0), CLAIM_TTL_MAX)
    grace = min(max(grace, 1.0), 30.0)
    claim = {"desktop": desktop, "pid": pid, "cls": cls, "marker": marker,
             "ttl": ttl, "grace": int(grace * 1000)}
    deadline = c.get("deadline")
    if deadline is not None:
        try:
            a_time = (not isinstance(deadline, bool) and isinstance(deadline, (int, float))
                      and math.isfinite(deadline))
        except OverflowError:
            a_time = False
        if not a_time:
            raise Refused("deadline is a time in seconds since 1970")
        claim["deadline"] = float(deadline)
    return claim


def claim_reply(claim: dict, cid: str | None, seen, now: float) -> tuple[str, bool]:
    deadline = claim.get("deadline")
    if deadline is not None and now > deadline:
        return json.dumps({"error": "late"}), True
    return json.dumps({"id": cid, "seen": bool(seen)}), False


def late_claim_line(claim: dict, now: float, arrived: bool) -> str:
    who = f"pid {text_line(claim.get('pid'), 10)}" if claim.get("pid") else f"class {text_line(claim.get('cls'), 40)}"
    try:
        ms = str(max(0, int(round((now - float(claim["deadline"])) * 1000))))
    except (KeyError, TypeError, ValueError, OverflowError):
        ms = "?"
    return ("claude-desks watch: no claim is kept for %s on desktop %s: it %s %s ms after its deadline"
            % (who, text_line(claim.get("desktop"), 40).lstrip("{")[:8],
               "arrived" if arrived else "could only be answered", ms))


class ClaimBook:

    def __init__(self, clock=time.time, mains=None):
        self.clock = clock
        self.version = int(clock() * 1000) % (2 ** 31 - 1)
        self.claims: list[dict] = []
        self.polls: list = []
        self.acks: list = []
        self.seen = -1
        self.seq = itertools.count(1)
        self.mains_source = mains
        self.mains: list[str] | None = None
        self.mains_said = ""
        self.mains = self.read_mains()

    def read_mains(self) -> list[str] | None:
        if self.mains_source is None:
            return None
        try:
            return self.mains_source()
        except Exception as err:                    # noqa: BLE001 — a poll is never refused for this
            said = f"Claims could not read his desktops: {err}"
            if self.mains_said != said:
                self.mains_said = said
                print(f"claude-desks watch: {said}", file=sys.stderr, flush=True)
            return self.mains

    def refresh_mains(self) -> bool:
        if self.mains_source is None:
            return False
        now = self.read_mains()
        if now == self.mains:
            return False
        self.mains = now
        self.changed()
        return True

    def payload(self) -> str:
        body: dict = {"version": self.version, "claims": self.claims}
        if self.mains is not None:
            body["mains"] = self.mains
        return json.dumps(body)

    def prune(self) -> bool:
        now = self.clock() * 1000
        keep = [c for c in self.claims if c["until"] > now]
        if len(keep) == len(self.claims):
            return False
        self.claims = keep
        return True

    def changed(self) -> None:
        self.version = (self.version + 1) % (2 ** 31 - 1)
        polls, self.polls = self.polls, []
        for reply in polls:
            reply(self.payload())

    def poll(self, version: int, reply) -> None:
        if self.prune():
            self.changed()
        self.refresh_mains()
        if version == self.version:
            self.seen = version
            waiting, self.acks = self.acks, []
            live = {c["id"] for c in self.claims}
            for _, ack, cid in waiting:
                ack(cid in live)
            self.polls.append(reply)
        else:
            reply(self.payload())

    def release(self, reply) -> None:
        if reply in self.polls:
            self.polls.remove(reply)
            reply(self.payload())

    def add(self, claim: dict, ack) -> str:
        deadline = claim.get("deadline")
        if deadline is not None and self.clock() > deadline:
            raise Refused("late")
        if self.prune():
            self.changed()
        if len(self.claims) >= CLAIM_MAX:
            raise Refused(f"{CLAIM_MAX} windows are already claimed")
        cid = f"c{os.getpid()}-{next(self.seq)}"
        entry = {k: v for k, v in claim.items() if k not in ("ttl", "deadline")}
        entry.update(id=cid, until=int((self.clock() + float(claim.get("ttl") or CLAIM_TTL)) * 1000))
        self.claims.append(entry)
        self.changed()
        self.acks.append((self.version, ack, cid))
        return cid

    def unack(self, ack) -> None:
        for item in list(self.acks):
            if item[1] is ack:
                self.acks.remove(item)
                ack(False)

    def drop(self, cid: str) -> bool:
        before = len(self.claims)
        self.claims = [c for c in self.claims if c["id"] != cid]
        if len(self.claims) != before:
            self.changed()
            return True
        return False


def spawn_thread(fn) -> None:
    threading.Thread(target=fn, daemon=True).start()


def serve_claim(raw: str, cached: list[dict] | None, claims: ClaimBook, reply, idle, later,
                spawn=spawn_thread) -> None:
    done = [False]

    def answer(text: str) -> None:
        if not done[0]:
            done[0] = True
            reply(text)

    def register(desktops: list[dict] | None) -> None:
        try:
            claim = parse_claim(raw, desktops)
        except Refused as err:
            answer(json.dumps({"error": str(err)}))
            return
        got = {}

        def ack(seen):
            if "seen" not in got:
                got["seen"] = seen
                at = time.time()
                text, drop = claim_reply(claim, got.get("id"), seen, at)
                answer(text)
                if drop and got.get("id"):
                    cid = got["id"]
                    idle(lambda: (claims.drop(cid), False)[1])
                if drop:
                    try:
                        print(late_claim_line(claim, at, arrived=False), flush=True)
                    except Exception:               # noqa: BLE001
                        pass
        try:
            got["id"] = claims.add(claim, ack)
        except Refused as err:
            answer(json.dumps({"error": str(err)}))
            if str(err) == "late":
                try:
                    print(late_claim_line(claim, time.time(), arrived=True), flush=True)
                except Exception:                   # noqa: BLE001
                    pass
            return
        if "seen" not in got:
            later(int(CLAIM_ACK_WAIT * 1000), lambda: (claims.unack(ack), False)[1])

    def run(desktops: list[dict] | None) -> bool:
        try:
            register(desktops)
        except Exception as err:                    # noqa: BLE001, answered, never left to a 5 s timeout
            print(f"claude-desks watch: Claim failed: {err}", file=sys.stderr, flush=True)
            answer(json.dumps({"error": f"the claim could not be handled: {text_line(err, 120)}"}))
        return False

    if not claim_needs_read(raw, cached):
        run(cached)
        return

    def read() -> None:
        try:
            fresh = claim_desktops(raw, cached)
        except Exception as err:                    # noqa: BLE001
            print(f"claude-desks watch: Claim's read of KWin failed: {err}", file=sys.stderr, flush=True)
            fresh = cached
        try:
            idle(lambda: run(fresh))
        except Exception as err:                    # noqa: BLE001, nothing left to answer it with: the caller times out
            print(f"claude-desks watch: Claim could not go back to the main loop: {err}", file=sys.stderr,
                  flush=True)
    try:
        spawn(read)
    except Exception as err:                        # noqa: BLE001 (RuntimeError: can't start new thread)
        print(f"claude-desks watch: Claim could not start its read: {err}", file=sys.stderr, flush=True)
        run(cached)


def claim_deadline() -> float:
    age = process_age(os.getpid())
    return time.time() - (age if age is not None else 0.0) + CLAIM_DEADLINE_S


def send_claim(d: dict, pid: int, cls: str, marker: str, ttl: float, grace: float, when: float) -> tuple[dict, int]:
    raw = json.dumps({"desktop": d["id"], "pid": pid, "cls": cls, "marker": marker, "ttl": ttl, "grace": grace,
                      "deadline": when})
    out = qdbus(BUS_NAME, BUS_PATH, f"{BUS_NAME}.Claim", raw, timeout=5.0)
    if not out or out.returncode != 0:
        why = (out.stderr.strip().splitlines() or [""])[-1] if out else "no answer"
        return {"id": None, "seen": False, "error": why[:200]}, 3
    try:
        got = json.loads(out.stdout)
    except ValueError:
        got = {}
    if got.get("error") == "late":
        raise Refused("the claim reached the desktop service after its deadline (2.5 s after this command started "
                      "unless --deadline says another time), so it holds nothing: the window opens where it opens")
    if got.get("error"):
        raise Refused(str(got["error"]))
    return {"id": got.get("id"), "seen": bool(got.get("seen"))}, 0 if got.get("seen") else 3


def cmd_claim(desktop: str, pid: int, cls: str, marker: str, ttl: float, grace: float = CLAIM_GRACE,
              deadline: float | None = None) -> int:
    ds = need_desktops()
    d = resolve_desktop(desktop, ds)
    if is_his(d, ds):
        raise Refused(f"{his_words(d, ds)} is his: nothing is claimed for it")
    refuse_panel_claim(d, ds, cls)
    own_desktop_only(d, ds)
    when = claim_deadline() if deadline is None else deadline
    got, code = send_claim(d, pid, cls, marker, ttl, grace, when)
    print(json.dumps(got))
    return code


def cmd_unclaim(cid: str) -> int:
    out = qdbus(BUS_NAME, BUS_PATH, f"{BUS_NAME}.Unclaim", cid, timeout=5.0)
    return 0 if out and out.returncode == 0 and out.stdout.strip() == "true" else 1


OWNER_NEVER = ("wl-clipboard", "firefox")
OWNER_SESSION = re.compile(r"[A-Za-z0-9._-]{1,128}")
OWNER_WALK_MAX = 64
OWNER_DETACHED_PARENT = "systemd"
READ_MAX = 1 << 20


def stat_start_ticks(text: str) -> int | None:
    i = str(text).rfind(")")
    if i < 0:
        return None
    try:
        return int(str(text)[i + 1:].split()[19])
    except (ValueError, IndexError):
        return None


def process_age(pid) -> float | None:
    try:
        with open(f"/proc/{int(pid)}/stat", "rb") as fh:
            ticks = stat_start_ticks(fh.read(READ_MAX).decode("utf-8", "replace"))
        with open("/proc/uptime", "rb") as fh:
            up = float(fh.read(256).split()[0])
        hz = os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, TypeError, OverflowError):
        return None
    if ticks is None or hz <= 0:
        return None
    return max(0.0, up - ticks / hz)


def process_session_id(pid: int) -> str:
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as fh:
            raw = fh.read(READ_MAX)
    except (OSError, ValueError, TypeError, OverflowError):
        return ""
    key = b"CLAUDE_CODE_SESSION_ID="
    for item in raw.split(b"\0"):
        if item.startswith(key):
            sid = item[len(key):].decode("utf-8", "replace")
            return sid if OWNER_SESSION.fullmatch(sid) else ""
    return ""


def attached_to_claude(pid: int, sid: str) -> bool:
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1 or not isinstance(sid, str) or not sid:
        return False
    cur = pid
    for _ in range(OWNER_WALK_MAX):
        parent = parent_of(cur)
        if not isinstance(parent, int) or parent <= 1:
            return False
        if process_session_id(parent) == sid:
            cur = parent
            continue
        name = comm(parent)
        return bool(name) and name != OWNER_DETACHED_PARENT
    return False


def window_owner(pid, cls, caption, entries: list[dict] | None = None) -> dict:
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return {}
    entries = read_registry() if entries is None else entries
    cls = str(cls or "").lower()
    special = {x for x in (panel_file_id(), aux_file_id(), *main_state()["ids"]) if x}
    if any(never in cls for never in OWNER_NEVER) or pid in claude_konsole_pids(entries):
        return {}
    sid = process_session_id(pid)
    e = entry_for_session(entries, sid)
    if not (e and e.get("desktop_id")) or e["desktop_id"] in special or not attached_to_claude(pid, sid):
        return {}
    return {"desktop": e["desktop_id"], "session": sid[:8], "how": "env"}


def text_line(value, limit: int) -> str:
    return "".join(c for c in str(value) if c.isprintable())[:limit]


def sent_line(raw) -> str:
    try:
        p = json.loads(str(raw))
        if not isinstance(p, dict):
            raise ValueError("not an object")
        ms = p.get("ms")
        ms = str(int(ms)) if isinstance(ms, (int, float)) and not isinstance(ms, bool) else "?"
        if p.get("left") == "late":
            return ('claude-desks watch: left the window of pid %s (%s) "%s" on your desktop: the answer came %s ms '
                    'after it opened (it was for desktop %s, session %s, by %s)'
                    % (text_line(p.get("pid"), 10), text_line(p.get("cls"), 40), text_line(p.get("caption"), 60), ms,
                       text_line(p.get("desktop"), 40).lstrip("{")[:8], text_line(p.get("session"), 8) or "unknown",
                       text_line(p.get("how"), 8)))
        return ('claude-desks watch: sent the window of pid %s (%s) "%s" home to desktop %s '
                '(session %s, by %s, %s ms after it opened)'
                % (text_line(p.get("pid"), 10), text_line(p.get("cls"), 40), text_line(p.get("caption"), 60),
                   text_line(p.get("desktop"), 40).lstrip("{")[:8], text_line(p.get("session"), 8) or "unknown",
                   text_line(p.get("how"), 8), ms))
    except Exception:                               # noqa: BLE001
        return f"claude-desks watch: sent a window home (the note could not be read: {text_line(raw, 60)!r})"


def cmd_watch(once: bool) -> int:
    if once:
        look(gather(), fresh=True)
        return 0
    try:
        import dbus
        import dbus.mainloop.glib
        import dbus.service
        from gi.repository import GLib
    except ImportError as err:
        raise Refused(f"the desktop service needs dbus-python and PyGObject ({err})")
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    try:
        drop_dead_closing()
    except Exception as err:                        # noqa: BLE001 — the first look tries again
        print(f"claude-desks watch: clearing the mark of a close that ended failed: {err}", file=sys.stderr, flush=True)
    lock, wake = threading.Lock(), threading.Event()
    state = {"sweep": None, "fresh": False, "sweeping": False, "want": True, "swept": 0.0,
             "screens": None, "screens_at": None}
    claims = ClaimBook(mains=lambda: claims_mains(state.get("desktops")))

    def sweeper(forced: bool = False) -> None:
        result = None
        try:
            result = sweep_agents(poked=forced, from_files=True)
            write_agents_snapshot(result)
        except Exception as err:                    # noqa: BLE001
            print(f"claude-desks watch: a sweep failed: {err}", file=sys.stderr, flush=True)
        finally:
            with lock:
                if result is not None:
                    state.update(sweep=result, fresh=True)
                state["sweeping"] = False
            wake.set()

    def ticker() -> None:
        use_kwin_link()
        while True:
            t0 = time.monotonic()
            try:
                every = SWEEP if hub_visible() else max(SWEEP, SWEEP_HIDDEN)
                with lock:
                    due = not state["sweeping"] and (state["want"] or t0 - state["swept"] >= every)
                    forced = state["want"]
                    if due:
                        state.update(want=False, sweeping=True, swept=t0)
                    fresh, sweep = state["fresh"], state["sweep"]
                    state["fresh"] = False
                if due:
                    try:
                        threading.Thread(target=sweeper, args=(forced,), daemon=True).start()
                    except RuntimeError:
                        with lock:
                            state["sweeping"] = False
                        raise
                snap = gather(sweep=sweep if sweep is not None else {})
                with lock:
                    snap.screens, snap.screens_at = state["screens"], state["screens_at"]
                state["desktops"] = snap.desktops or state.get("desktops")
                GLib.idle_add(lambda: (claims.refresh_mains(), False)[1])
                look(snap, fresh)
                prune_reports()
            except Exception as err:                # noqa: BLE001 — the service must keep looking
                print(f"claude-desks watch: a look failed: {err}", file=sys.stderr, flush=True)
            wake.wait(max(0.05, REFRESH - (time.monotonic() - t0)))
            wake.clear()

    class Desktops(dbus.service.Object):
        @dbus.service.method(BUS_NAME, in_signature="i", out_signature="s",
                             async_callbacks=("reply", "error"))
        def ClaudeWindow(self, pid, reply, error):  # noqa: ARG001 (error: a failure answers "")
            def answer() -> None:
                try:
                    reply(claude_window_desktop(int(pid), fallback=state.get("desktops")))
                except Exception as err:            # noqa: BLE001
                    print(f"claude-desks watch: ClaudeWindow({pid}) failed: {err}", file=sys.stderr, flush=True)
                    reply("")
            threading.Thread(target=answer, daemon=True).start()

        @dbus.service.method(BUS_NAME, in_signature="iss", out_signature="s",
                             async_callbacks=("reply", "error"))
        def Owner(self, pid, cls, caption, reply, error):  # noqa: ARG002 (error: a failure answers "{}")
            def answer() -> None:
                try:
                    out = json.dumps(window_owner(int(pid), str(cls), str(caption)))
                except Exception as err:            # noqa: BLE001
                    print(f"claude-desks watch: Owner({pid}) failed: {err}", file=sys.stderr, flush=True)
                    out = "{}"
                reply(out)
            try:
                threading.Thread(target=answer, daemon=True).start()
            except Exception as err:                # noqa: BLE001 (RuntimeError: can't start new thread)
                print(f"claude-desks watch: Owner({pid}) could not start its answer: {err}", file=sys.stderr,
                      flush=True)
                reply("{}")

        @dbus.service.method(BUS_NAME, in_signature="s", out_signature="")
        def Sent(self, payload):
            try:
                print(sent_line(payload), flush=True)
            except Exception:                       # noqa: BLE001
                pass

        @dbus.service.method(BUS_NAME, in_signature="ss", out_signature="")
        def Report(self, tag, payload):
            try:
                write_report(str(tag), str(payload))
            except Exception as err:                # noqa: BLE001
                print(f"claude-desks watch: Report({tag}) failed: {err}", file=sys.stderr, flush=True)

        @dbus.service.method(BUS_NAME, in_signature="", out_signature="")
        def Poke(self):
            with lock:
                state["want"] = True
            wake.set()

        @dbus.service.method(BUS_NAME, in_signature="s", out_signature="s",
                             async_callbacks=("reply", "error"))
        def Claims(self, version, reply, error):  # noqa: ARG002
            done = [False]

            def once(text):
                if not done[0]:
                    done[0] = True
                    reply(text)
            try:
                have = int(str(version))
            except ValueError:
                have = -1
            try:
                claims.poll(have, once)
            except Exception as err:        # noqa: BLE001 — never a D-Bus error: KWin would stop asking
                print(f"claude-desks watch: Claims failed: {err}", file=sys.stderr, flush=True)
                once(json.dumps({"version": -2, "claims": []}))
            if not done[0]:
                GLib.timeout_add(int(CLAIM_POLL_HOLD * 1000), lambda: (claims.release(once), False)[1])

        @dbus.service.method(BUS_NAME, in_signature="s", out_signature="s",
                             async_callbacks=("reply", "error"))
        def Claim(self, raw, reply, error):  # noqa: ARG002
            serve_claim(str(raw), state.get("desktops"), claims, reply, GLib.idle_add, GLib.timeout_add)

        @dbus.service.method(BUS_NAME, in_signature="ss", out_signature="")
        def Taken(self, cid, pid):
            claims.drop(str(cid))
            print(f"claude-desks watch: claim {cid} took the window of pid {pid}", flush=True)

        @dbus.service.method(BUS_NAME, in_signature="s", out_signature="b")
        def Unclaim(self, cid):
            return claims.drop(str(cid))

        @dbus.service.method(BUS_NAME, in_signature="s", out_signature="s")
        def Sticky(self, screens):
            return sticky_reply(state, lock, screens)

    try:
        bus = dbus.SessionBus()
        name = dbus.service.BusName(BUS_NAME, bus, do_not_queue=True)  # noqa: F841 (held)
    except dbus.exceptions.NameExistsException:
        raise Refused(f"another desktop service already runs ({BUS_NAME} is taken)")
    except dbus.exceptions.DBusException as err:
        raise Refused(f"no session bus to serve on: {err.get_dbus_message()}")
    Desktops(bus, BUS_PATH)
    threading.Thread(target=ticker, daemon=True).start()
    GLib.MainLoop().run()
    return 0


def cmd_sync(as_json: bool) -> int:
    notes = sync(gather())
    if as_json:
        print(json.dumps(notes, ensure_ascii=False))
    else:
        for n in notes:
            print(n)
    return 0


def claim_panel(d: dict) -> tuple[dict, int]:
    why = ""
    for attempt in range(PANEL_CLAIM_TRIES):
        try:
            return send_claim(d, 0, PANEL_CLASS, PANEL_MARKER, PANEL_CLAIM_TTL, CLAIM_GRACE,
                              time.time() + CLAIM_DEADLINE_S)
        except Refused as err:
            why = str(err)
            if not why.startswith(("no desktop has the id", "the desktops are not known yet")):
                break
            if attempt + 1 < PANEL_CLAIM_TRIES:
                time.sleep(PANEL_CLAIM_PAUSE)
    return {"id": None, "seen": False, "error": why[:200]}, 3


def cmd_panel_desktop(as_json: bool, claim: bool) -> int:
    with registry_lock():
        ds = need_desktops()
        d = panel_refresh(ds, adopt=True, held=True)
        made = d is None
        if claim:
            own_desktop_only(d or {"id": "", "number": len(his_ids(ds)) + 1}, ds)
        if made:
            d = create_desktop(PANEL_NAME, len(his_ids(ds)), only_named=True)
            write_panel_state(d["id"], d["number"])
    out = {"desktop_id": d["id"], "number": d["number"], "name": PANEL_NAME, "created": made}
    code = 0
    if claim:
        out["claim"], code = claim_panel(d)
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"{d['id']} {d['number']}")
        if claim:
            print(json.dumps(out["claim"]))
    return code


def aux_find(desktops: list[dict]) -> dict | None:
    return aux_of(desktops) or aux_named(desktops)


def aux_open(as_json: bool) -> int:
    with registry_lock():
        ds = need_desktops()
        d = aux_find(ds)
        made = d is None
        if made:
            d = create_desktop(AUX_NAME, len(his_ids(ds)), only_named=True)
        elif d["name"] != AUX_NAME:
            qdbus(*VDM, f"{VDM_IF}.setDesktopName", d["id"], AUX_NAME)
            after = live_desktops()
            d = next((x for x in after or [] if x["id"] == d["id"]), None)
            if d is None or d["name"] != AUX_NAME:
                raise Refused(f"KWin would not call the Aux Desktop {AUX_NAME!r}")
        want = {"v": 1, "desktop_id": d["id"], "name": AUX_NAME, "number": d["number"]}
        if aux_file_state() != want:
            write_aux_state(d["id"], d["number"])
    out = {"desktop_id": d["id"], "number": d["number"], "name": AUX_NAME, "created": made}
    print(json.dumps(out, ensure_ascii=False) if as_json else f"{d['id']} {d['number']}")
    return 0


def aux_status(as_json: bool) -> int:
    ds = need_desktops()
    d = aux_of(ds)
    here = bool(d) and current_desktop() == d["id"]
    out = {"exists": d is not None, "desktop_id": d["id"] if d else "", "number": d["number"] if d else 0,
           "current": here}
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"{d['id']} {d['number']}{' current' if here else ''}" if d else "none")
    return 0


def aux_close(as_json: bool) -> int:
    ds = live_desktops()
    if not ds:
        raise Refused("KWin is not answering on D-Bus; the Aux Desktop was not closed")
    d = aux_find(ds)
    try:
        AUX_FILE.unlink(missing_ok=True)
    except OSError as err:
        raise Refused(f"could not delete {AUX_FILE}: {err}")
    if d is None:
        line = "no Aux Desktop to close"
        print(json.dumps({"closed": False, "desktop_id": "", "number": 0, "moved": 0, "message": line})
              if as_json else line)
        return 0
    did, first, number = d["id"], home_id(ds), d["number"]
    home_name = home_words(ds, first)
    if current_desktop() == did:
        switch_to(first)
    tag, hub_kp = f"aux-{os.getpid()}-{time.monotonic_ns()}", hub_konsole_pid()
    kwin_script(script_close_app(did, AUX_CLASS, tag), "aux-close")
    closing = read_report(tag, 2.0)
    if closing is None:
        time.sleep(END_WAIT)
    elif closing.get("closing"):
        wait_closed(did, tag, hub_kp, END_WAIT, app=AUX_CLASS)
    first = home_now(ds)
    home_name = home_words(live_desktops() or ds, first)
    kwin_script(script_move_leftovers(did, first, tag + "-left", hub_kp), "aux-left")
    left = read_report(tag + "-left", 2.0)
    if current_desktop() == did:
        switch_to(first)
    moved = (left or {}).get("moved") or []
    with registry_lock():
        qdbus(*VDM, f"{VDM_IF}.removeDesktop", did)
        after = live_desktops()
        if after is None:
            raise Refused(f"KWin did not say whether the Aux Desktop (desktop {number}) went")
        if any(x["id"] == did for x in after):
            raise Refused(f"KWin did not remove the Aux Desktop (desktop {number}); its windows were moved to "
                          f"{home_name} or asked to close")
    line = f"closed the Aux Desktop (was desktop {number})"
    if closing is None or left is None:
        line += ": could not count the windows (the desktop service is not running)"
    else:
        asked = len(closing.get("closing") or [])
        line += f": {asked} Aux window{'' if asked == 1 else 's'} asked to close"
        if moved:
            line += f", {len(moved)} other window{'' if len(moved) == 1 else 's'} moved to {home_name}"
    print(json.dumps({"closed": True, "desktop_id": did, "number": number, "moved": len(moved), "message": line},
                     ensure_ascii=False) if as_json else line)
    return 0


def cmd_aux_desktop(action: str, as_json: bool = False) -> int:
    if action == "open":
        return aux_open(as_json)
    if action == "close":
        return aux_close(as_json)
    if action == "status":
        return aux_status(as_json)
    raise Usage("aux-desktop open|close|status [--json]")


def cmd_list(as_json: bool) -> int:
    ds, cur = live_desktops(), current_desktop()
    reg = {e["desktop_id"]: e for e in read_registry()}
    if ds is None:
        if as_json:
            print(json.dumps({"kwin": False, "current": None, "desktops": list(reg.values())}, indent=1, ensure_ascii=False))
        else:
            print("KWin is not answering; the registry says:")
            for e in reg.values():
                print(f"  {e.get('number', '?'):>2}  {e.get('name', '')}  ({e.get('account', '')}, Konsole {e.get('konsole_pid')})")
        return 1
    rows = []
    mains = his_ids(ds)
    for d in ds:
        yours = d["id"] in mains
        e = reg.get(d["id"]) if not yours else None
        rows.append({"number": d["number"], "desktop_id": d["id"], "name": d["name"], "current": d["id"] == cur,
                     "yours": yours, "claude": with_live(e, ds, cur) if e else None})
        if yours and len(mains) > 1:
            rows[-1]["main"] = mains.index(d["id"]) + 1
        if is_panel(d, ds):
            rows[-1]["panel"] = True
        elif is_aux(d, ds):
            rows[-1]["aux"] = True
    if as_json:
        print(json.dumps({"kwin": True, "current": cur, "desktops": rows}, indent=1, ensure_ascii=False))
        return 0
    for r in rows:
        who = "your desktop" if r["yours"] else "the Panel" if r.get("panel") else "Aux Desktop" if r.get("aux") else (
            f"{r['claude']['account']} · Konsole {r['claude'].get('konsole_pid')}" if r["claude"] else "no Claude")
        print(f"{'▸' if r['current'] else ' '} {r['number']:>2}  {r['name']:<40}  {who}")
    return 0



def main_name(desktops: list[dict]) -> str:
    taken = {d["name"] for d in desktops}
    n = len(his_ids(desktops)) + 1
    while f"Main Desktop {n}" in taken:
        n += 1
    return f"Main Desktop {n}"


def named_elsewhere(did: str) -> str | None:
    if any(e.get("desktop_id") == did for e in read_registry()):
        return "the registry"
    if panel_file_id() == did:
        return "the Panel file"
    if aux_file_id() == did:
        return "the Aux file"
    return None


def main_new(as_json: bool) -> int:
    refuse_claude_caller("new")
    try:
        MAIN_FILE.parent.mkdir(parents=True, exist_ok=True)
        writable = os.access(MAIN_FILE.parent, os.W_OK | os.X_OK)
    except OSError as err:
        raise Refused(f"cannot write his Main Desktops file in {MAIN_FILE.parent}: {err.strerror or err}")
    if not writable:
        raise Refused(f"cannot write his Main Desktops file in {MAIN_FILE.parent}: not writable")
    try:
        drop_dead_closing()
    except (OSError, Refused) as err:
        print(f"claude-desks: could not clear the mark of a close that ended: {err}", file=sys.stderr, flush=True)
    write_error = None
    with registry_lock():
        ds = need_desktops()
        d = create_desktop(main_name(ds), len(his_ids(ds)), only_named=True)
        did, where = d["id"], named_elsewhere(d["id"])
        if where:
            raise Refused(f"KWin made desktop {d['number']} ({d['name']}) but {where} already names it: it was left "
                          "as it is and is not one of his")
        try:
            with main_lock():
                state = main_state()
                if did not in state["ids"]:
                    state["ids"].append(did)
                write_main_state(state)
        except OSError as err:
            write_error = err
    if write_error is not None:
        taken_back = False
        if not named_elsewhere(did) and did not in main_state()["ids"]:
            hub_pid, tag = hub_konsole_pid(), f"mc-poll{os.getpid()}-new"
            seen = read_report(tag, MAIN_CLOSE_REPORT_WAIT) \
                if kwin_script(script_close_main_poll(did, hub_pid, tag), "mc-poll") else None
            if seen is not None and seen.get("present") and not seen.get("windows"):
                tag = f"mc-rm{os.getpid()}-new"
                if kwin_script(script_close_main(did, ds[0]["id"], hub_pid, tag), "mc-rm"):
                    read_report(tag, MAIN_CLOSE_REPORT_WAIT)
                taken_back = desktop_gone(did)
        raise Refused(f"could not record the new desktop in {MAIN_FILE}: {write_error}; the desktop it made (desktop "
                      f"{d['number']}, {d['name']}) " + ("was removed again" if taken_back else "is still there, not listed"))
    if switch_to(did):
        try:
            update_main_state(lambda st: st.update(home=did))
        except OSError as err:
            print(f"claude-desks: made {d['name']} but could not write home: {err}", file=sys.stderr, flush=True)
    else:
        print(f"claude-desks: made {d['name']} (desktop {d['number']}) but could not switch to it",
              file=sys.stderr, flush=True)
    if as_json:
        print(json.dumps({"ok": True, "id": did, "name": d["name"], "number": d["number"]}, ensure_ascii=False))
    else:
        print(f"made {d['name']} (desktop {d['number']})")
    return 0


def desktop_gone(did: str) -> bool:
    ds = live_desktops()
    return ds is not None and all(x["id"] != did for x in ds)


def close_path(did: str, kind: str) -> Path:
    if not re.fullmatch(r"[0-9A-Za-z{}-]{1,64}", did):
        raise Refused(f"{did!r} is not a desktop id")
    return MAIN_CLOSE_DIR / f"close-{did}.{kind}"


def close_running(did: str) -> bool:
    try:
        with open(close_path(did, "lock"), "rb") as fh:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(fh, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


def close_stop_asked(stop_file: Path) -> bool:
    try:
        stop_file.unlink()
    except OSError:
        return False
    return True


def close_clock() -> float:
    return time.monotonic()


def close_sleep(seconds: float) -> None:
    time.sleep(seconds)


def polonium_answering() -> bool:
    return screens_known(read_hub_rows())


def close_wait(seconds: float, stop_file: Path) -> bool:
    end = close_clock() + seconds
    while True:
        if close_stop_asked(stop_file):
            return True
        left = end - close_clock()
        if left <= 0:
            return False
        close_sleep(min(CLOSE_TICK, left))


def write_close_outcome(did: str, state: str, windows: list[str]) -> None:
    path = close_path(did, "json")
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps({"state": state, "windows": list(windows), "at": time.time()}, ensure_ascii=False) + "\n")
        os.replace(tmp, path)
    except OSError:
        tmp.unlink(missing_ok=True)


def main_close_tidy(keep: set[str], now: float | None = None) -> int:
    cutoff, gone = (time.time() if now is None else now) - CLOSE_FILES_KEEP, 0
    try:
        names = sorted(MAIN_CLOSE_DIR.iterdir())
    except OSError:
        return 0
    by_id: dict[str, list[Path]] = {}
    for path in names:
        found = re.fullmatch(r"\.?close-(.+?)\.(?:lock|json|stop)(?:\.\d+\.tmp)?", path.name)
        if found and found.group(1) not in keep:
            by_id.setdefault(found.group(1), []).append(path)
    for files in by_id.values():
        try:
            if any(p.stat().st_mtime >= cutoff for p in files):
                continue
        except OSError:
            continue
        holder = next((p for p in files if p.name.endswith(".lock")), None)
        fh = None
        try:
            if holder is not None:
                fh = open(holder, "rb")
                try:
                    fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    continue
            for path in sorted(files, key=lambda p: p is holder):
                try:
                    path.unlink()
                    gone += 1
                except OSError:
                    pass
        except OSError:
            continue
        finally:
            if fh is not None:
                fh.close()
    return gone


def update_main_state_retry(change, tries: int = 3) -> OSError | None:
    err = None
    for attempt in range(tries):
        try:
            update_main_state(change)
            return None
        except OSError as caught:
            err = caught
            print(f"claude-desks: could not write {MAIN_FILE}: {caught}", file=sys.stderr, flush=True)
            if attempt + 1 < tries:
                close_sleep(0.2)
    return err


def close_unmark(did: str) -> None:
    def clear(st: dict) -> None:
        if st["closing"] == did:
            st["closing"] = None
            st.pop("released", None)
    update_main_state_retry(clear)


def main_renumber(desktops: list[dict], gone: str) -> None:
    listed = {i for i in main_state()["ids"] if i != gone}
    extras = [x for x in desktops[1:] if x["id"] in listed]
    for n, x in enumerate(extras, 2):
        want = f"Main Desktop {n}"
        if x["name"] != want and re.fullmatch(r"Main Desktop \d+", x["name"]):
            qdbus(*VDM, f"{VDM_IF}.setDesktopName", x["id"], want)


class CloseWatch:

    def __init__(self) -> None:
        self.asked: set[str] = set()
        self.shown: set[str] = set()
        self.has_asked: set[str] = set()
        self.calm: dict = {}
        self.pids: dict = {}
        self.late: set[str] = set()
        self.asking: set = set()

    def look(self, windows: list[dict], now: float) -> dict:
        known = set(self.pids)
        answering = bool(self.asking or self.calm)
        for w in windows:
            if w.get("id"):
                self.pids[w["id"]] = w.get("pid")
        asked_pids = {self.pids.get(i) for i in self.asked} - {None, 0}
        for w in windows:
            if w.get("normal") and w.get("id") and w["id"] not in self.asked and w.get("pid") in asked_pids:
                self.late.add(w["id"])
            elif answering and self.asked and w.get("normal") and w.get("id") and w["id"] not in self.asked \
                    and w["id"] not in known:
                self.late.add(w["id"])
        normal = [w for w in windows if w.get("normal") and w.get("id") not in self.late]
        questions = [w for w in windows if not w.get("normal") or w.get("id") in self.late]
        normal_ids = {w.get("id") for w in normal}
        asking: set = set()
        for q in questions:
            if q.get("owner"):
                asking.add(q["owner"])
            else:
                mine = {w["id"] for w in normal if w.get("id") and w.get("pid") == q.get("pid")}
                asking |= mine or (self.has_asked & {w.get("id") for w in normal})
        self.has_asked |= asking
        self.asking = asking
        for wid in self.has_asked:
            if wid in asking or wid not in normal_ids:
                self.calm.pop(wid, None)
            else:
                self.calm.setdefault(wid, now)
        return {"normal": normal, "questions": questions,
                "ask": [w["id"] for w in normal if w.get("id") and w["id"] not in self.asked],
                "show": [w["id"] for w in questions if w.get("id") and w["id"] not in self.shown],
                "cancelled": any(now - since >= CLOSE_SETTLE for since in self.calm.values()),
                "waiting": bool(questions or self.calm)}


def main_close_stop(arg: str, as_json: bool) -> int:
    arg, ids = str(arg or "").strip(), main_state()["ids"]
    did = arg if arg in ids else None
    if did is None and len(arg) >= 6 and not arg.isdigit():
        hits = [i for i in ids if i.startswith(arg)]
        did = hits[0] if len(hits) == 1 else None
    if did is None and arg.isdigit():
        found = resolve_desktop(arg, need_desktops())
        did = found["id"] if found["id"] in ids else None
    if did is None:
        raise Refused(f"{arg!r} is not one of his Main Desktops")
    if not close_running(did):
        print(f"claude-desks: no close of {did} is running", file=sys.stderr)
        return 3
    try:
        close_path(did, "stop").write_text("")
    except OSError as err:
        raise Refused(f"could not leave the stop for the close of {did}: {err.strerror or err}")
    print(json.dumps({"ok": True, "id": did, "stop": "asked"}) if as_json else f"stop asked for {did}")
    return 0


def main_close(arg: str, as_json: bool, stop: bool) -> int:
    refuse_claude_caller("close")
    if stop:
        return main_close_stop(arg, as_json)
    ds = need_desktops()
    d = resolve_desktop(arg, ds)
    if is_first(d, ds):
        raise Refused(f"{d['name']} is desktop 1: his own, never closed")
    if d["id"] not in main_state()["ids"]:
        raise Refused(f"desktop {d['number']} ({d['name']}) is not one of his Main Desktops")
    where = named_elsewhere(d["id"])
    if where:
        raise Refused(f"desktop {d['number']} ({d['name']}) is named by {where}: it is not one of his Main Desktops to close")
    return main_close_run(d, ds, as_json)


def main_close_run(d: dict, ds: list[dict], as_json: bool) -> int:
    did, name = d["id"], d["name"]
    came_from, hub_pid = current_desktop(), hub_konsole_pid()
    try:
        MAIN_CLOSE_DIR.mkdir(parents=True, exist_ok=True)
        lock = open(close_path(did, "lock"), "a+")
    except OSError as err:
        raise Refused(f"cannot use {MAIN_CLOSE_DIR}: {err.strerror or err}")
    with lock:
        lock_deadline = close_clock() + CLOSE_LOCK_WAIT
        while True:
            began = time.time_ns()
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if close_clock() >= lock_deadline:
                    raise Refused(f"{name} is already being closed")
                close_sleep(CLOSE_LOCK_TICK)
        stop_file = close_path(did, "stop")
        try:
            if stop_file.stat().st_mtime_ns < began - CLOSE_STOP_SLACK_NS:
                stop_file.unlink()
        except OSError:
            pass

        def claim(st: dict) -> None:
            other = st["closing"]
            if other and other != did and close_running(other):
                label = next((x["name"] for x in ds if x["id"] == other), "another Main Desktop")
                raise Refused(f"{label} is being closed: one close at a time")
            st["closing"] = did
            st.pop("released", None)
        try:
            update_main_state(claim)
        except OSError as err:
            raise Refused(f"cannot write {MAIN_FILE}: {err.strerror or err}")
        try:
            main_close_tidy(set(main_state()["ids"]) | {did})
        except Exception as err:                    # noqa: BLE001 - housekeeping is never a reason to stop closing
            print(f"claude-desks: tidying {MAIN_CLOSE_DIR} failed: {err}", file=sys.stderr, flush=True)
        state, titles = None, []
        try:
            write_close_outcome(did, "closing", [])
            silent_since, release_began = None, close_clock()
            while state is None:
                if main_state().get("released") == did:
                    break
                if close_stop_asked(stop_file):
                    state = "stopped"
                    break
                now = close_clock()
                if now - release_began >= CLOSE_RELEASE_LIMIT:
                    break
                if polonium_answering():
                    silent_since = None
                else:
                    silent_since = now if silent_since is None else silent_since
                    if now - silent_since >= CLOSE_RELEASE_WAIT:
                        break
                close_sleep(CLOSE_TICK)
            watch, interval, last_key, n, shown, removed = CloseWatch(), CLOSE_POLL_FIRST, object(), 0, ("closing", []), False
            while state is None:
                n += 1
                tag = f"mc-poll{os.getpid()}-{n}"
                report = read_report(tag, MAIN_CLOSE_REPORT_WAIT) \
                    if kwin_script(script_close_main_poll(did, hub_pid, tag), "mc-poll") else None
                if report is not None and report.get("present") is False:
                    if desktop_gone(did):
                        removed = True
                        break
                    report = None
                seen = report.get("windows") if report is not None else None
                if not isinstance(seen, list):
                    interval = min(CLOSE_POLL_LAST, interval * 2)
                else:
                    seen = [w for w in seen if isinstance(w, dict)]
                    key = sorted((str(w.get("id")), str(w.get("caption")), bool(w.get("normal")), bool(w.get("minimized")))
                                 for w in seen)
                    look = watch.look(seen, close_clock())
                    for wid in look["show"]:
                        if kwin_script(script_close_main_show(did, wid), "mc-show"):
                            watch.shown.add(wid)
                    if look["ask"] and kwin_script(script_close_main_ask(did, look["ask"], hub_pid), "mc-ask"):
                        watch.asked.update(look["ask"])
                    titles = [str(w.get("caption") or "") for w in look["normal"]]
                    now_shown = ("asking" if look["questions"] else "closing", titles)
                    if now_shown != shown:
                        shown = now_shown
                        write_close_outcome(did, *now_shown)
                    if look["cancelled"]:
                        state = "kept"
                        break
                    interval = CLOSE_POLL_FIRST if (key != last_key or look["waiting"]) else min(CLOSE_POLL_LAST, interval * 2)
                    last_key = key
                    if not seen:
                        where = named_elsewhere(did)
                        if where:
                            raise Refused(f"{name} is now named by {where}: it is not closed")
                        live = live_desktops() or ds
                        target = came_from if came_from and came_from != did and any(x["id"] == came_from for x in live) \
                            else home_id(live)
                        tag = f"mc-rm{os.getpid()}-{n}"
                        gone = False
                        if kwin_script(script_close_main(did, target, hub_pid, tag), "mc-rm"):
                            done = read_report(tag, MAIN_CLOSE_REPORT_WAIT)
                            gone = bool(done and done.get("removed"))
                        if gone or desktop_gone(did):
                            removed = True
                            break
                        interval = CLOSE_POLL_FIRST
                if close_wait(interval, stop_file):
                    state = "stopped"
            if removed:
                state, titles = "closed", []
                main_renumber(live_desktops() or [], did)

                def leave(st: dict) -> None:
                    st["ids"] = [i for i in st["ids"] if i != did]
                    if st["home"] == did:
                        st["home"] = ""
                    if st["closing"] == did:
                        st["closing"] = None
                    st.pop("released", None)
                if update_main_state_retry(leave) is not None:
                    print(f"claude-desks: closed {name} but could not update {MAIN_FILE}", file=sys.stderr, flush=True)
                write_close_outcome(did, "closed", [])
            else:
                if state != "kept":
                    titles = []
                write_close_outcome(did, state, titles)
                close_unmark(did)
        except BaseException:
            close_unmark(did)
            close_path(did, "json").unlink(missing_ok=True)
            raise
    if as_json:
        print(json.dumps({"ok": state == "closed", "state": state, "id": did, "name": name, "windows": titles},
                         ensure_ascii=False))
    elif state == "closed":
        print(f"closed {name}")
    elif state == "kept":
        print(f"kept {name}: still open: {', '.join(titles)}")
    else:
        print(f"stopped {name}: kept")
    return 0 if state == "closed" else 3


def main_list(as_json: bool) -> int:
    ds = need_desktops()
    cur, home, mine = current_desktop(), home_id(ds), his_ids(ds)
    rows = [{"id": d["id"], "number": d["number"], "name": d["name"], "main": mine.index(d["id"]) + 1,
             "current": d["id"] == cur, "home": d["id"] == home} for d in ds if d["id"] in mine]
    if as_json:
        print(json.dumps({"current": cur, "home": home, "desktops": rows}, ensure_ascii=False))
        return 0
    for r in rows:
        print(f"{'▸' if r['current'] else ' '} {r['number']:>2}  {r['name']}" + ("  (home)" if r["home"] else ""))
    return 0


def cmd_main_desktop(action: str, as_json: bool = False, arg: str | None = None, stop: bool = False) -> int:
    if action == "new":
        return main_new(as_json)
    if action == "list":
        return main_list(as_json)
    if action == "close" and arg:
        return main_close(arg, as_json, stop)
    raise Usage("main-desktop new|list [--json] | main-desktop close <id> [--json] [--stop]")


USAGE = next(p for p in __doc__.split("\n\n") if p.lstrip().startswith("claude-desks whoami"))


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]

    def opt(name: str, default=None):
        if name in rest:
            i = rest.index(name)
            if i + 1 >= len(rest):
                raise Usage(f"{name} needs a value")
            value = rest[i + 1]
            del rest[i:i + 2]
            return value
        return default

    def flag(name: str) -> bool:
        if name in rest:
            rest.remove(name)
            return True
        return False

    try:
        if cmd == "whoami":
            return cmd_whoami(flag("--json"))
        if cmd == "place":
            desktop, slot = opt("--desktop"), opt("--slot")
            caption, pid, confirm = opt("--caption", ""), opt("--pid", "0"), flag("--confirm")
            screen = opt("--screen")
            if not desktop or not slot:
                raise Usage(f"place needs --desktop <id|number> and --slot {'|'.join(SLOTS)}")
            if not str(pid).isdigit():
                raise Usage("--pid is a number")
            if slot not in SLOTS:
                raise Usage(f"--slot is one of {', '.join(SLOTS)}")
            if not caption and not int(pid):
                raise Usage("say which window: --caption TEXT or --pid N")
            if screen is not None and screen != "primary":
                raise Usage("--screen is primary (KDE's primary screen); without it the screen he is watching")
            return cmd_place(desktop, slot, caption, int(pid), confirm, primary=screen == "primary")
        if cmd == "claim":
            desktop, pid, cls = opt("--desktop"), opt("--pid", "0"), opt("--class", "")
            marker, ttl = opt("--marker", ""), opt("--ttl", str(CLAIM_TTL))
            grace, deadline = opt("--grace", str(CLAIM_GRACE)), opt("--deadline")
            if not desktop or rest:
                raise Usage("claim --desktop <id|number> (--pid N | --class CLASS --marker TEXT) [--ttl S] [--grace S] "
                            "[--deadline EPOCH]")
            if not str(pid).isdigit():
                raise Usage("--pid is a number")
            try:
                ttl_s, grace_s = float(ttl), float(grace)
            except ValueError:
                raise Usage("--ttl and --grace are seconds")
            deadline_s = None
            if deadline is not None:
                try:
                    deadline_s = float(deadline)
                except ValueError:
                    deadline_s = float("nan")
                if not math.isfinite(deadline_s):
                    raise Usage("--deadline is a time in seconds since 1970 (the epoch second the service must have "
                                "the claim by)")
            if not int(pid) and not cls:
                raise Usage("say which window: --pid N or --class CLASS --marker TEXT")
            return cmd_claim(desktop, int(pid), cls, marker, ttl_s, grace_s, deadline_s)
        if cmd == "unclaim":
            if len(rest) != 1:
                raise Usage("unclaim <claim id>")
            return cmd_unclaim(rest[0])
        if cmd == "panel-desktop":
            as_json, claim = flag("--json"), flag("--claim")
            if rest:
                raise Usage("panel-desktop [--json] [--claim]")
            return cmd_panel_desktop(as_json, claim)
        if cmd == "aux-desktop":
            as_json = flag("--json")
            if len(rest) != 1 or rest[0] not in ("open", "close", "status"):
                raise Usage("aux-desktop open|close|status [--json]")
            return cmd_aux_desktop(rest[0], as_json)
        if cmd == "main-desktop":
            as_json, stop = flag("--json"), flag("--stop")
            main_usage = "main-desktop new|list [--json] | main-desktop close <id> [--json] [--stop]"
            if rest and rest[0] in ("new", "list") and len(rest) == 1 and not stop:
                return cmd_main_desktop(rest[0], as_json)
            if rest and rest[0] == "close" and len(rest) == 2:
                return cmd_main_desktop("close", as_json, rest[1], stop)
            raise Usage(main_usage)
        if cmd == "goto":
            no_focus = flag("--no-focus")
            if len(rest) != 1:
                raise Usage("goto <id|number> [--no-focus]")
            return cmd_goto(rest[0], not no_focus)
        if cmd == "new":
            attach, stay = opt("--attach"), flag("--stay")
            model, effort = opt("--model", ""), opt("--effort", "")
            title_text, message = opt("--title", ""), opt("--message", "")
            if len(rest) != 1:
                raise Usage("new <account> [--attach ID] [--stay] [--model M] [--effort E] "
                            "[--title TEXT] [--message TEXT]")
            if (title_text or message) and attach:
                raise Usage("--title and --message are for a plain new Claude: not with --attach")
            if model and not MODEL_RE.fullmatch(model):
                raise Usage("--model is a model's name, like opus or sonnet")
            if effort and effort not in EFFORTS:
                raise Usage(f"--effort is one of {', '.join(EFFORTS)}")
            if attach and (model or effort):
                raise Usage("an attached Claude keeps its own model and effort")
            account = rest[0]
            return cmd_new(account, attach, stay, model, effort, title_text, message)
        if cmd == "adopt":
            only, goto, as_json, dry = opt("--session"), flag("--goto"), flag("--json"), flag("--dry-run")
            return cmd_adopt(only, goto, as_json, dry)
        if cmd in ("end", "resume"):
            expect = opt("--session") if cmd == "end" else None
            if expect is not None and not expect.strip():
                raise Usage("end <id|number> --session <the full session id it must still be>")
            if len(rest) != 1:
                raise Usage(f"{cmd} <id|number>" + (" [--session <full session id>]" if cmd == "end" else ""))
            return cmd_end(rest[0], expect) if cmd == "end" else cmd_resume(rest[0])
        if cmd == "remove":
            raise Usage("remove is gone: a Claude desktop ends only through `claude-desks end <id|number>` "
                        "(the hub's Del)")
        if cmd == "sync":
            return cmd_sync(flag("--json"))
        if cmd == "watch":
            once = flag("--once")
            if rest:
                raise Usage("watch [--once]")
            return cmd_watch(once)
        if cmd == "active":
            return cmd_active(flag("--json"))
        if cmd == "focus":
            caption = opt("--caption", "")
            if not caption:
                raise Usage("focus --caption <text>  (the window whose title contains it)")
            return cmd_focus_caption(caption)
        if cmd == "refocus":
            if len(rest) != 1:
                raise Usage("refocus <window id>  (an id from `active --json`)")
            return cmd_refocus(rest[0])
        if cmd == "sticky":
            as_json = flag("--json")
            if not rest:
                return cmd_sticky(None, None, as_json)
            if len(rest) < 2 or rest[-1].lower() not in ("on", "off"):
                raise Usage("sticky [--json]  or  sticky <screen> on|off  (a screen: a connector name)")
            return cmd_sticky(" ".join(rest[:-1]), rest[-1].lower() == "on", as_json)
        if cmd == "list":
            return cmd_list(flag("--json"))
    except Refused as e:
        print(f"claude-desks: {e}", file=sys.stderr)
        return e.code
    print(USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
