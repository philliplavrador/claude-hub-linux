#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const os = require('os');

const svc = process.env.KONSOLE_DBUS_SERVICE;     // e.g. ":1.518"
const ses = process.env.KONSOLE_DBUS_SESSION;     // e.g. "/Sessions/1"
if (!svc || !ses) process.exit(0);
if (process.env.CLAUDE_CODE_ENTRYPOINT !== 'cli') process.exit(0);

let data = {};
try { data = JSON.parse(fs.readFileSync(0, 'utf8')); } catch { process.exit(0); }
if (!data.session_id) process.exit(0);

const dir = path.join(os.homedir(), '.cache', 'claude-hub-account');
try { fs.mkdirSync(dir, { recursive: true }); } catch {}

const key = (svc + ses).replace(/[^a-zA-Z0-9]/g, '_');
const configDir = process.env.CLAUDE_CONFIG_DIR ||
  fs.realpathSync(path.join(os.homedir(), '.claude'));

try {
  fs.writeFileSync(path.join(dir, key), JSON.stringify({
    session_id: data.session_id,
    transcript_path: data.transcript_path || '',
    config_dir: configDir,
    account: path.basename(configDir),
    cwd: data.cwd || process.cwd(),
    pid: process.ppid,
    at: Date.now(),
  }, null, 1));
} catch {}
process.exit(0);
