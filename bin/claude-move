LOCK_DIR = DK.STATE_HOME / "claude-move"
MARKER_KEEP = 24 * 3600
SOFT_NOTES: list[str] = []
CONTINUE = "continue"
REASK = ("[Auto-swapper, {at}] {src} ran out of usage while your question to the user was open, so this "
         "conversation moved to {to}. He has not answered it. If the question was only about the usage limit or "
         "which account to use, drop it and carry on with the work; otherwise ask it again, as it was.")
TAG = "[Account switch, {at}] the user moved this conversation from {src} to {to}"
KEEPER = (" Background commands were stopped. Before you start any of them again, check what the stopped work "
          "left behind, then restart only what still needs to run.")
DONE_OR_ASK = (" If your work was finished, restart only what still needs to run and end your turn. If you were "
               "waiting for the user's answer, ask the question again.")
WORKING = (TAG + " while you were working. The move stopped your turn." + KEEPER
           + " Then carry on from where you stopped." + DONE_OR_ASK)
REASK_SWITCH = (TAG + " while you were waiting for the user's answer to a question or a permission prompt. He has not "
                "answered: the move closed it, and if it reads as declined or refused, that was the move, not him. "
                "If you were asking only about the usage limit or which account to use, drop that and carry on with "
                "the work; otherwise ask again, or retry the refused step.")
LIMIT_SWITCH = TAG + " because {src} ran out of usage. Carry on from where you stopped."
WARNED_SWITCH = (TAG + " after {src} warned that its usage was nearly gone. If you stopped early because of that "
                 "warning, carry on from where you stopped; if your work was finished, end your turn as you "
                 "normally would.")
BACKGROUND_SWITCH = TAG + "." + KEEPER + " Then carry on." + DONE_OR_ASK
