def _load_desktop():
    path = Path(__file__).resolve().parent / "claude-desks"
    if not path.exists() and shutil.which("claude-desks"):
        path = Path(shutil.which("claude-desks")).resolve()
    loader = importlib.machinery.SourceFileLoader("claude_desks", str(path))
    spec = importlib.util.spec_from_loader("claude_desks", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _load_swapper():
    try:
        path = Path(__file__).resolve().parent / "claude-autoswap"
        if not path.exists() and shutil.which("claude-autoswap"):
            path = Path(shutil.which("claude-autoswap")).resolve()
        loader = importlib.machinery.SourceFileLoader("claude_autoswap", str(path))
        spec = importlib.util.spec_from_loader("claude_autoswap", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except (Exception, SystemExit):
        return None


DK = _load_desktop()
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
START_LINE = re.compile(r"[ \t]*backgrounded[ \t]+\xb7[ \t]+([0-9a-f]{8})(?![A-Za-z0-9])")
